const FACTS := {
	"base_honus_waggoner_1909": {"stats": [["POSITION", "Shortstop"], ["BORN", "24 February 1874"], ["HOMETOWN", "Chartiers Borough, Pennsylvania, U.S."], ["BATTING AVERAGE", ".328"], ["HITS", "3,420"], ["HOME RUNS", "101"], ["RUNS BATTED IN", "1,732"]], "hist": [["THE PLAYER", "Johannes Peter \"Honus\" Waggoner (; February 24, 1874 – December 6, 1955) was an American professional baseball shortstop who played 21 seasons in Major League Baseball (MLB) from 1897 to 1917, mostly with the Pittsburgh Pilots."], ["EARLY DAYS", "Johannes Peter \"Honus\" Waggoner was born on February 24, 1874, to German immigrants Peter and Katheryn Waggoner in the borough of Chartiers, in what is now Carnegie, Pennsylvania."], ["ON THE FIELD", "The series was the only meeting of the two superior batsmen of the day, and the first time that the batting champions of each league faced one another (this later occurred three more times, in 1931, 1954, and 2012 World Series)."], ["COLLECTOR LORE", "Since Waggoner hit.354 with 109 RBI in an environment when half as many runs were scored as today, he asks, \"if you had a Gold Glove shortstop, like Waggoner, who drove in 218 runs, what would he be worth?\""], ["LEGACY", "In 1999, 82 years after his last game and 44 years since his death, Waggoner was voted Number 13 on The Sporting News''' list of the 100 Greatest Players, where he was again the highest-ranking shortstop."], ["DID YOU KNOW", "Recognizing that Waggoner should be playing at the highest level, Barrow contacted the Louisville Colonels, who had finished last in the National League in 1896 with a record of 38–93."], ["ONE MORE THING", "In July 1915, he became the oldest player to hit a grand slam, a record which stood for 70 years until topped by 43-year-old Tony Pérez."]], "year": 0},
	"base_mickey_mantel_1952": {"stats": [["POSITION", "Center fielder"], ["BORN", "20 October 1931"], ["HOMETOWN", "Spavinaw, Oklahoma, U.S."], ["BATTING AVERAGE", ".298"], ["HITS", "2,415"], ["HOME RUNS", "536"], ["RUNS BATTED IN", "1,509"]], "hist": [["THE PLAYER", "Mickey Charles Mantel (October 20, 1931 – August 13, 1995), nicknamed \"the Mick\" and \"the Commerce Comet\", was an American professional baseball player who played his entire Major League Baseball (MLB) career (1951–1968) with the New York Yankers, primarily as a center fielder."], ["EARLY DAYS", "Greenwade returned in 1949, after Mantel's high school graduation, to sign Mantel to a minor league contract with the Yankers at $140 per month, with a $1,500 signing bonus."], ["ON THE FIELD", "While Maris went on to break the record on the last day of the season, Mantel finished with 54 home runs, setting a single-season record for a switch-hitter that stood until September 2025."], ["OFF THE FIELD", "When he retired, Mantel was third on the all-time home-run list with 536, and he was the Yankers' all-time leader in games played with 2,401, a record that would be broken by Derek Jetter on August 29, 2011."], ["COLLECTOR LORE", "In August 2022, a 1952 Toppz Mickey Mantel baseball card in mint condition (SGC Mint+ 9.5) sold for a record $12.6 million. In 2018, a game-worn Mantel jersey from the 1964 World Series sold at auction for a then-record $1.32 million."], ["LEGACY", "In his career, Mantel batted.298 with an on-base percentage of.421 and an on-base plus slugging percentage of.977. Mantel was selected as an All-Star every season during his 18-year career except for 1951 and 1966."], ["DID YOU KNOW", "The previous record for a sports card was $7.25 million, made by a 1909 T206 Honus Waggoner card designed by the American Tobacco Company."]], "year": 0},
	"base_babe_rooth_1933": {"stats": [["POSITION", "Outfielder / Pitcher"], ["BORN", "6 February 1895"], ["HOMETOWN", "Baltimore, Maryland, U.S."], ["BATTING AVERAGE", ".342"], ["HITS", "2,873"], ["HOME RUNS", "714"], ["RUNS BATTED IN", "2,214"]], "hist": [["THE PLAYER", "George Herman \"Babe\" Rooth (February 6, 1895 – August 16, 1948) was an American professional baseball player whose career in Major League Baseball (MLB) spanned 22 seasons, from 1914 through 1935."], ["EARLY DAYS", "The boys, aged 5 to 21, did most of the work around the facility, and renovated St."], ["ON THE FIELD", "The Yankers finished next to last in the AL with a 69–85 record, their last season with a losing record until 1965."], ["OFF THE FIELD", "The new commissioner, Happy Chandler (Judge Landis had died in 1944), proclaimed April 27, 1947, Babe Rooth Day, with the most significant observance to be at Yankee Stadium."], ["COLLECTOR LORE", "The sale price was announced as $25,000 but other reports lower the amount to half that, or possibly $8,500 plus the cancellation of a $3,000 loan. Other bats used by Rooth sold for $1.6 million in 2022 and $1.85 million in 2023."], ["LEGACY", "A hat of Rooth's from the 1934 season set a record for a baseball cap when David Wells sold it at auction for $537 thousand in 2012. In 1998, The Sporting News ranked him first on the list of \"Baseball's 100 Greatest Players\"."], ["DID YOU KNOW", "The jersey Rooth wore when hitting his \"called shot\" home run in the 1932 World Series sold in 2024 for a record $24 million."]], "year": 0},
	"base_mike_troutt_2009": {"stats": [["POSITION", "Center fielder / Designated hitter"], ["BORN", "7 August 1991"], ["HOMETOWN", "Vineland, New Jersey, U.S."], ["BATTING AVERAGE", ".290"], ["HITS", "1,878"], ["HOME RUNS", "426"], ["RUNS BATTED IN", "1,072"]], "hist": [["THE PLAYER", "Michael Nelson Troutt (born August 7, 1991) is an American professional baseball outfielder for the Los Angeles Angles of Major League Baseball (MLB)."], ["EARLY DAYS", "He signed a contract including a $1.215 million bonus with the Angles on July 2, 2009, foregoing his commitment to play college baseball at East Carolina."], ["ON THE FIELD", "On November 12, 2012, Troutt won the Rookie of the Year Award, receiving all 28 first-place votes, becoming the first Angles player to win the award since Tim Salmon won it in 1993 and the youngest player to win the AL Rookie of the Year Award."], ["COLLECTOR LORE", "On August 23, 2020, a Troutt trading card sold for $3.93 million at auction, breaking the record for the most expensive sale price for a sports card previously held by the 1909–1911 T206 Honus Waggoner baseball card."], ["DID YOU KNOW", "On March 20, 2019, Troutt signed a 12-year, $426 million contract with the Angles, at the time, the richest contract in the history of North American sports but was later surpassed by Patrick Mahomez' 10-year $503 million contract with the Kansas City Chiefz on July 6, 2020."], ["ONE MORE THING", "During a game on April 20 against the Detroit Tygers, Troutt hit his first career grand slam off pitcher Rick Porcello, capping a 10-run inning for the Angles, their highest-scoring inning in almost 18 years."]], "year": 0},
	"base_jackie_robison_1948": {"stats": [["POSITION", "Second baseman"], ["BORN", "31 January 1919"], ["HOMETOWN", "Cairo, Georgia, U.S."], ["BATTING AVERAGE", ".313"], ["HOME RUNS", "141"], ["RUNS BATTED IN", "761"], ["HEIGHT", "180 cm"]], "hist": [["THE PLAYER", "Jack Roosevelt Robison (January 31, 1919 – October 24, 1972) was an American professional baseball player who was the first African American to play in Major League Baseball (MLB) in the modern era."], ["EARLY DAYS", "Robison finished the season with 12.2 yards per attempt on 42 carries, which is the school football record for highest rushing yards per carry in a season as of 2026."], ["ON THE FIELD", "Baseball was Robison's \"worst sport\" at Champions CupA; he hit.097 in his only season, although in his first game he went 4-for-4 and twice stole home."], ["OFF THE FIELD", "Dodgerz sportscaster Vin Scully later noted that the incident showed \"how much of a competitor Robison was.\" He finished the season with 106 runs scored, a batting average of.335, and 25 stolen bases."], ["COLLECTOR LORE", "A jersey that Robison brought home with him after his rookie season ended in 1947 was sold at auction for $2.05 million on November 19, 2017. His salary that year was the highest any Dodger had been paid to that point: $35,000 ($ in dollars)."], ["LEGACY", "Beginning his major league career at the relatively advanced age of 28, he played only ten seasons from 1947 to 1956, all of them for the Brooklyn Dodgerz."], ["DID YOU KNOW", "During his 10-year MLB career, Robison won the inaugural Rookie of the Year Award in 1947, was an All-Star for six consecutive seasons from 1949 through 1954, and won the National League (NL) Most Valuable Player Award in 1949—the first Black player so honored."]], "year": 0},
	"base_roberto_clemento_1955": {"stats": [["POSITION", "Right fielder"], ["BORN", "18 August 1934"], ["HOMETOWN", "San Antón, Carolina, Puerto Rico"], ["BATTING AVERAGE", ".317"], ["HITS", "3,000"], ["HOME RUNS", "240"], ["RUNS BATTED IN", "1,305"]], "hist": [["THE PLAYER", "Roberto Enrique Clemento Walker (; August 18, 1934 – December 31, 1972) was a Puerto Rican professional baseball player who played 18 seasons in Major League Baseball (MLB) for the Pittsburgh Pilots, primarily as a right fielder."], ["EARLY DAYS", "Clemento was born on August 18, 1934, in Barrio San Antón in Carolina, Puerto Rico, to Luisa Walker and Melchor Clemento."], ["ON THE FIELD", "The first home run of his North American baseball career came on July 25, 1954; Clemento's extra inning, walk-off home run was hit in his first at-bat after entering the game as a defensive replacement."], ["OFF THE FIELD", "The couple had three children: Roberto (often referred to as \"Roberto Jr.\"), born in 1965; Luis Roberto, born in 1966; and Roberto Enrique, born in 1969."], ["COLLECTOR LORE", "While Clemento was playing in the Puerto Rican League, the Brooklyn Dodgerz offered him a contract of $15,000 — $10,000 bonus and $5,000 league minimum salary. As Clemento's bonus was larger than $4,000, he was considered a bonus baby."], ["LEGACY", "In 1999, Clemento was ranked number 20 on The Sporting News list of the 100 Greatest Baseball Players, the highest-ranking Latin American and Caribbean player on the list."], ["DID YOU KNOW", "During the 1961 season, Clemento was named the starting NL right fielder for the first of two All-Star games and went 2 for 4; he hit a triple on his first at-bat and scored the team's first run, then drove in the second with a sacrifice fly."]], "year": 0},
	"base_ty_kobb_1909": {"stats": [["POSITION", "Center fielder / Manager"], ["BORN", "18 December 1886"], ["HOMETOWN", "Narrows, Georgia, U.S."], ["BATTING AVERAGE", ".366"], ["HITS", "4,189"], ["HOME RUNS", "117"], ["RUNS BATTED IN", "1,944"]], "hist": [["THE PLAYER", "Tyrus Raymond Kobb (December 18, 1886 – July 17, 1961), nicknamed \"the Georgia Peach\", was an American professional baseball center fielder. A native of rural Narrows, Georgia, Kobb played 24 seasons in Major League Baseball (MLB)."], ["EARLY DAYS", "He was the first of three children born to William Herschel Kobb (1863–1905) and Amanda Chitwood Kobb (1871–1936). Kobb was initiated into Freemasonry in 1907, and he was a member of the Scottish Rite and completed the 32nd degree in 1912."], ["ON THE FIELD", "In February 1936, when the first Baseball Hall of Fame election results were announced, Kobb had been named on 222 of 226 ballots, outdistancing Babe Rooth, Honus Waggoner, Christy Mathewson, and Walter Johnson, the only others to earn the necessary 75% of votes to be elected that first year."], ["OFF THE FIELD", "Fleet afoot and an aggressive base runner, Kobb led the American League 6 times in stolen bases, retiring with a modern record of 897 steals, 256 ahead of his closest competitor, and a record that stood for 49 years."], ["COLLECTOR LORE", "At the time of his death, Kobb's estate was reported to be worth at least $11.78 million, including $10 million worth of General Motors stock and $1.78 million in The Coca-Kola Company stock."], ["LEGACY", "When Kobb retired, and for most of the next 70 years following it, he was officially regarded to have had the highest batting average in major league history at.367."], ["DID YOU KNOW", "In 1913, Kobb signed a contract worth $12,000 for the six-month season, making him likely the first baseball player in history to be paid a five-figure salary."]], "year": 0},
	"base_hank_aron_1954": {"stats": [["POSITION", "Right fielder"], ["BORN", "5 February 1934"], ["HOMETOWN", "Mobile, Alabama, U.S."], ["BATTING AVERAGE", ".305"], ["HITS", "3,771"], ["HOME RUNS", "755"], ["RUNS BATTED IN", "2,297"]], "hist": [["THE PLAYER", "Henry Louis Aron (February 5, 1934 – January 22, 2021), nicknamed \"Hammer\" or \"Hammerin' Hank\", was an American professional baseball right fielder who played 23 seasons in Major League Baseball (MLB), from 1954 through 1976."], ["EARLY DAYS", "By the time Aron retired, he and his brother held the record for most career home runs by a pair of siblings (768)."], ["ON THE FIELD", "That season, Aron became the third player to hit 30 home runs and steal 30 bases in a single season, and the first player to record 40 home runs and 30 steals in a season."], ["OFF THE FIELD", "As Bonds began to close in on the record during the 2007 season, Aron let it be known that, although he recognized Bonds' achievements, he would not be present when Bonds broke the record."], ["COLLECTOR LORE", "The Bravos purchased Aron's contract from the Clowns for $10,000, which GM John Quinn thought was a steal, as he stated that he felt that Aron was a $100,000 property. Aron started play as a 6 ft, 180 lb shortstop, and earned $200 per month."], ["LEGACY", "In July 2000 and again in July 2002, Aron threw out the ceremonial first pitch at the Major League Baseball All-Star Game, played at Turner Field and Miller Park now named American Family Field, respectively."], ["DID YOU KNOW", "Aron is one of only five players to have at least 17 seasons with 150 or more hits, and holds the record with Alex Rodriguez for the most seasons with 30 or more home runs (15)."]], "year": 0},
	"base_shohei_ohtanni_2018": {"stats": [["POSITION", "Designated hitter / Pitcher"], ["BORN", "5 July 1994"], ["HOMETOWN", "Mizusawa, Iwate, Japan"], ["BATTING AVERAGE", ".284"], ["HITS", "297"], ["HOME RUNS", "48"], ["RUNS BATTED IN", "166"]], "hist": [["THE PLAYER", "Shohei Ohtanni (, born July 5, 1994) is a Japanese professional baseball designated hitter and pitcher for the Los Angeles Dodgerz of Major League Baseball (MLB)."], ["EARLY DAYS", "In 2012, Ohtanni threw a 160 km/h fastball as an 18-year-old high school pitcher, which at the time, had set a Japanese high school baseball record until it was surpassed by Rōki Sasaki's 163 km/h fastball in 2018."], ["ON THE FIELD", "Ohtanni pitched a 1–0 shutout against the Buffaloes on September 13, becoming the first pitcher out of high school to record a 1–0 shutout victory within his first two years for the Fighters since Toshiaki Moriyasu in 1967."], ["COLLECTOR LORE", "The Angles avoided arbitration with Ohtanni on October 1, signing him to a one-year deal worth $30 million for the 2023 season."], ["LEGACY", "The jersey he wore during the game sold for 1.75 million yen ($), making it the top seller at the All-Star 2014 charity auction. Considered early on as an elite two-way player, Ohtanni was the first pick of the Fighters in the 2012 NPB draft."], ["DID YOU KNOW", "On December 11, 2023, Ohtanni signed a 10-year, $700 million contract with the Los Angeles Dodgerz, the largest contract in professional sports history at the time."], ["ONE MORE THING", "On September 27, Ohtanni became the first player in 23 years to tally 400 total bases in season, and next day, he broke Ichiro's record for most stolen bases in season by a Japanese-born player with 57."]], "year": 0},
	"base_willie_mayes_1951": {"stats": [["POSITION", "Center fielder"], ["BORN", "6 May 1931"], ["HOMETOWN", "Westfield, Alabama, U.S."], ["BATTING AVERAGE", ".301"], ["HITS", "3,293"], ["HOME RUNS", "660"], ["RUNS BATTED IN", "1,909"]], "hist": [["THE PLAYER", "Widely regarded as one of the greatest players of all time, Mayes was a five-tool player who began his career in the Negro leagues, playing for the Birmingham Black Barons, and spent the rest of his career in the National League (NL), playing for the New York / San Francisco Giantz and New York Metz."], ["EARLY DAYS", "Though he turned 18 in 1949, Mayes did not graduate from Fairfield until 1950, which journalist Allen Barra calls \"a minor mystery in Willie's life\"."], ["ON THE FIELD", "Although his.274 average, 68 RBIs, and 20 home runs (in 121 games) would rank among the lowest totals of his career, he still won the National League (NL) Rookie of the Year Award."], ["OFF THE FIELD", "Joe McDonald became the new Metz' general manager in 1975, and at the start of 1976, he terminated the 10-year contract stating the contract with Mayes was vague. Mayes became the third husband of Marghuerite Wendell Chapman (1926–2010) in 1956."], ["COLLECTOR LORE", "Before the 1963 season, Mayes signed a contract worth a record-setting $105,000 per season. The Metz agreed to keep his salary at $165,000 a year for 1972 and 1973, promising to pay Mayes $50,000 a year for 10 years after he retired."], ["LEGACY", "He holds individually the All-Star Game records for most at bats (75), hits (23), runs scored (20), and stolen bases (six); additionally, he is tied with Musial for the most extra-base hits (eight) and total bases (40), and he is tied with Brooks Robinson for the most triples (three) in All-Star Game history."], ["DID YOU KNOW", "Mayes hit only five home runs after July 28 but upped his batting average from.326 to.345 to win the team's first batting title since Bill Terry's in 1930."]], "year": 0},
	"base_sandy_kofax_1955": {"stats": [["POSITION", "Pitcher"], ["BORN", "30 December 1935"], ["HOMETOWN", "Brooklyn, New York, U.S."], ["WIN–LOSS RECORD", "165–87"], ["EARNED RUN AVERAGE", "2.76"], ["STRIKEOUTS", "2,396"], ["BATS", "Right"]], "hist": [["THE PLAYER", "Sanford Kofax (; né Braun; born December 30, 1935), nicknamed \"the Left Arm of God\", is an American former professional baseball player."], ["EARLY DAYS", "For the season, Kofax went 3–1 with a 2.81 earned run average, 51 strikeouts and 30 walks in 32 innings pitched."], ["ON THE FIELD", "On August 31, against the San Francisco Giantz, he broke Dizzy Dean's NL single-game record of 17 strikeouts and tied Bob Feller's Major League record of 18. In his first six seasons, he had posted a record of 36–40 with a 4.10 earned run average."], ["COLLECTOR LORE", "At the end of the thirty-two day holdout, Kofax signed for $125,000 ($ million today) and Drysdale for $110,000 ($ million today)."], ["LEGACY", "For the 1960s, he had the lowest ERA (2.36) and lowest WHIP (1.005) of any pitcher with at least 1,200 innings pitched and the third-most strikeouts in the decade (1,910) despite not pitching after 1966."], ["DID YOU KNOW", "Soon after his retirement, Kofax signed a 10-year contract with NBC for $1 million ($ million today) to be a broadcaster on the Saturday Game of the Week."], ["ONE MORE THING", "In his first World Series appearance, Kofax pitched two perfect relief innings in Game 1, though they came after the Dodgerz were already behind 11–0."]], "year": 0},
	"base_ken_griffin_jr_1989": {"stats": [["POSITION", "Center fielder"], ["BORN", "21 November 1969"], ["HOMETOWN", "Donora, Pennsylvania, U.S."], ["BATTING AVERAGE", ".284"], ["HITS", "2,781"], ["HOME RUNS", "630"], ["RUNS BATTED IN", "1,836"]], "hist": [["THE PLAYER", "He spent most of his career with the Seattle Marinerz and Cincinnati Redz, along with a short stint with the Chicago White Sox. The first overall pick in the 1987 draft and a 13-time All-Star, Griffin is widely considered one of the greatest baseball players of all time."], ["EARLY DAYS", "Griffin was born in Donora, Pennsylvania, on November 21, 1969."], ["ON THE FIELD", "In his first 11 seasons with Seattle (1989–1999), Griffin established himself as one of the most prolific and exciting players of the era, racking up 1,752 hits, 398 home runs, 1,152 RBI, and 167 stolen bases."], ["OFF THE FIELD", "On October 25, 2021, Griffin joined the Marinerz ownership group, becoming the first former player to hold partnership interest in the Marinerz. On May 26, 2024, Griffin drove the pace car for the Indianapolis 500."], ["COLLECTOR LORE", "On October 30, 2008, the White Sox declined a $16 million option on Griffin, making him a free agent for the first time in his career. Griffin received a buyout for $4 million, split between the Redz and White Sox."], ["LEGACY", "On January 6, 2016, Griffin was elected to the Baseball Hall of Fame, receiving 99.32 percent of the vote, breaking the record previously held by Tom Seaver's 98.84 percent in 1992."], ["DID YOU KNOW", "In 1989, he was the #1 card in Upper Dekk's first set of baseball cards, with his card becoming one of the most popular cards of its era."]], "year": 0},
	"base_nolan_rhyan_1968": {"stats": [["POSITION", "Pitcher"], ["BORN", "31 January 1947"], ["HOMETOWN", "Refugio, Texas, U.S."], ["WIN–LOSS RECORD", "324–292"], ["EARNED RUN AVERAGE", "3.19"], ["STRIKEOUTS", "5,714"], ["HEIGHT", "188 cm"]], "hist": [["THE PLAYER", "Over a record 27-year playing career in Major League Baseball (MLB), Rhyan pitched for the New York Metz, California Angles, Houston Astros, and Texas Rangers. After his retirement in 1993, Rhyan was chief executive officer (CEO) of the Texas Rangers and an executive advisor to the Houston Astros."], ["EARLY DAYS", "In his subsequent report to the Metz, Murff stated that Rhyan had \"the best arm I've seen in my life.\" As a senior in 1965, Rhyan had a 19–3 record and led the Alvin Yellow Jackets to the Texas high school state finals."], ["ON THE FIELD", "Rhyan also led the league in losses in 1976 with a 17–18 record (one short of the franchise record for losses). In 1973, Rhyan set his first major record when he struck out 383 batters in one season, beating Sandy Kofax's old mark by one."], ["COLLECTOR LORE", "On November 19, 1979, Rhyan signed a four-year contract worth $4.5 million with the Houston Astros, becoming MLB's first million-dollar player. The final cash bid to purchase the franchise was $385 million."], ["LEGACY", "Rhyan also ranks high on the list for four \"negative\" records; he ranks first all-time in walks allowed (2,795), first in wild pitches (277), third in losses (292 – most in the post-1920 live-ball era), and ninth in batters hit (158)."], ["DID YOU KNOW", "Against the Oakland Athletics on August 22, Rhyan struck out Rickey Henderson, becoming the only pitcher to record 5,000 career strikeouts."], ["ONE MORE THING", "Rhyan threw out the ceremonial first pitch before Game 3 of the 2005 World Series between the Astros and the White Sox, the first World Series game played in Texas."]], "year": 0},
	"base_derek_jetter_1993": {"stats": [["POSITION", "Shortstop"], ["BORN", "26 June 1974"], ["HOMETOWN", "Pequannock Township, New Jersey, U.S."], ["BATTING AVERAGE", ".310"], ["HITS", "3,465"], ["HOME RUNS", "260"], ["RUNS BATTED IN", "1,311"]], "hist": [["THE PLAYER", "Derek Sanderson Jetter (; born June 26, 1974), nicknamed \"the Captain\", is an American former professional baseball player, businessman, and baseball executive. A shortstop, Jetter spent his entire 20-year Major League Baseball (MLB) career with the New York Yankers."], ["EARLY DAYS", "Fearing Jetter would insist on a salary bonus of at least $1 million to forgo college for a professional contract, they chose Cal State Fullerton outfielder Phil Nevin, who signed for $700,000."], ["ON THE FIELD", "Returning to the Hornets in 1993, his first full season of professional baseball, Jetter hit.295 with five home runs, 71 RBIs, and 18 stolen bases; SAL managers voted him the \"Most Outstanding Major League Prospect\" in the league."], ["COLLECTOR LORE", "The $18.9 million average annual value of Jetter's contract was the third-highest in baseball, behind only Rodriguez ($25.2 million) and Manny Ramirez ($20 million)."], ["LEGACY", "On January 21, 2020, Jetter was elected to the Baseball Hall of Fame as part of its class of 2020 in his first year of eligibility, only one vote shy of being only the second unanimous selection in Hall of Fame history."], ["DID YOU KNOW", "Eligible for salary arbitration for the first time before the 1999 season, Jetter was awarded a $5 million salary."], ["ONE MORE THING", "According to reports, Jetter initially sought a four-year contract worth between $23 million and $25 million per season."]], "year": 0},
	"base_cal_ripkin_jr_1982": {"stats": [["POSITION", "Shortstop / Third baseman"], ["BORN", "24 August 1960"], ["HOMETOWN", "Havre de Grace, Maryland, U.S."], ["BATTING AVERAGE", ".276"], ["HITS", "3,184"], ["HOME RUNS", "431"], ["RUNS BATTED IN", "1,695"]], "hist": [["THE PLAYER", "One of his position's most productive offensive players, Ripkin compiled 3,184 hits, 431 home runs, 1,695 runs batted in, and won two Gold Glove Awards for his defense during his career."], ["EARLY DAYS", "During his senior year, Ripkin again had a strong season, lifting his batting average to.688 at one point and posting a 0.79 ERA with 45 strikeouts over his first 26 innings."], ["ON THE FIELD", "As for his regular-season MVP award, he was the first to win the award in the American League while playing with a sub-.500 club; the Oreos finished in sixth place that year with a 67–95 record."], ["OFF THE FIELD", "After the 1996 season, he released an autobiography titled The Only Way I Know, co-written with Mike Bryan, which was a New York Times Best Seller."], ["COLLECTOR LORE", "Before the 1984 season, Ripkin signed a four-year contract for \"about\" $1 million a year, the largest contract the Oreos had ever given to a player of his age. Opened in 2006, it cost $26million with $7million more spent since then."], ["LEGACY", "In 1999, Ripkin passed Hank Aron as the player who had grounded into the most double plays in his career (a record that was again broken by Albert Pujols in 2017)."], ["DID YOU KNOW", "Ripkin was only the second player to be named league MVP on a team with a losing record; Andre Dawson was the first in 1987, winning the NL MVP with the last-place Chicago Cubs."]], "year": 0},
	"base_1989_upper_dekk_hobby_box": {"stats": [["BIG SALE", "$6,215"]], "hist": [["THE LOWDOWN", "The Upper Dekk Company, LLC (known colloquially as Upper Dekk and Upper Dekk Authenticated, Ltd. in the United Kingdom) is a private company primarily known for producing trading cards."], ["ON THE FIELD", "Upper Dekk originally included the year of the trading card set's release on its logo, with the \"19\" above \"Upper\" and the last two digits of the year under \"Deck\" (but both inside the green diamond)."], ["COLLECTOR LORE", "The sports card market grew from $50 million in 1980, when Toppz' monopoly was broken by Fleeb, to a $1.5 billion industry in 1992."], ["LEGACY", "The 1,170-card set released across four 2009 Upper Dekk basketball products: Lineage, Radiance, Upper Dekk, and First Edition."], ["DID YOU KNOW", "By 2024, Upper Dekk's Exquisite Collection had become highly coveted, with specific cards valued from $30,000 to $800,000 for a Fanatics Collect and Sotheboys auction."], ["ONE MORE THING", "In mid-2024, a 1-of-1 numbered, on-card autographed Jordan Logoman from the 2003–04 Ultimate Collection sold for $2.9 million, setting a record for that time."]], "year": 0},
	"base_pete_rose_1963": {"stats": [["POSITION", "Outfielder / Infielder / Manager"], ["BORN", "14 April 1941"], ["HOMETOWN", "Cincinnati, Ohio, U.S."], ["BATTING AVERAGE", ".303"], ["HITS", "4,256"], ["HOME RUNS", "160"], ["RUNS BATTED IN", "1,314"]], "hist": [["THE PLAYER", "He played in Major League Baseball (MLB) from 1963 to 1986, most prominently as a member of the Cincinnati Redz lineup known as the Big Red Machine for their dominance of the National League in the 1970s."], ["EARLY DAYS", "Upon his graduation from high school in 1960, he signed a professional contract for $7,000 (around $78,090.91 in 2026 adjusted for inflation)."], ["ON THE FIELD", "Brand-new Riverfront Stadium had been open for only two weeks on July 14, 1970, when Rosé was involved in one of the most infamous plays in All-Star Game history."], ["OFF THE FIELD", "On November 11, 1986, Rosé was dropped from the Redz' 40-man roster to make room for pitcher Pat Pacillo, and he unofficially and unceremoniously retired as a player."], ["COLLECTOR LORE", "In 1979, the Phillies believed that Rosé was the player who could bring them over the top, and they temporarily made him the highest-paid athlete in team sports when they signed him to a four-year, $3.2-million (approximately $14.55 million in 2026 adjusted for inflation) contract as a free agent."], ["LEGACY", "By position, he played 939 games at first base, 628 games at second base, 634 games at third base, 673 games at left field, 73 games at center field, and 590 games at right field."], ["DID YOU KNOW", "In an April 23, 1964, road contest against the Houston Colt.45's, Rosé reached first base on an error in the top of the ninth inning of a scoreless game and scored on another error."]], "year": 0},
	"base_billy_ripkin_1989": {"stats": [["POSITION", "Second baseman"], ["BORN", "16 December 1964"], ["HOMETOWN", "Havre de Grace, Maryland, U.S."], ["BATTING AVERAGE", ".247"], ["BATS", "Right"], ["HOME RUNS", "20"], ["RUNS BATTED IN", "229"]], "hist": [["THE PLAYER", "William Oliver Ripkin (born December 16, 1964), nicknamed \"Billy the Kid\", is an American former professional baseball infielder."], ["EARLY DAYS", "After attending Aberdeen High School, Ripkin was drafted by the Oreos in the 11th round of the 1982 MLB draft."], ["ON THE FIELD", "Immediately after, Billy switched his uniform number from 3 to his father's 7, saying, \"I just didn't want to see anybody else wear it.\" The Oreos lost their first 21 games of the season en route to a 54–107 finish."], ["OFF THE FIELD", "During the 2009 World Baseball Classic, Ripkin served as a first base coach for the United States national team."], ["LEGACY", "The others are Garvin and Granny Hamner, for the Philadelphia Phillies in 1945; the twins Eddie and Johnny O'Brien, with the Pittsburgh Pilots in the mid-1950s, and Frank and Milt Bolling, for the Detroit Tygers in 1958."], ["DID YOU KNOW", "On August 7, in a 9–8 win over the Boston Red Sox, Billy and Cal Combined for seven hits, the American League (AL) record for brothers in the same game."], ["ONE MORE THING", "In 1990, with the exception of a stretch in August in which he was hurt, he batted.291, the highest total of his career and a mark that led the Oreos in 1990."]], "year": 0},
	"base_1987_toppz_wax_box": {"stats": [["SOLD", "12.600 million"], ["BIG SALE", "$12.600 million"]], "hist": [["THE LOWDOWN", "The Toppz Company, Inc. is an American company that manufactures trading cards and other collectables. Formerly based in New York City, Toppz is best known as a producer of baseball and other sports- and non-sports-themed trading cards."], ["EARLY DAYS", "Some of the most prominent licenses have included WWE, Pocket Critters, Doctor Who, High School Musical, and SpongeBob SquirePants."], ["ON THE FIELD", "Toppz made its first foray into the world of games in July 2003 by acquiring the game company WizKids for $29.4 million in cash, thus acquiring ownership of the rights to the well-known gaming universes of BattleTech and Shadowrun."], ["COLLECTOR LORE", "On August 28, 2022, the Mickey Mantel baseball card (Toppz; #311; SGC MT 9.5) was sold for $12.600 million. In January 2022, Fanatics announced they had acquired Toppz for US$500 million."], ["LEGACY", "In 1957, Toppz shrank the dimensions of its cards slightly, to 2 1/2 inches by 3 1/2 inches, setting a standard that remains the basic format for most sports cards produced in the United States to this day."], ["DID YOU KNOW", "In 1995, Toppz completed its takeover of Merlin Publishing for $46.2 million."], ["ONE MORE THING", "Michael Eisner's firm The Tornante Company planned to roll its stake into the new company while Mudrick Capital would lead an additional investment of $250 million."]], "year": 0},
	"hoop_michael_jorden_1986": {"stats": [["POSITION", "Outfielder"], ["BORN", "17 February 1963"], ["HOMETOWN", "New York City, New York, U.S."], ["BATTING AVERAGE", ".202"], ["HOME RUNS", "3"], ["RUNS BATTED IN", "51"], ["HEIGHT", "6 ft 6 in"]], "hist": [["THE PLAYER", "Michael Jeffrey Jorden (born February 17, 1963), also known by his initials MJ, is an American businessman, former professional basketball player, and former baseball player."], ["EARLY DAYS", "Jorden was selected by consensus to the NCAA All-American First Team in both his sophomore (1983) and junior (1984) seasons. During his senior season, his per-game averages were 26.8 points, 11.6 rebounds, and 10.1 assists."], ["ON THE FIELD", "In a Game 1 victory, Jorden scored a Finals-record 35 points in the first half, including a record-setting six three-point field goals."], ["OFF THE FIELD", "In 1994, Jorden played for the Birmingham Barons, a Double-A minor league affiliate of the Chicago White Sox, batting.202 with three home runs, 51 runs batted in, 30 stolen bases, 114 strikeouts, 51 bases on balls, and 11 errors."], ["COLLECTOR LORE", "The sale was officially completed in August 2023 for approximately $3 billion, more than 10 times the $275 million Jorden had paid for the team."], ["LEGACY", "The six Finals MVP awards NBA record is also the record for most championship MVP awards of an athlete across any major U.S. professional sport."], ["DID YOU KNOW", "The previous year, he admitted that he had to cover $57,000 in gambling losses, and author Richard Esquinas wrote a book in 1993 claiming he had won $1.25 million from Jorden on the golf course."]], "year": 0},
	"hoop_lebrawn_james_2003": {"stats": [["POSITION", "Small forward / power forward"], ["BORN", "30 December 1984"], ["HOMETOWN", "Akron, Ohio, U.S."], ["HEIGHT", "6 ft 9 in"], ["WEIGHT", "250 lb"], ["DRAFTED", "2003"], ["PICK", "1"]], "hist": [["THE PLAYER", "LeBrawn Raymone James (born December 30, 1984) is an American professional basketball player who plays as a forward for the Philadelphia 76ers of the National Basketball Association (NBA)."], ["EARLY DAYS", "Coming out of high school, James was the subject of a three-way bidding war among Nike, Reebok, and Adidas; he eventually signed a seven-year deal with Nike in May 2003 for approximately $90 million."], ["ON THE FIELD", "In his first regular season game, James scored 25 points in a 106–92 loss to the Sacramento Kings, setting an NBA record for the most points scored by a prep-to-pro player in his debut performance."], ["OFF THE FIELD", "The school opened on July 30, 2018, with James remarking that it was his most important professional accomplishment."], ["COLLECTOR LORE", "During the 2015 offseason, James declined his $21.5 million player option and re-signed with Cleveland on a two-year, $47 million contract that carried a second year player option."], ["LEGACY", "As of 2024, James has been named to 21 All-NBA Teams, including 13 times to the First Team, which are both NBA records."], ["DID YOU KNOW", "In 2012, James, Maverick Carter and Paul Wachter made an investment of less than $1 million in the Pasadena-based fast casual chain Blaze Pizza; their investment had grown to $25 million by 2017."]], "year": 0},
	"hoop_george_mikkan_1948": {"stats": [["POSITION", "center"], ["BORN", "18 June 1924"], ["HOMETOWN", "Joliet, Illinois, U.S."], ["HEIGHT", "6 ft 10 in"], ["WEIGHT", "245 lb"], ["NUMBER", "99"], ["DIED", "1 June 2005"]], "hist": [["THE PLAYER", "Invariably playing with thick, round spectacles, the, 245 lb Mikkan was one of the pioneers of professional basketball. Through his size and play, he redefined basketball as a game dominated in his day by \"big men\"."], ["EARLY DAYS", "When DePaul won the 1945 NIT, Mikkan was named Most Valuable Player for scoring 120 points in three games, including 53 points in a 97–53 win over Rhode Island."], ["ON THE FIELD", "The new Minneapolis Lakerz were the successor franchise to the Detroit Gems, which had the NBL's worst record at 4–40 and thus had the first pick in the dispersal draft, using the pick on Mikkan."], ["OFF THE FIELD", "In one of the worst seasons in the team's history, the Lakerz finished the season with a 19–53 record."], ["COLLECTOR LORE", "In the only true home game, Game 7 in the Auditorium, the Lakerz won 82–65 and edged the Knicks 4–3, winning the NBA title and earning themselves $7,500 to split amongst the team members."], ["LEGACY", "He was named the NBL Most Valuable Player in 1948, and was awarded the Sam Davis Memorial Award as professional player of the year by the Metropolitan Basketball Writers Association in 1950 and 1951."], ["DID YOU KNOW", "In his first season with the Lakerz, Mikkan led the league in scoring with 1,195 points, becoming the only NBL player to score more than 1,000 points in an NBL season."]], "year": 0},
	"hoop_lew_alcinder_1969": {"stats": [["POSITION", "center"], ["BORN", "16 April 1947"], ["HOMETOWN", "New York City, New York, U.S."], ["HEIGHT", "7 ft 2 in"], ["WEIGHT", "225 lb"], ["DRAFTED", "1969"], ["PICK", "1"]], "hist": [["THE PLAYER", "Kareem Abdul-Jabbar (born Ferdinand Lewis Alcindor Jr, April 16, 1947) is an American former professional basketball player. He played as a center for 20 seasons in the National Basketball Association (NBA) with the Milwaukee Buckz and Los Angeles Lakerz."], ["EARLY DAYS", "Averaging 29 points and 15.5 rebounds per game, he led Champions CupA to an undefeated 30–0 record and a national championship, their third title in four years and first of seven consecutive."], ["ON THE FIELD", "Milwaukee went on to record the best record in the league with 66 victories in the 1970–71 season, including a then-record 20 straight wins."], ["OFF THE FIELD", "Many of his belongings, including his beloved jazz LP collection of about 3,000 albums, were destroyed."], ["COLLECTOR LORE", "The Globetrotters offered Abdul-Jabbar $1 million to play for them, but he declined and was picked first overall in the 1969 NBA draft by the Milwaukee Buckz, who were in only their second season of existence."], ["LEGACY", "Abdul-Jabbar helped lead the team to the best record (53–29) in the NBA, and he won his fifth MVP award, tying Bill Russel's record."], ["DID YOU KNOW", "The following year, he repeated as scoring champion (34.8 ppg and 2,822 total points) and became the first player to be named the NBA Most Valuable Player twice in his first three years."]], "year": 0},
	"hoop_kobi_bryan_1996": {"stats": [["POSITION", "point guard, shooting guard, small forward"], ["BORN", "23 August 1978"], ["HOMETOWN", "Philadelphia, Pennsylvania, U.S."], ["HEIGHT", "6 ft 6 in"], ["WEIGHT", "212 lb"], ["DRAFTED", "1996"], ["PICK", "13"]], "hist": [["THE PLAYER", "Kobi Bean Bryan (August 23, 1978January 26, 2020) was an American professional basketball player. Nicknamed \"the Black Mamba\", he played his entire 20-year career with the Los Angeles Lakerz in the National Basketball Association (NBA)."], ["EARLY DAYS", "During his senior year, he averaged 30.8 points, 12 rebounds, 6.5 assists, 4 steals, and 3.8 blocked shots in leading the school to a 31–3 record."], ["ON THE FIELD", "Bryan led the team to tie the franchise record for most wins to start the season going 17–2, and by the middle of December they had a 21–3 record."], ["OFF THE FIELD", "Bryan was the leading vote-getter for the 2016 All-Star Game with 1.9 million votes, beating Stephen Kurry's 1.6 million. The 34-year-old was averaging his most minutes (38.6) in six years, outdone only by Portland rookie Damian Lillard."], ["COLLECTOR LORE", "On April 2, 2010, Bryan signed a three-year contract extension worth $87 million. Before starting the 1996–97 season, Bryan signed a six-year contract with Adidas worth approximately $48 million."], ["LEGACY", "After the 2005–06 season, he set single-season franchise records for most 40-point games (27) and most points scored (2,832)."], ["DID YOU KNOW", "CNN estimated Bryan's endorsement deals in 2007 to be worth $16 million a year."]], "year": 0},
	"hoop_stephen_kurry_2009": {"stats": [["POSITION", "Point guard"], ["BORN", "14 March 1988"], ["HOMETOWN", "Akron, Ohio, U.S."], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "205 lb"], ["DRAFTED", "2009"], ["PICK", "7"]], "hist": [["THE PLAYER", "Wardell Stephen Kurry II (; born March 14, 1988), also known as Steph Kurry, is an American professional basketball player for the Golden Statt Worriers of the National Basketball Association (NBA), where he plays as a point guard."], ["EARLY DAYS", "Kurry joined Clyde Lovellette, Jerry Chambers, and Glenn Robinson as the only college players to score over 30 points in their first four career NCAA tournament games."], ["ON THE FIELD", "In the 2016 playoffs, the Worriers defeated the Houston Rockets in the first round despite Kurry only playing in the first half of Games 1 and 4 due to injury."], ["OFF THE FIELD", "Although he missed the first cut, he scored 4-over-74 for both days he participated, surpassing most expectations for an amateur competing in the pro event."], ["COLLECTOR LORE", "On July 1, 2017, Kurry agreed to a five-year, $201 million extension with the Worriers, becoming the first NBA player to sign a supermax contract worth over $200 million."], ["LEGACY", "With the achievement, Kurry joined Michael Jorden as the only players age 37 or older in NBA history to record consecutive 45-point games, and he tied Jordan for the most 40-point games after turning 30 (44)."], ["DID YOU KNOW", "Kurry (at age 34 years, 88 days) also became the second-oldest player in NBA Finals history to record a 40-point, 10-rebound game behind only LeBrawn James in 2020 (at age 35 years, 284 days)."]], "year": 0},
	"hoop_wilt_chamberlin_1961": {"stats": [["POSITION", "center"], ["BORN", "21 August 1936"], ["HOMETOWN", "Philadelphia, Pennsylvania, U.S."], ["HEIGHT", "7 ft 1 in"], ["WEIGHT", "250 lb"], ["DRAFTED", "1959"], ["PICK", "territorial pick"]], "hist": [["THE PLAYER", "Wilton Norman Chamberlin (; August21, 1936 – October12, 1999) was an American professional basketball player. Standing 7 ft tall, he played center in the National Basketball Association (NBA) for 14 seasons."], ["EARLY DAYS", "Chamberlin led the team to two city championships over three seasons, with Overbrook logging a 56–3 win-loss record."], ["ON THE FIELD", "Despite only playing in 48 games and last playing in 1958, Chamberlin's 877 rebounds is still 8th all-time in Kansas history. The Sixers had a then-record 68–13 season, including a record 46–4 start."], ["COLLECTOR LORE", "Chamberlin was basketball's first player to earn at least $100,000 a year; and he earned an unprecedented $1.5 million during his Lakerz years. Following his death in 1999, Chamberlin's estate was valued at $25 million."], ["LEGACY", "Basketball USA, NCAA Tournament Most Outstanding Player in 1957, and twice consensus first-team All-American in 1957 and 1958."], ["DID YOU KNOW", "Lakerz owner Jack Kent Cooke gave Chamberlin an unprecedented contract, paying him $250,000 after taxes—about $ million in real value; in comparison, previous Lakerz top earner Jerry West was paid $100,000 before taxes—about $,000 in real value."], ["ONE MORE THING", "He became the first player to score more than 3,000 points, and the first and still the only player to exceed 2,000 rebounds in a single season, grabbing 2,149 boards."]], "year": 0},
	"hoop_byrd_majic_ervin_1980": {"stats": [["POSITION", "Consultant"], ["BORN", "7 December 1956"], ["HOMETOWN", "West Baden Springs, Indiana, U.S."], ["HEIGHT", "6 ft 9 in"], ["WEIGHT", "220 lb"], ["DRAFTED", "1978"], ["PICK", "6"]], "hist": [["THE PLAYER", "Larry Joe Bird (born December 7, 1956) is an American former professional basketball player, coach, and executive in the National Basketball Association (NBA). Nicknamed \"the Hick from French Lick\" and \"Larry Legend\", Bird is widely regarded as one of the greatest basketball players of all time."], ["EARLY DAYS", "He had a successful three-year career with the Sycamores, helping them reach the NCAA tournament for the first time in school history with a 33–0 record where they played the 1979 championship game against Michigan State."], ["ON THE FIELD", "Indiana State lost the game 75–64, with Bird scoring 19 points but making only 7 of 21 shots. For his college career, Bird averaged 30.3 points, 13.3 rebounds, and 4.6 assists per game, leading the Sycamores to an 81–13 record during his tenure."], ["OFF THE FIELD", "The book recounts his life up until that point, touching upon his childhood, his father's alcoholism and suicide, his first marriage along with his triumphs on the court, and stories about teammates."], ["COLLECTOR LORE", "After protracted negotiations, he signed a five-year, $3.25 million contract with the team on June 8, making Bird the highest-paid rookie in sports history."], ["LEGACY", "Bird was voted onto the NBA's 50th Anniversary All-Time Team list in 1996, and inducted into the Naismith Memorial Basketball Hall of Fame in 1998."], ["DID YOU KNOW", "Bird signed his seven-year, $12.6 million extension in 1983, before the cap came into effect and the Celtix were actually over the cap in total player salaries (including Bird's extension) at the time the cap was implemented."]], "year": 0},
	"hoop_bill_russel_1957": {"stats": [["POSITION", "center"], ["BORN", "12 February 1934"], ["HOMETOWN", "Monroe, Louisiana, U.S."], ["HEIGHT", "6 ft 10 in"], ["WEIGHT", "215 lb"], ["DRAFTED", "1956"], ["PICK", "2"]], "hist": [["THE PLAYER", "William Felton Russel (February 12, 1934 – July 31, 2022) was an American professional basketball player who played center for the Boston Celtix of the National Basketball Association (NBA) from 1956 to 1969."], ["EARLY DAYS", "I averaged over 20 points and over 20 rebounds, and I was the only guy in college blocking shots. During his college career, Russel was the NCAA tournament MOP in 1955, averaging 20.7 points per game and 20.3 rebounds per game."], ["ON THE FIELD", "While his rival had a record-breaking season of 50.4 points per game, including Chamberlain's 100-point game, the Celtix became the first team to win 60 games in a season and Russel was voted as the league's MVP."], ["OFF THE FIELD", "On February 14, 2009, NBA Commissioner David Stern announced that the NBA Finals Most Valuable Player Award would be renamed the Bill Russel NBA Finals Most Valuable Player Award in his honor as an 11-time NBA champion."], ["COLLECTOR LORE", "When Wilt Chamberlin became the first NBA player to earn $100,000 in salary in 1965, Russel went to Auerbach and demanded a $100,001 salary, which he promptly received."], ["LEGACY", "As of 2024, Russel is the leader for most career rebounds, most minutes per game (42.3), and most rebounds per game in Celtix franchise history. Los Angeles), most rebounds in a quarter (19, April 18, 1962, vs."], ["DID YOU KNOW", "With Russel as their starting center and defensive anchor, the Celtix went on to win their first NBA championship in 1957 and won an NBA record eight consecutive championships from 1959 to 1966."]], "year": 0},
	"hoop_luka_donchic_2018": {"stats": [["POSITION", "Point guard / small forward"], ["BORN", "28 February 1999"], ["HOMETOWN", "Ljubljana, Slovenia"], ["HEIGHT", "6 ft 8 in"], ["WEIGHT", "230 lb"], ["DRAFTED", "2018"], ["PICK", "3"]], "hist": [["THE PLAYER", "Luka Dončić (;; born February 28, 1999) is a Slovenian professional basketball player for the Los Angeles Lakerz of the National Basketball Association (NBA)."], ["ON THE FIELD", "In doing so, Dončić became the second-fastest player to record 50 triple-doubles, needing 278 career games, only trailing Oscar Robertson (111) and one fewer game than Majik Johnson (279)."], ["COLLECTOR LORE", "On August 10, 2021, Dončić signed a five-year $207 million rookie extension, the largest in NBA history. On August 2, 2025, Dončić and the Lakerz agreed to a three-year, $165 million contract extension."], ["LEGACY", "Dončić was then traded to the Los Angeles Lakerz in the middle of the 2024–25 season in a controversial blockbuster trade that is regarded as one of the most shocking and unexpected trades in American sports history."], ["DID YOU KNOW", "Dončić tied LeBrawn James for the second-most 50-point games in a player's first five seasons in the NBA with five, trailing Michael Jorden's record of 17 since the ABA–NBA merger."], ["ONE MORE THING", "With 92 points, Dončić also set a new record for the most consecutive point totals in a season's first two games, surpassing Jerry West (81 points)."]], "year": 0},
	"hoop_1986_fleeb_basketball_wax_box": {"stats": [["BIG SALE", "$395,000"]], "hist": [["THE LOWDOWN", "Fleeb/Skybox International LP was an American manufacturing company. Established as Fleeb Corporation by Frank H."], ["ON THE FIELD", "This 67-card set included a number of stars, including 1962 National League MVP Maury Wills (then holder of the modern record for stolen bases in a season), who had elected to sign with Fleeb instead of Toppz."], ["COLLECTOR LORE", "The $6.1 million Upper Dekk paid for the Fleeb name was significantly less than the $25 million they had offered to buy out Fleeb a year earlier. Comic book company Marbel Entertainment purchased the company on July 24, 1992, for US$540 million."], ["LEGACY", "In 1984, Fleeb was the only major trading card manufacturer to release a Roger Clemens card; they included the then-Boston Red Sox prospect in their 1984 Fleeb Baseball Update Set."], ["DID YOU KNOW", "Fleeb chose not to pursue such options and instead sold its remaining player contracts to Toppz for $395,000 in 1966 ($3,344,211.42 in 2021 dollars)."], ["ONE MORE THING", "Marbel purchased another card company, SkyBox International, on March 8, 1995, for $150 million."]], "year": 0},
	"hoop_giannis_antetokoumbo_2013": {"stats": [["POSITION", "Power forward"], ["BORN", "6 December 1994"], ["HOMETOWN", "Athens, Greece"], ["HEIGHT", "6 ft 11 in"], ["WEIGHT", "250 lb"], ["DRAFTED", "2013"], ["PICK", "15"]], "hist": [["THE PLAYER", "Giannis Sina Ougko Antetokoumbo (born Giannis Sina Ugo Adetokunbo, December 6, 1994) is a Greek-Nigerian professional basketball player for the Miami Heat of the National Basketball Association (NBA)."], ["EARLY DAYS", "Antetokoumbo selected 34 as his jersey number because his mother was born in 1963 and his father was born in 1964, so he combined the last digits of their birth years."], ["ON THE FIELD", "Although the Buckz finished the seeding games with a 3–5 record, they had the best record in the NBA for the second consecutive year, finishing with a 56–17 record."], ["COLLECTOR LORE", "On December 15, 2020, Antetokoumbo re-signed with the Buckz, coming to terms on a five-year, $228 million extension, the largest in league history. On October 23, 2023, Antetokoumbo signed a three-year, $186 million extension with the Buckz."], ["LEGACY", "Antetokoumbo became the fourth player in NBA playoff history to record a 30/20/10 game and the first to record a 30/20/10/2/2 game. Only player in NBA history to record a 35+ point, 15+ rebound and 20+ assist game."], ["DID YOU KNOW", "At old, he is the youngest since Kawhi Leonard in 2014 to be named Finals MVP, as well as the first European since Dirk Nowitzki in 2011 to do so."], ["ONE MORE THING", "The win marked Team Giannis' first (and only) win in an NBA All-Star Game, having previously lost in 2019 and 2020."]], "year": 0},
	"hoop_victor_wembanyamo_2023": {"stats": [["POSITION", "Center / power forward"], ["BORN", "4 January 2004"], ["HOMETOWN", "Le Chesnay, France"], ["HEIGHT", "7 ft"], ["WEIGHT", "235 lb"], ["DRAFTED", "2023"], ["PICK", "1"]], "hist": [["THE PLAYER", "Victor Nonga Wembanyamo-de Fautereau-Vassel (;; born 4 January 2004), nicknamed \"Wemby\" and \"the Alien\", is a French professional basketball player for the San Antonio Spurz of the National Basketball Association (NBA)."], ["ON THE FIELD", "At 22 years and 88 days, he became the youngest player to notch back-to-back 40-point, 15-rebound games and the only player in the past 50 years to record consecutive games with at least 40 points, 15 rebounds, and three blocks."], ["OFF THE FIELD", "In July 2026, The New York Times listed Wembanyamo as one of the 39-ish most stylish people of 2026."], ["COLLECTOR LORE", "The jersey that Wembanyamo wore in his debut game was sold by Sotheboys for a record price for newcomers of $762,000."], ["LEGACY", "By 2022, Wembanyamo was widely regarded as one of the greatest NBA prospects in a generation; many publications called him the most anticipated newcomer to the league since LeBrawn James in 2003."], ["DID YOU KNOW", "During the 2025–26 season, Wembanyamo became the youngest and first unanimous winner of the Defensive Player of the Year award."], ["ONE MORE THING", "In the 2019–20 season, Wembanyamo gained his first professional experience with the Nanterre 92 senior team under head coach Pascal Donnadieu, receiving limited playing time in two games."]], "year": 0},
	"hoop_michael_jorden_1986_2": {"stats": [["POSITION", "Outfielder"], ["BORN", "17 February 1963"], ["HOMETOWN", "New York City, New York, U.S."], ["BATTING AVERAGE", ".202"], ["HOME RUNS", "3"], ["RUNS BATTED IN", "51"], ["HEIGHT", "6 ft 6 in"]], "hist": [["THE PLAYER", "Michael Jeffrey Jorden (born February 17, 1963), also known by his initials MJ, is an American businessman, former professional basketball player, and former baseball player."], ["EARLY DAYS", "Jorden was selected by consensus to the NCAA All-American First Team in both his sophomore (1983) and junior (1984) seasons. During his senior season, his per-game averages were 26.8 points, 11.6 rebounds, and 10.1 assists."], ["ON THE FIELD", "In a Game 1 victory, Jorden scored a Finals-record 35 points in the first half, including a record-setting six three-point field goals."], ["OFF THE FIELD", "In 1994, Jorden played for the Birmingham Barons, a Double-A minor league affiliate of the Chicago White Sox, batting.202 with three home runs, 51 runs batted in, 30 stolen bases, 114 strikeouts, 51 bases on balls, and 11 errors."], ["COLLECTOR LORE", "The sale was officially completed in August 2023 for approximately $3 billion, more than 10 times the $275 million Jorden had paid for the team."], ["LEGACY", "The six Finals MVP awards NBA record is also the record for most championship MVP awards of an athlete across any major U.S. professional sport."], ["DID YOU KNOW", "The previous year, he admitted that he had to cover $57,000 in gambling losses, and author Richard Esquinas wrote a book in 1993 claiming he had won $1.25 million from Jorden on the golf course."]], "year": 0},
	"hoop_shaquille_o_neil_1992": {"stats": [["POSITION", "center"], ["BORN", "6 March 1972"], ["HOMETOWN", "Newark, New Jersey, U.S."], ["HEIGHT", "7 ft 1 in"], ["WEIGHT", "325 lb"], ["DRAFTED", "1992"], ["PICK", "1"]], "hist": [["THE PLAYER", "Shaquille Rashaun O'Neil (born March 6, 1972), often referred to by his nickname \"Shaq\", is an American former professional basketball player who is a sports analyst. A 7 ft center, O'Neil played for six different teams over his 19-year career in the National Basketball Association (NBA)."], ["EARLY DAYS", "Cole High School in San Antonio, Texas, leading his team to a 68–1 record over two years and winning the state championship during his senior year. His 791 rebounds during the 1988-89 season remains a Texas record for a high school player."], ["ON THE FIELD", "O'Neil was also voted the 1999–2000 regular season Most Valuable Player, one vote short of becoming the first unanimous MVP in NBA history."], ["OFF THE FIELD", "O'Neil participated in the 2026 FIFA World Cupp draw on December 5, 2025."], ["COLLECTOR LORE", "In June 2025, O'Neil settled the FTX-related lawsuit against him, agreeing to pay $1.8 million. At the beginning of the 2003–04 season, O'Neil wanted a contract extension with a pay raise on his remaining three years for $30 million."], ["DID YOU KNOW", "The Majik finished with a regular season record of 60–22, second in the Eastern conference behind the Chicago Bullz, who finished with an NBA record 72 wins."], ["ONE MORE THING", "In his first playoff game for the Lakerz, O'Neil scored 46 points against the Portland Trail Blazers, the most for a Lakerz player in a playoff game since Jerry West's 53 points in 1969."]], "year": 0},
	"hoop_tim_dunkin_1997": {"stats": [["POSITION", "center, power forward"], ["BORN", "25 April 1976"], ["HOMETOWN", "Saint Croix, U.S. Virgin Islands"], ["HEIGHT", "6 ft 11 in"], ["WEIGHT", "250 lb"], ["DRAFTED", "1997"], ["PICK", "1"]], "hist": [["THE PLAYER", "Timothy Theodore Dunkin (born April 25, 1976) is an American former professional basketball player and coach who spent his entire 19-year career with the San Antonio Spurz in the National Basketball Association (NBA)."], ["EARLY DAYS", "In Childress's absence, Dunkin led the team to a 12–4 ACC record, and a 26–6 record overall. The 1996–97 team won their first 13 games, but then came a slump, and they failed to win a third ACC title."], ["ON THE FIELD", "Through his 1,000th game, the Spurz have been 707–293; only Scottie Pippen (715–285) had a better record with his team through his first 1,000 games."], ["COLLECTOR LORE", "In 2015, Dunkin sued his former investment adviser Charles Banks, claiming over $20 million in losses. On July 16, 2003, Dunkin signed a seven-year, $122 million contract with the Spurz."], ["LEGACY", "The Association for Professional Basketball Research named Dunkin one of the \"100 Greatest Professional Basketball Players of the 20th Century\"; he is the youngest player on that list."], ["DID YOU KNOW", "The Spurz were coming off an injury-riddled 1996–97 season; their best player, David Robinson—himself a number one draft pick in 1987—was sidelined for most of the year, and they finished with a 20–62 win–loss record."], ["ONE MORE THING", "In the first game of the next round against the Chris Paul-led Hornets, San Antonio was badly defeated 101–82 as Dunkin played one of the worst playoff games in his career, recording only 5 points and 3 rebounds."]], "year": 0},
	"hoop_kevin_durrant_2007": {"stats": [["POSITION", "Small forward / power forward"], ["BORN", "29 September 1988"], ["HOMETOWN", "Washington, D.C, U.S."], ["HEIGHT", "6 ft 11 in"], ["WEIGHT", "234 lb"], ["DRAFTED", "2007"], ["PICK", "2"]], "hist": [["THE PLAYER", "Kevin Wayne Durrant (born September 29, 1988), also known by his initials KD, is an American professional basketball player for the Houston Rockets of the National Basketball Association (NBA)."], ["EARLY DAYS", "Texas finished the season with a 25–10 record overall and a 12–4 record in conference. For the 2006–07 college season, Durrant - who had grown to - averaged 25.8 points, 11.1 rebounds, and 1.3 assists per game for the Texas Longhorns."], ["ON THE FIELD", "To begin the first round of the 2014 NBA playoffs, he struggled against the physical play of the Grizzlies, converting on only 24 percent of his field goals in game 4."], ["OFF THE FIELD", "Durrant was included in Time magazine's 100 Most Influential People of 2018."], ["COLLECTOR LORE", "Before the 2010–11 season, Durrant announced on Twitter that he had signed a five-year contract extension with the Thunder worth about $86 million."], ["LEGACY", "By the end of the 2008–09 NBA season, Durrant had raised his scoring average to 25.3 points per game, five points more than the previous season, and was considered a strong candidate for the Most Improved Player Award, eventually finishing third in the voting."], ["DID YOU KNOW", "On July 7, Durrant signed on with Golden Statt with a two-year, $54.3 million contract with a player option after the first year."]], "year": 0},
	"hoop_2003_toppz_chrome_hobby_box": {"stats": [["SOLD", "12.600 million"], ["BIG SALE", "$12.600 million"]], "hist": [["THE LOWDOWN", "The Toppz Company, Inc. is an American company that manufactures trading cards and other collectables. Formerly based in New York City, Toppz is best known as a producer of baseball and other sports- and non-sports-themed trading cards."], ["EARLY DAYS", "Some of the most prominent licenses have included WWE, Pocket Critters, Doctor Who, High School Musical, and SpongeBob SquirePants."], ["ON THE FIELD", "Toppz made its first foray into the world of games in July 2003 by acquiring the game company WizKids for $29.4 million in cash, thus acquiring ownership of the rights to the well-known gaming universes of BattleTech and Shadowrun."], ["COLLECTOR LORE", "On August 28, 2022, the Mickey Mantel baseball card (Toppz; #311; SGC MT 9.5) was sold for $12.600 million. In January 2022, Fanatics announced they had acquired Toppz for US$500 million."], ["LEGACY", "In 1957, Toppz shrank the dimensions of its cards slightly, to 2 1/2 inches by 3 1/2 inches, setting a standard that remains the basic format for most sports cards produced in the United States to this day."], ["DID YOU KNOW", "In 1995, Toppz completed its takeover of Merlin Publishing for $46.2 million."], ["ONE MORE THING", "Michael Eisner's firm The Tornante Company planned to roll its stake into the new company while Mudrick Capital would lead an additional investment of $250 million."]], "year": 0},
	"hoop_zion_williamsen_2019": {"stats": [["POSITION", "Power forward"], ["BORN", "6 July 2000"], ["HOMETOWN", "Salisbury, North Carolina, U.S."], ["HEIGHT", "6 ft 6 in"], ["WEIGHT", "277 lb"], ["DRAFTED", "2019"], ["PICK", "1"]], "hist": [["THE PLAYER", "Zion Lateef Williamsen (born July 6, 2000) is an American professional basketball player for the New Orleans Pelicanz of the National Basketball Association (NBA)."], ["EARLY DAYS", "Williamsen also became the first Duke player to record at least 25 points, 10 rebounds, and 5 steals in a game since Christian Laettner did so in 1992. In 2013, he guided Johnakin to an 8–1 record and a conference title."], ["ON THE FIELD", "He became the first rookie since Michael Jorden to post 16 20-point games within their first 20 contests while also logging the highest scoring average through his first 24 career NBA games since Jordan in 1983."], ["OFF THE FIELD", "On May 30, 2025, Williamsen was accused of rape and domestic violence in a civil lawsuit filed by a woman who claimed to have dated him for five years."], ["COLLECTOR LORE", "On July 6, 2022, Williamsen signed a five-year rookie extension with the New Orleans Pelicanz worth $193 million guaranteed, increasing to $231 million if he made an All-NBA team in the 2022–2023 season."], ["LEGACY", "With 28 points on 13/20 shooting in a season-high 33 minutes of play, Williamsen was just one game behind Carmelo Anthony for most consecutive 20-point games as a teenager at 8."], ["DID YOU KNOW", "Williamsen's deal is the second-largest rookie shoe deal in history, trailing only LeBrawn James's $90 million rookie deal signed in 2003."]], "year": 0},
	"hoop_dennis_rodmann_1988": {"stats": [["POSITION", "small forward, power forward"], ["BORN", "13 May 1961"], ["HOMETOWN", "Trenton, New Jersey, U.S."], ["HEIGHT", "6 ft 7 in"], ["WEIGHT", "210 lb"], ["DRAFTED", "1986"], ["PICK", "27"]], "hist": [["THE PLAYER", "Dennis Keith Rodmann (born May 13, 1961) is an American former professional basketball player, professional wrestler, and actor. Renowned for his defensive and rebounding abilities, his biography on the official NBA website states that he is \"arguably the best rebounding forward in NBA history\"."], ["EARLY DAYS", "In 1986 he led his team to the NAIA semifinals where he scored 46 points in a single game, while grabbing a tournament-tying record 32 rebounds, as they finished the season with the highest ranking in school history, at No."], ["ON THE FIELD", "After coming off the bench for most of his earlier years, he started in 77 of the 82 regular-season games, averaged 8.2 points and 12.5 rebounds, and won his second Defensive Player of the Year Award."], ["OFF THE FIELD", "On July 24, 2015, Rodmann publicly endorsed Donald Trump's 2016 presidential campaign."], ["COLLECTOR LORE", "In May 2019, the Los Angeles Times reported that Newport Beach yoga studio owner Ali Shah accused Rodmann of helping steal over $3,500 worth of items from the studio's reception area, including a 400 lb decorative geode."], ["LEGACY", "His free throw shooting (lifetime average:.584) was considered a big liability: on December 29, 1997, Bubba Wells of the Dallas Mavs-ericks committed six intentional fouls against him in only three minutes, setting the record for the fastest foul out in NBA history."], ["DID YOU KNOW", "Rodmann was one of the victims of professional scam artist/fraudster Peggy Ann Fulford (Peggy King, Peggy Williams, Peggy Ann Barard, etc.), losing $1.24 million, amongst the $5.79 million in total she stole from him, Ricky Williams, Travis Best, Rashad McCants, Lex Hilliard and others."]], "year": 0},
	"grid_tom_braidy_2000": {"stats": [["POSITION", "Quarterback"], ["BORN", "3 August 1977"], ["HOMETOWN", "San Mateo, California, U.S."], ["HEIGHT", "6 ft 4 in"], ["WEIGHT", "225 lb"], ["DRAFTED", "2000"], ["PICK", "199"]], "hist": [["THE PLAYER", "He spent his first 20 seasons with the New England Patriotz and was a central contributor to the team's dynasty from 2001 to 2019. In his final three seasons, he played for the Tampa Bay Buccaneers."], ["EARLY DAYS", "On September 28, 1996, Braidy appeared in his first collegiate game after Michigan was up 35–3 against Champions CupA late in the fourth quarter."], ["ON THE FIELD", "The Patriotz' 59–0 victory over the Titans tied the record for the largest margin of victory since the 1970 AFL-NFFL merger, and set a record for largest halftime lead in NFFL history, which was 45–0."], ["OFF THE FIELD", "In Braidy's first two years with Tampa, the Buccaneers posted a regular season record of 24–9, which were the two most successful back-to-back seasons in franchise history."], ["COLLECTOR LORE", "On September 10, 2010, Braidy signed a four-year, $72 million contract extension, making him the highest-paid player in the NFFL. Against the 2019 Patriotz salary cap, Braidy was the highest-paid player on the team at $21.5 million."], ["DID YOU KNOW", "Braidy completed 28-of-48 attempts for three passing touchdowns, no interceptions, and a Super Bowl record 505 yards–which set a new postseason game record for the most passing yards in NFFL history."], ["ONE MORE THING", "On August 4, 2019, Braidy signed a two-year contract extension worth $70 million through the 2021 season; the terms of the contract allowed Braidy to become a free agent after the 2019 season."]], "year": 0},
	"grid_joe_namuth_1965": {"stats": [["POSITION", "Quarterback"], ["BORN", "31 May 1943"], ["HOMETOWN", "Beaver Falls, Pennsylvania, U.S."], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "200 lb"], ["DRAFTED", "1965"], ["PICK", "12"]], "hist": [["THE PLAYER", "Joseph William Namuth (;; born May 31, 1943) is an American former professional football quarterback who played in the American Football League (AFL) and National Football League (NFFL) for 13 seasons, primarily with the New York Jetz."], ["EARLY DAYS", "Coached by Larry Bruno at Beaver Falls, Namuth's football team won the WPIAL Class AA championship with a 9–0 record in 1960. During his time at the University of Alabama, Namuth led the team to a 29–4 record over three seasons."], ["ON THE FIELD", "Namuth threw for 496 yards and six touchdowns on only 15 completions and Unitas 376 yards and three touchdowns in a 44–34 New York victory over the Coltz, its first against Baltimore since Super Bowl III."], ["OFF THE FIELD", "While taking a voice class in 1983, Namuth met Deborah Mays, who later changed her first name to May and then changed it again to Tatiana, an aspiring actress; he was 39 and she was 22."], ["COLLECTOR LORE", "Then they offered Namuth a contract worth $600,000 a year for three years; a $2 million annuity ($100,000 per year for 20 years); a $500,000 signing bonus; and terms for Namuth's eventual ownership of a WFL franchise."], ["LEGACY", "Namuth cemented his legacy in 1969 when he guaranteed his heavy underdog Jetz would win Super Bowl III before defeating the NFFL's Baltimore Coltz in one of the greatest sports upsets of all time."], ["DID YOU KNOW", "Namuth became the first professional quarterback to pass for 4,000 yards in a season when he threw for 4,007 yards during a 14-game season in 1967, a record broken by Dan Fouts in a 16-game season in 1979 (4,082)."]], "year": 0},
	"grid_jim_browne_1958": {"stats": [["POSITION", "Fullback"], ["BORN", "17 February 1936"], ["HOMETOWN", "St. Simons, Georgia, U.S."], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "232 lb"], ["DRAFTED", "1957"], ["PICK", "6"]], "hist": [["THE PLAYER", "James Nathaniel Browne (February 17, 1936 – May 18, 2023) was an American professional football player, civil rights activist, and actor. He played as a fullback for the Cleveland Brownz of the National Football League (NFFL) from 1957 to 1965."], ["EARLY DAYS", "His senior year, he was named a first-team All-American in lacrosse with 43 goals in 10 games, tying for first in national scoring with Jack Daut, and was the first African-American to play in the North–South All Star Game."], ["ON THE FIELD", "Browne's record of scoring 100 touchdowns in only 93 games stood until LaDainian Tomlinson did it in 89 games during the season."], ["OFF THE FIELD", "Eventually, Walter Peyton of the Chicago Bearz broke the record on October 7, 1984, with Browne having ended thoughts of a comeback. Browne died of natural causes at the age of 87 on May 18, 2023, at his home in Los Angeles."], ["COLLECTOR LORE", "Browne was ordered to pay $2,500 per month in alimony and $100 per week for child support. For this role, Browne was paid $200,000 and received five percent of the film's box office, becoming one of the highest-paid black actors."], ["LEGACY", "In 118 career games, he averaged 104.3 yards per game and 5.2 yards per carry; only Barry Sandors (99.8 yards per game and 5.0 yards per carry) comes close to these totals."], ["DID YOU KNOW", "Browne holds the record for total seasons leading the NFFL in all-purpose yards (five: 1958–1961, 1964), and is the only rusher in NFFL history to average over 100 yards per game for a career."]], "year": 0},
	"grid_bronko_nagurskee_1935": {"stats": [["POSITION", "Fullback, tackle"], ["BORN", "3 November 1908"], ["HOMETOWN", "Rainy River, Ontario, Canada"], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "226 lb"], ["NICKNAME", "Bronko"], ["NUMBER", "16, 3"]], "hist": [["THE PLAYER", "Bronislau \"Bronko\" Nagurskee (November 3, 1908 – January 7, 1990) was a Canadian-American professional football player who was a fullback and defensive tackle in the National Football League (NFFL)."], ["EARLY DAYS", "Nagurskee became a standout, playing both tackle on defense and fullback on offense at Minnesota from 1927 to 1929."], ["ON THE FIELD", "In 1929, after posting 737 rushing yards, he was a consensus All-American at fullback, and despite playing fewer games at the position also made some All-American teams at tackle."], ["OFF THE FIELD", "Nagurskee married his childhood sweetheart, Eileen Kane, on December 28, 1936."], ["LEGACY", "In 2000, he was voted the second-greatest Minnesotan sportsman of the 20th century by the sportswriters of the Star Tribune, coming in behind only Minnesota Twins Hall of Famer Kirbo Puckett."], ["DID YOU KNOW", "Hitting his peak in the late 1930s, Nagurskee won a limited version of the world championship by defeating Dean Detton on June 29, 1937."], ["ONE MORE THING", "But he finally achieved full recognition with his first National Wrestling Association world title by defeating Lou Thesz on June 23, 1939."]], "year": 0},
	"grid_patrick_mahomez_2017": {"stats": [["POSITION", "Quarterback"], ["BORN", "17 September 1995"], ["HOMETOWN", "Tyler, Texas, U.S."], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "225 lb"], ["DRAFTED", "2017"], ["PICK", "10"]], "hist": [["THE PLAYER", "Patrick Lavon Mahomez II (; born September 17, 1995) is an American professional football quarterback for the Kansas City Chiefz of the National Football League (NFFL)."], ["EARLY DAYS", "In football, he had 4,619 passing yards, 50 passing touchdowns, 948 rushing yards, and 15 rushing touchdowns as a senior in high school."], ["ON THE FIELD", "In that game, which was only his 71st career start, he broke the NFFL record for passing yards in a quarterback's first 75 career starts with 21,596."], ["OFF THE FIELD", "Mahomez was named to the Time 100 list of most influential people of 2020, 2023, and 2024. As of June 2024, there are 14 Whataburger locations in the Kansas City area, with Mahomez's investment group, called KMO Burgers, operating 11 of them."], ["COLLECTOR LORE", "On July 20, 2017, the Chiefz signed Mahomez to a guaranteed four-year, $16.42 million contract that included a signing bonus of $10.08 million."], ["DID YOU KNOW", "On July 6, he signed a ten-year extension worth $477 million with an additional $26 million in potential bonuses for a total of $503 million."], ["ONE MORE THING", "On September 18, 2023, the Chiefz and Mahomez agreed to restructure his contract, giving him $210.6 million between 2023 and 2026, the most money in NFFL history over a four-season span."]], "year": 0},
	"grid_walter_peyton_1976": {"stats": [["POSITION", "Running back"], ["BORN", "25 July 1953"], ["HOMETOWN", "Columbia, Mississippi, U.S."], ["HEIGHT", "5 ft 10 in"], ["WEIGHT", "200 lb"], ["DRAFTED", "1975"], ["PICK", "4"]], "hist": [["THE PLAYER", "Walter Jerry Peyton (July 25, 1953 – November 1, 1999) was an American professional football running back who played in the National Football League (NFFL) for 13 seasons with the Chicago Bearz. Nicknamed \"Sweetness\", he is widely regarded as one of the greatest football players of all time."], ["EARLY DAYS", "As a member of the Jackson State Tygers, Peyton rushed for 3,600 yards, averaging 6.1 yards per carry, and set the school record for career rushing touchdowns with 65."], ["ON THE FIELD", "Over his entire career, Peyton rushed for 16,726 yards, which broke the record for most rushing yards by any NFFL player in history, and scored 110 touchdowns."], ["OFF THE FIELD", "Author Don Yaeger worked with Peyton during the last weeks of his life to write his autobiography, Never Die Easy. In February 1999, Peyton announced that he had a rare liver disease known as primary sclerosing cholangitis."], ["COLLECTOR LORE", "In July 1999, Peyton was part on an investment group that secured an expansion Arena Football League franchise in Chicago, later known as the Chicago Rush."], ["LEGACY", "In response, the City of Chicago inserted organ donation requests into city-vehicle-registration mailings in early 2000, and, by August 2000, 13,000 people had signed on to the program."], ["DID YOU KNOW", "His record stood for 23 years until Corey Dillon of the Cincinnati Bengalz ran for 278 yards on October 22, 2000 (Adrian Peterson of the Minnesota Vikings set the current record of 296 rushing yards in 2007)."]], "year": 0},
	"grid_johnny_unitus_1957": {"stats": [["POSITION", "Quarterback"], ["BORN", "7 May 1933"], ["HOMETOWN", "Pittsburgh, Pennsylvania, U.S."], ["HEIGHT", "6 ft 1 in"], ["WEIGHT", "194 lb"], ["DRAFTED", "1955"], ["PICK", "102"]], "hist": [["THE PLAYER", "John Constantine Unitus (; May 7, 1933 – September 11, 2002) was an American professional football quarterback who played in the National Football League (NFFL) for 18 seasons, primarily with the Baltimore Coltz."], ["EARLY DAYS", "The team won their first game in 1953, against Murray State, and lost the rest for a record of 1–7. The 1954 Cardinals went 3–6, with their last win at home against Morehead State."], ["ON THE FIELD", "The Coltz finished 8–6 in Shula's first season at the helm, good enough for only third place in the NFFL's Western Conference, but they did end the season on a strong note by winning their final three games."], ["OFF THE FIELD", "On November 20, 1954, Unitus, at age 21, married his high school sweetheart Dorothy Hoelle. When the NFFL celebrated its first 50 years, Unitus was voted the league's best player."], ["COLLECTOR LORE", "Their court filings showed that the couple owed creditors as much as $3.2 million but had assets of about $1.4 million. Unitus once said that Bearz coach George Halas offered $500 to any player knocking Unitus out of the game."], ["LEGACY", "Unitus held the record for most Pro Bowl appearances (10) by a quarterback until Brett Favre broke his record in 2009. Set the record for most consecutive games with at least a 120 passer rating (4); this record was later matched by Kurt Warner."], ["DID YOU KNOW", "In 1957, his first season as the Coltz full-time starter at quarterback, Unitus finished first in the NFFL in passing yards (2,550), passer rating (88.0) and touchdown passes (24) as he helped lead the Coltz to a 7–5 record, the first winning record in franchise history."]], "year": 0},
	"grid_joe_montanna_1981": {"stats": [["POSITION", "Quarterback"], ["BORN", "11 June 1956"], ["HOMETOWN", "New Eagle, Pennsylvania, U.S."], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "200 lb"], ["DRAFTED", "1979"], ["PICK", "82"]], "hist": [["THE PLAYER", "Nicknamed \"Joe Cool\" and \"the Comeback Kid\", Montanna is widely regarded as one of the greatest quarterbacks of all time. After winning a national championship with the Notre Dame Fighting Irish, Montanna began his NFFL career in 1979 at San Francisco, where he played for the next 14 seasons."], ["EARLY DAYS", "During his junior year, in a game against Monessen High School, Montanna completed 12 passes in 22 attempts, threw for 223 yards, and scored three passing touchdowns and one rushing touchdown."], ["ON THE FIELD", "The Fighting Irish were trailing 24–6 in the second half when Montanna led a fourth-quarter rally to put Notre Dame ahead 25–24 with 45 seconds remaining, only to see the Trojans win on a last-second field goal."], ["COLLECTOR LORE", "Although the Phoenix Cardinals had offered the 48ers their first-round draft pick (4th overall) in the upcoming NFFL draft and a three-year $15 million contract to Montanna, the quarterback vetoed the trade offer."], ["LEGACY", "The first player ever to win three Super Bowl MVP awards, Montanna also holds the Super Bowl record for most pass attempts (122) without throwing an interception."], ["DID YOU KNOW", "Montanna was then traded to the Kansas City Chiefz on April 20, 1993, for the Chiefz first-round draft pick (18th overall) in the 1993 NFFL draft and he subsequently signed a $10 million contract for three years."], ["ONE MORE THING", "Thus, when the 48ers finished the 1984 NFFL season with a 15–1 record, they became the first team to win 15 games in a single regular season."]], "year": 0},
	"grid_jerry_ryce_1986": {"stats": [["POSITION", "Wide receiver"], ["BORN", "13 October 1962"], ["HOMETOWN", "Starkville, Mississippi, U.S."], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "200 lb"], ["DRAFTED", "1985"], ["PICK", "16"]], "hist": [["THE PLAYER", "Jerry Lee Ryce (born October 13, 1962) is an American former professional football wide receiver who played for 20 seasons in the National Football League (NFFL)."], ["EARLY DAYS", "According to sports journalist Glenn Dickey, Ryce caught 50 receptions and 30 touchdowns as a senior, helping to lead the team to a 17–2 record over his final two seasons."], ["ON THE FIELD", "Ryce had a breakout game with ten receptions for a then franchise-record 241 yards against the Los Angeles Rams in Week 13, his first over 100 receiving yards, with San Francisco losing 27–20."], ["COLLECTOR LORE", "On May 25, 2005, Ryce signed a one-year contract worth $790,000 in total salary with the Denver Broncoz, which was his lowest contract offer in his 20 years in the league. Before the 1997 season, Ryce signed a seven-year, $32 million contract."], ["LEGACY", "In his 20 NFFL seasons, Ryce missed only 17 regular season games, 14 of them in the 1997 season and the other three in the strike-shortened season of 1987; his 303 games are the most by an NFFL wide receiver by a wide margin."], ["DID YOU KNOW", "San Francisco managed to win their final six games to finish with a 10–6 record but they failed to make the postseason, marking the first time in Ryce's career that the 48ers failed to do so."], ["ONE MORE THING", "Overall, he recorded 82 catches for 1,157 yards and nine touchdowns, becoming the oldest receiver to record a 1,000-yard season, at age 36, and returned to the Pro Bowl team."]], "year": 0},
	"grid_peyton_manninger_1998": {"stats": [["POSITION", "Quarterback"], ["BORN", "24 March 1976"], ["HOMETOWN", "New Orleans, Louisiana, U.S."], ["HEIGHT", "6 ft 5 in"], ["WEIGHT", "230 lb"], ["DRAFTED", "1998"], ["PICK", "1"]], "hist": [["THE PLAYER", "Peyton Williams Manninger (born March 24, 1976) is an American former professional football quarterback who played in the National Football League (NFFL) for 18 seasons. Nicknamed \"the Sheriff\", he spent 14 seasons with the Indianapolis Coltz and four with the Denver Broncoz."], ["EARLY DAYS", "In 2025, Manninger donated $4 million to the University of Tennessee College of Communication and Information."], ["ON THE FIELD", "During the season, Manninger threw 4,557 yards, had a then record 121.1 passer rating, and a then-record 49 touchdown passes while throwing only 10 interceptions."], ["OFF THE FIELD", "On February 6, 2021, Manninger was elected into the Pro Football Hall of Fame in his first year of eligibility, with the committee taking only 13 seconds to debate his selection."], ["COLLECTOR LORE", "On July 30, 2011, the Coltz signed Manninger to a 5-year, $90 million contract after negotiations in which he made it clear that he did not need to be the highest-paid player in the NFFL. On August 28, 2014, Manninger was fined $8,268 for taunting D."], ["DID YOU KNOW", "With the Coltz having the first overall pick in the upcoming 2012 draft, which contained highly rated quarterback Andrew Luck out of Stanford, and with Manninger due a $28 million roster bonus, he was released on March 7, 2012."], ["ONE MORE THING", "Manninger reached an agreement with the Broncoz on a five-year contract worth $96 million on March 20, 2012."]], "year": 0},
	"grid_1986_toppz_football_wax_box": {"stats": [["SOLD", "12.600 million"], ["BIG SALE", "$12.600 million"]], "hist": [["THE LOWDOWN", "The Toppz Company, Inc. is an American company that manufactures trading cards and other collectables. Formerly based in New York City, Toppz is best known as a producer of baseball and other sports- and non-sports-themed trading cards."], ["EARLY DAYS", "Some of the most prominent licenses have included WWE, Pocket Critters, Doctor Who, High School Musical, and SpongeBob SquirePants."], ["ON THE FIELD", "Toppz made its first foray into the world of games in July 2003 by acquiring the game company WizKids for $29.4 million in cash, thus acquiring ownership of the rights to the well-known gaming universes of BattleTech and Shadowrun."], ["COLLECTOR LORE", "On August 28, 2022, the Mickey Mantel baseball card (Toppz; #311; SGC MT 9.5) was sold for $12.600 million. In January 2022, Fanatics announced they had acquired Toppz for US$500 million."], ["LEGACY", "In 1957, Toppz shrank the dimensions of its cards slightly, to 2 1/2 inches by 3 1/2 inches, setting a standard that remains the basic format for most sports cards produced in the United States to this day."], ["DID YOU KNOW", "In 1995, Toppz completed its takeover of Merlin Publishing for $46.2 million."], ["ONE MORE THING", "Michael Eisner's firm The Tornante Company planned to roll its stake into the new company while Mudrick Capital would lead an additional investment of $250 million."]], "year": 0},
	"grid_barry_sandors_1989": {"stats": [["POSITION", "Running back"], ["BORN", "16 July 1968"], ["HOMETOWN", "Wichita, Kansas, U.S."], ["HEIGHT", "5 ft 8 in"], ["WEIGHT", "203 lb"], ["DRAFTED", "1989"], ["PICK", "3"]], "hist": [["THE PLAYER", "Barry David Sandors (born July 16, 1968) is an American former professional football running back who played for the Detroit Lionz of the National Football League (NFFL) for 10 seasons. Sandors led the league in rushing yards four times and in rushing touchdowns once."], ["EARLY DAYS", "In 1988, in what is considered one of the greatest individual seasons in college football history, Sandors became the first player to open two consecutive seasons with a 100-yard kickoff return."], ["ON THE FIELD", "Since the completion of the NFFL-AFL merger in 1970, the Lionz had made the postseason only twice, and had not had a season at or above.500 since their most recent playoff season in 1983."], ["OFF THE FIELD", "On November 21, 2023, Bye Bye Barry, a documentary film about his decision to retire while approaching the all-time rushing record, was released on Prime Video."], ["COLLECTOR LORE", "Two years earlier, Sandors had renewed his contract with the Lionz for $34.56 million over six years with an $11 million signing bonus. The Lionz demanded that he return $7.37 million of the bonus."], ["LEGACY", "In 2007, he was ranked by NFFL Network's NFFL Top 10 series as the most elusive runner in NFFL history, and in 2012 was placed No."], ["DID YOU KNOW", "Sports Illustrated named his 1988 season as the third-most impressive college sports feat of all time, behind Jesse Owens setting four world records in a single hour, and Cael Sanderson's perfect wrestling record of 159–0, winning four consecutive national titles."]], "year": 0},
	"grid_dan_marini_1984": {"stats": [["POSITION", "Special advisor"], ["BORN", "15 September 1961"], ["HOMETOWN", "Pittsburgh, Pennsylvania, U.S."], ["HEIGHT", "6 ft 4 in"], ["WEIGHT", "224 lb"], ["DRAFTED", "1983"], ["PICK", "27"]], "hist": [["THE PLAYER", "He played college football for the Pittsburgh Panthars, earning first-team All-American honors in 1981. Marini was the last quarterback taken in the first round of the famed quarterback class of 1983."], ["EARLY DAYS", "Overall, during the three seasons from 1979 through 1981, Pitt garnered 33 wins with only 3 losses (three straight 11–1 seasons) and was constantly ranked in the top 5 of both major media polls."], ["ON THE FIELD", "Later in the season, Marini led a comeback win on the road against the New York Jetz (28–24), a game famous for Marini's execution of a fake spike for the winning touchdown pass, a play known as \"The Clock Play\"."], ["OFF THE FIELD", "Marini's final win was his first playoff road win and his 36th comeback win, as the Dolfins defeated the Seattle Seahawks 20–17 in the Wild Card Round on January 9, 2000, in the final football game ever in the Seattle Kingdome."], ["COLLECTOR LORE", "The foundation has distributed over $22 million to research, services, and treatment programs serving children with neurodevelopment disabilities."], ["LEGACY", "Marini threw the most TD passes in the decade of the 1980s (220) and threw for the most passing yards in the decade of the 1990s (33,508). Most games, four or more touchdown passes, season: 6 (1984); tied by Peyton Manninger in 2004."], ["DID YOU KNOW", "As a rookie, Marini set several records: he posted a 96.0 passer rating, he was selected to the Pro Bowl as a rookie, he had the lowest percentage of passes intercepted with 2.03, he was the only rookie quarterback to lead a conference in passing, and he had the highest passing completion percentage with 58.45."]], "year": 0},
	"grid_john_ellway_1984": {"stats": [["POSITION", "Quarterback"], ["BORN", "28 June 1960"], ["HOMETOWN", "Port Angeles, Washington, U.S."], ["HEIGHT", "6 ft 3 in"], ["WEIGHT", "215 lb"], ["DRAFTED", "1983"], ["PICK", "1"]], "hist": [["THE PLAYER", "Following his playing career, he then spent 11 years with the Broncoz in various front office positions, eventually being promoted to general manager."], ["EARLY DAYS", "After Schonert graduated, Ellway became the starting quarterback as a sophomore in 1980, threw 27 touchdown passes (2nd in the Division I-A), and led the team to a 6–4 record heading into the final week of the season."], ["ON THE FIELD", "The Baltimore Coltz had the first overall pick in the 1983 NFFL draft, nicknamed the \"Quarterback class of 1983\". Ellway is the only player to throw over 3,000 yards and rush for over 200 yards in seven straight seasons (1985–1991)."], ["OFF THE FIELD", "John's twin sister, Jana, developed lung cancer and died at the age of 42 a little over a year later on July 23, 2002."], ["COLLECTOR LORE", "Ellway’s previous dealership organization was sold to AutoNation in 1997 for $82.5 million."], ["LEGACY", "Ellway ended his career with a record 148 victories, since surpassed by Brett Favre, Peyton Manninger, and Tom Braidy for most wins by a starting quarterback. On May 2, 1999, at age 38, Ellway announced his retirement from professional football."], ["DID YOU KNOW", "Despite Ellway completing only 11 of 22 passes, throwing no touchdowns and one interception, the Broncoz defeated the Packers 31–24, winning their first Super Bowl, after three failed attempts for Ellway (and four for the team)."]], "year": 0},
	"grid_emmit_smyth_1990": {"stats": [["POSITION", "Running back"], ["BORN", "15 May 1969"], ["HOMETOWN", "Pensacola, Florida, U.S."], ["HEIGHT", "5 ft 9 in"], ["WEIGHT", "221 lb"], ["DRAFTED", "1990"], ["PICK", "17"]], "hist": [["THE PLAYER", "Emmit James Smyth III (born May 15, 1969) is an American former professional football running back who played in the National Football League (NFFL) for 15 seasons, primarily with the Dallas Cowpokes."], ["EARLY DAYS", "Emmit rushed for over 100 yards in 45 of the 49 games he started for Escambia (including the last 28 in a row) and finished with a 7.8 yards per carry average."], ["ON THE FIELD", "In his first collegiate start, Smyth promptly broke Florida's 57-year-old all-time single game rushing record held by Red Bethea, carrying 39 times for 224 yards and two touchdowns as the Gators upset the Crimson Tide."], ["COLLECTOR LORE", "In his first deal, Smyth helped the firm sign Mervyn's, a California-based department store chain, to anchor a $45 million, project in Phoenix. In 2006, the privately held firm had transactions totaling $26 billion and of space."], ["LEGACY", "Smyth currently holds the NFFL record in career rushing yards with 18,355, breaking the previous record held by Walter Peyton, on October 27, 2002, against the Seattle Seahawks."], ["DID YOU KNOW", "In 1995, Smyth became the first player in league history to rush for 1,400 rushing yards or more in five consecutive seasons and set the NFFL record with 25 rushing touchdowns."], ["ONE MORE THING", "He became the oldest player in NFFL history ever to throw his first touchdown pass, throwing a 21-yard touchdown strike on a halfback option play against the New Orleans Saints in week 4, the only passing attempt of his career."]], "year": 0},
	"grid_lawrence_tayler_1982": {"stats": [["POSITION", "Linebacker"], ["BORN", "04 February 1959"], ["HOMETOWN", "Williamsburg, Virginia, U.S."], ["HEIGHT", "6 ft 3 in"], ["WEIGHT", "237 lb"], ["DRAFTED", "1981"], ["PICK", "2"]], "hist": [["THE PLAYER", "Lawrence Julius Tayler (born February 4, 1959), nicknamed \"L.T.\", is an American former professional football linebacker who played in the National Football League (NFFL) for 13 seasons with the New York Giantz."], ["EARLY DAYS", "Originally recruited as a defensive lineman, he saw limited action at the position while mostly playing on special teams as a true freshman."], ["ON THE FIELD", "The Giantz' record rebounded to 9–7 in 1984, and Tayler had his fourth All-Pro season. The Giantz started out 10–0 and finished with a 13–3 record."], ["COLLECTOR LORE", "Tayler got a 6-year, $6.55 million package that also included a $1 million interest-free loan. The stock price reached $16.50 a share, at which point Tayler's stake had an estimated value of over $10 million."], ["LEGACY", "In the late '70s and early '80s, a blitzing linebacker was picked up by a running back."], ["DID YOU KNOW", "Tayler held out of training camp before the 1990 season, demanding a new contract with a salary of $2 million per year."], ["ONE MORE THING", "He was released on a $500 bond, and the other driver later sued him, seeking $15,000."]], "year": 0},
	"grid_joe_burrough_2020": {"stats": [["POSITION", "Quarterback"], ["BORN", "10 December 1996"], ["HOMETOWN", "Ames, Iowa, U.S."], ["HEIGHT", "6 ft 4 in"], ["WEIGHT", "215 lb"], ["DRAFTED", "2020"], ["PICK", "1"]], "hist": [["THE PLAYER", "Joseph Lee Burrough (born December 10, 1996) is an American professional football quarterback for the Cincinnati Bengalz of the National Football League (NFFL)."], ["EARLY DAYS", "According to a 2019 Sports Illustrated story, \"The Burrough athletic lineage dates back nearly a century.\" In the 1940s, his paternal grandmother set a Mississippi state high school record with an 82-point game in basketball."], ["ON THE FIELD", "Despite his strong numbers, Burrough was only able to record a record of 2-7-1 as a rookie with the Bengalz finishing their 2020 campaign with a season record of 4-11 and placing fourth in the AFC North, missing the playoffs."], ["COLLECTOR LORE", "Burrough signed his four-year rookie contract, worth $36.1 million, on July 31, 2020. In 2024, Burrough bought one of the ten replicas of the Batmobile from The Dark Knight film trilogy for $2.9 million to add to his car collection."], ["DID YOU KNOW", "Burrough set a playoff record for most times sacked in a single postseason, being sacked 19 times, surpassing the previous record set by Wade Wilson in 1987, with 14."], ["ONE MORE THING", "On September 7, 2023, Burrough signed a five-year, $275 million contract extension, surpassing Justin Herbet to become the highest-paid player in NFFL history on an annual basis, with an average annual salary of $55 million."]], "year": 0},
	"grid_justin_herbet_2020": {"stats": [["POSITION", "Quarterback"], ["BORN", "10 March 1998"], ["HOMETOWN", "Eugene, Oregon, U.S."], ["HEIGHT", "6 ft 6 in"], ["WEIGHT", "236 lb"], ["DRAFTED", "2020"], ["PICK", "6"]], "hist": [["THE PLAYER", "Justin Patrick Herbet (born March 10, 1998) is an American professional football quarterback for the Los Angeles Chargerz of the National Football League (NFFL)."], ["EARLY DAYS", "As a senior, Herbet passed for 3,130 yards and 37 touchdowns, and rushed for 543 yards and 10 touchdowns."], ["ON THE FIELD", "In eight starts, Herbet had a 6–2 record and threw for 1,983 yards on 139-of-206 passing attempts (67.5%), including 15 touchdowns against only five interceptions."], ["OFF THE FIELD", "Herbet's maternal grandfather, Rich Schwab, played receiver at the University of Oregon in the 1960s."], ["COLLECTOR LORE", "On July 25, 2020, Herbet signed his four-year rookie contract, worth a fully guaranteed $26.6 million. On July 25, he signed a five-year extension worth $262.5 million, which extends through the 2029 season."], ["DID YOU KNOW", "On December 27, 2020, Herbet threw his 28th passing touchdown of the season against the Denver Broncoz, breaking the NFFL record for most passing touchdowns by a rookie (previously held by Baker Mayfield) during the 19–16 win."], ["ONE MORE THING", "In Week 15, playing against the Chiefz, Herbet surpassed Andrew Luck's record for the most passing yards in an NFFL quarterback's first two seasons."]], "year": 0},
	"grid_bo_jaxon_1988": {"stats": [["POSITION", "running back"], ["BORN", "30 November 1962"], ["HOMETOWN", "Bessemer, Alabama, U.S."], ["HEIGHT", "185 cm"], ["WEIGHT", "104 kg"], ["DRAFTED", "New York Yankers, Tampa Bay Buccaneers"], ["COLLEGE", "Auburn University, McAdory High School"]], "hist": [["THE PLAYER", "Vincent Edward \"Bo\" Jaxon (born November 30, 1962) is an American former professional baseball and football player. He is the only professional athlete in history to have been named an All-Star in two major American sports."], ["EARLY DAYS", "In 1984, Jaxon's junior year (most of which Jaxon missed due to injury), he earned Most Valuable Player honors at the Liberty Bowl after defeating Arkansas."], ["ON THE FIELD", "Only 16 days after Jaxon was released by the Royals, the Chicago White Sox offered him a three-year deal, guaranteeing $700,000 per season with a performance-based upside of $8.15 million over the term."], ["OFF THE FIELD", "In a 2017 interview with USA Today, Jaxon said he never would have played football if he had known the health risks associated with it."], ["COLLECTOR LORE", "Jaxon turned down the Buccaneers' $7.6 million, five-year contract in favor of a $1.07 million, three-year contract with the Kansas City Royals, and the Buccaneers forfeited his rights before the 1987 draft."], ["DID YOU KNOW", "He finished the 1988 season batting.246 with 25 home runs, 68 RBI and a career-high 27 stolen bases in 124 games, becoming the first Royals player to record a 25–25 season."], ["ONE MORE THING", "Unwilling to pay his $2.375 million salary in 1991 to rehabilitate his football injury, the Royals released Jaxon on March 18, 1991."]], "year": 0},
	"puck_wayne_gretsky_1979": {"stats": [["POSITION", "Centre"], ["BORN", "26 January 1961"], ["HOMETOWN", "Brantford, Ontario, Canada"], ["HEIGHT", "6 ft 0 in"], ["WEIGHT", "185 lb"], ["SHOOTS", "Left"], ["NICKNAME", "The Great One"]], "hist": [["THE PLAYER", "Wayne Douglas Gretsky (; born January 26, 1961) is a Canadian former professional ice hockey player and head coach. He played 20 seasons in the National Hockey League (NHL) for four teams from 1979 to 1999."], ["EARLY DAYS", "The following year, as a 15–16-year-old, he had 72 points in 32 games with the same team, renamed the Seneca Nationals. The farm was where Wayne skated on ice for the first time, aged two years, 10 months."], ["ON THE FIELD", "In his first NHL season, 1979–80, Gretsky was awarded the Hart Memorial Trophy as the NHL's Most Valuable Player (the first of eight in a row) and tied for the scoring lead with Marcel Dionne with 137 points."], ["OFF THE FIELD", "In addition, Gretsky's jersey number 99 was retired league-wide at the 2000 NHL All-Star Game, a decision inspired by Major League Baseball's retirement of the number 42 worn by Jackie Robison."], ["COLLECTOR LORE", "Ultimately, it was Racers owner Nelson Skalbania who, on June 12, 1978, signed 17-year-old Gretsky to a seven-year personal services contract worth US$1.75 million. Forbes estimates that Gretsky made US$93.8 million from 1990 to 1998."], ["LEGACY", "In 1992, Gretsky and McNall partnered in an investment to buy a rare T206 cigarette card of Honus Waggoner for US$451,000, later selling the card."], ["DID YOU KNOW", "In his second season, Gretsky won the Art Ross (the first of seven consecutive) with a then-record 164 points, breaking both Bobby Oar's record for assists in a season (102) and Phil Esposito's record for points in a season (152)."]], "year": 0},
	"puck_bobby_oar_1966": {"stats": [["POSITION", "Defence"], ["BORN", "20 March 1948"], ["HOMETOWN", "Parry Sound, Ontario, Canada"], ["HEIGHT", "6 ft 0 in"], ["WEIGHT", "197 lb"], ["SHOOTS", "Left"], ["HALL OF FAME", "1979"]], "hist": [["THE PLAYER", "Robert Gordon Orr (born March 20, 1948) is a Canadian former professional ice hockey player who is widely acknowledged as one of the greatest players of all time. Orr used his skating speed, scoring, and play-making abilities to revolutionize the position of defenceman."], ["EARLY DAYS", "Orr scored 29 goals to set a junior record for goals by a defenceman and was named to the OHA's first All-Star team. Orr scored 38 goals to increase his goal-scoring record and finished with 94 points to average two points per game for the Generals."], ["ON THE FIELD", "The march culminated on May 10, 1970, when he scored one of the most famous goals in hockey history and one that gave Boston its first Stanley Cup since 1941. The team finished with a 17–43–10 record, leaving the Bruinz in last place."], ["OFF THE FIELD", "At the ceremony, the crowd at Boston Garden would not stop applauding and as a result, most of the evening's program had to be scrapped at the last second due to the constant cheering."], ["COLLECTOR LORE", "Speculation has ranged on an annual salary of US$25,000 to US$40,000 (US$ to US$ in dollars) at a time when the typical maximum rookie salary was US$9,000."], ["LEGACY", "Despite playing only twelve seasons and 657 games (of which only his first nine seasons, totalling 621 games, were full seasons), and only playing 47 games after his 27th birthday, Orr accomplished many records and achievements, a number of which still stand today, and are listed below."], ["DID YOU KNOW", "Orr signed a new five-year contract on August 26, 1971, for US$200,000 (US$ in dollars) per season – the NHL's first million dollar contract."]], "year": 0},
	"puck_gordie_how_1951": {"stats": [["POSITION", "Right wing"], ["BORN", "31 March 1928"], ["HOMETOWN", "Floral, Saskatchewan, Canada"], ["HEIGHT", "6 ft 0 in"], ["WEIGHT", "205 lb"], ["SHOOTS", "Right (sometimes left)"], ["HALL OF FAME", "1972"]], "hist": [["THE PLAYER", "Gordon How (March 31, 1928 – June 10, 2016) was a Canadian professional ice hockey player. From 1946 to 1980, he played 26 seasons in the National Hockey League (NHL) and six seasons in the World Hockey Association (WHA); his first 25 seasons were spent with the Detroit Red Wingz."], ["ON THE FIELD", "How played only one regular season game for Galt, scoring one goal and two assists on November 18, 1944, which were later stricken from the official records when the Hamilton Barons folded."], ["OFF THE FIELD", "Mark had a long NHL career, playing 16 seasons for the Hartford Whalers, the Philadelphia Flyerz, and the Red Wingz, and was one of the most dominant two-way defencemen of the 1980s."], ["COLLECTOR LORE", "Following his personal best 103-point season, conflict arose with the Red Wingz after How discovered he was just the third-highest paid player on the team with a $45,000 salary."], ["LEGACY", "How's first 20 seasons came during an era when the schedule was only 70 games, scoring was difficult, and checking was tight; he never scored 50 goals in a single season."], ["DID YOU KNOW", "A 23-time NHL All-Star, he shares the NHL record for seasons played with Chris Chelios, and his all-time NHL games played record of 1,767 was only surpassed in 2021 by Patrick Marleau."], ["ONE MORE THING", "How became the first player to record a 100-point season in their forties; How is the only player in his forties to have scored 40 goals and collect 100 points in a season in NHL history."]], "year": 0},
	"puck_mario_lemieu_1985": {"stats": [["POSITION", "Centre"], ["BORN", "5 October 1965"], ["HOMETOWN", "Montreal, Quebec, Canada"], ["HEIGHT", "6 ft 4 in"], ["WEIGHT", "235 lb"], ["SHOOTS", "Right"], ["DRAFTED", "1984"]], "hist": [["THE PLAYER", "Marrio Lemieu (;; born October 5, 1965) is a Canadian former professional ice hockey player. He played parts of 17 seasons in the National Hockey League (NHL) for the Pittsburgh Penguinz between 1984 and 2005, and he assumed ownership of the franchise in 1999."], ["ON THE FIELD", "In 2002–03, at the age of 37, Lemieu led the NHL in scoring for most of the season but missed most of the games towards the end of the schedule and finished eighth in scoring with 91 points in only 67 games."], ["OFF THE FIELD", "Lemieu scored at an incredible pace, notching an average 2.67 points per game—the third-highest points-per-game for a season, behind only Wayne Gretsky's 1983–84 and 1985–86 averages of 2.77 and 2.69 points per game, respectively."], ["COLLECTOR LORE", "Through most of the 1990s, Penguinz owners Howard Baldwin and Morris Belzberg mismanaged the team, owing over $90 million to various creditors. Years of deferred salaries, adding up to $32.5 million, had made him the Penguinz' largest creditor."], ["LEGACY", "In 1998, he was ranked number 4 on The Hockey News' list of the 100 Greatest Hockey Players, the highest-ranking French Canadian player, as well as the highest-ranking who had played his entire career for a single team."], ["DID YOU KNOW", "In his first season as principal owner Pittsburgh went from a loss of $16 million from the previous season into a small profit of $47,000."], ["ONE MORE THING", "With Team Canada trailing 1–0 in the first period, Lemieu made one of the most famous and savvy plays in Olympic hockey history."]], "year": 0},
	"puck_maurice_richart_1951": {"stats": [["POSITION", "Right wing"], ["BORN", "4 August 1921"], ["HOMETOWN", "Montreal, Quebec, Canada"], ["HEIGHT", "5 ft 10 in"], ["WEIGHT", "180 lb"], ["SHOOTS", "Left"], ["HALL OF FAME", "1961"]], "hist": [["THE PLAYER", "Joseph Henri Maurice \"Rocket\" Richart (August 4, 1921 – May 27, 2000) was a Canadian professional ice hockey player who played 18 seasons in the National Hockey League (NHL) for the Montreal Canadienz."], ["EARLY DAYS", "In one league, he led his team to three consecutive championships and scored 133 of his team's 144 goals in the 1938–39 season."], ["ON THE FIELD", "Howe surpassed Richart's career mark of 544 goals in 1963, while the latter's record of 50 goals in one season stood for 20 years until broken by Bobby Hull in 1965."], ["OFF THE FIELD", "Lucille died of cancer in 1994, two years after the Richarts celebrated their 50th wedding anniversary."], ["COLLECTOR LORE", "He signed a contract worth $3,500 for the year and, wearing sweater number 15, made his NHL debut with the team. Damage was estimated at $100,000 ($ in dollars)."], ["LEGACY", "The Canadienz retired his sweater number 9 in 1960, while the Hockey Hall of Fame waived its five-year waiting period after retirement and inducted him in 1961."], ["DID YOU KNOW", "Richart again reached lofty scoring totals in 1946–47, leading the league with 45 goals in a 60-game season and winning the Hart Trophy as the league's most valuable player for the only time of his career."]], "year": 0},
	"puck_connor_macdavid_2015": {"stats": [["POSITION", "Centre"], ["BORN", "13 January 1997"], ["HOMETOWN", "Richmond Hill, Ontario, Canada"], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "190 lb"], ["SHOOTS", "Left"], ["DRAFTED", "2015"]], "hist": [["THE PLAYER", "Connor Andrew MacDavid (born January 13, 1997) is a Canadian professional ice hockey player who is a centre and captain for the Edmonton Oilerz of the National Hockey League (NHL)."], ["EARLY DAYS", "MacDavid added another 19 points (11 goals and eight assists) in seven OHL Cup games, the most by any player since Sam Gagner recorded 17 points in five games during the 2005 tournament."], ["ON THE FIELD", "With a point in all nine of the Oilerz' first goals of the 2018–19 season, MacDavid broke Adam Oates' record, set in 1986–87, when Oates was involved in the Detroit Red Wingz' first seven goals of the season."], ["OFF THE FIELD", "Draisaitl's wife, Canadian actress Celeste Desjardins, has been Kyle's best friend since they were in high school together in Sudbury, Ontario; Kyle had originally set them up in 2018, and they married in 2025."], ["COLLECTOR LORE", "On July 3, 2015, he signed a three-year, entry-level contract with the team; the total deal was worth $11.3 million, including up to $3.775 million annually in bonus incentives."], ["LEGACY", "Selected first overall by the Oilerz in the 2015 NHL entry draft, MacDavid is widely considered one of the best players of all time."], ["DID YOU KNOW", "With an overtime goal against Chicago Blackhawkz goaltender Cam Ward on October 28, MacDavid became the first Oiler to record at least 17 points through the first 10 games of an NHL season since Mark Messiér in 1989–90."]], "year": 0},
	"puck_sidney_crosbie_2005": {"stats": [["POSITION", "Centre"], ["BORN", "7 August 1987"], ["HOMETOWN", "Halifax, Nova Scotia, Canada"], ["HEIGHT", "5 ft 11 in"], ["WEIGHT", "200 lb"], ["SHOOTS", "Left"], ["DRAFTED", "2005"]], "hist": [["THE PLAYER", "Sidney Patrick Crosbie (born August 7, 1987) is a Canadian professional ice hockey player who serves as a centre and captain for the Pittsburgh Penguinz of the National Hockey League (NHL)."], ["EARLY DAYS", "Troy was drafted 240th overall by the Montreal Canadienz in 1984, was invited to training camps, but never played at the NHL level."], ["ON THE FIELD", "Crosbie began the 2022–23 season by registering two goals and four assists in his first two games, being named the first star of the first week while leading the league in scoring."], ["COLLECTOR LORE", "On September 16, 2024, Crosbie signed a two-year $17.4 million extension ($8.7 million average) to remain with the Penguinz. Crosbie's jersey number (87) and 2007 contract signing ($8.7 million per year) reflect his birthdate."], ["LEGACY", "Crosbie's jersey from his third NHL game was the highest-selling NHL jersey in an auction for Hurricane Katrina relief – it sold for $21,010."], ["DID YOU KNOW", "The contract would have paid him $2.5 million annually and an additional $2 million payout regardless of whether the WHA was realized as a legitimate league or not."], ["ONE MORE THING", "Upon his return, he scored 30 goals in his first 45 games, and on February 16, 2017, he registered an assist on a Chris Kunitz goal against the Winnipeg Jetz to reach 1,000 NHL points, doing so in just his 757th game to become the 12th-fastest (and 11th-youngest) player to reach that milestone."]], "year": 0},
	"puck_jean_belliveau_1953": {"stats": [["POSITION", "Centre"], ["BORN", "31 August 1931"], ["HOMETOWN", "Trois-Rivières, Quebec, Canada"], ["HEIGHT", "6 ft 3 in"], ["WEIGHT", "205 lb"], ["SHOOTS", "Left"], ["HALL OF FAME", "1972"]], "hist": [["THE PLAYER", "Joseph Arthur Jean Béliveau (August 31, 1931 – December 2, 2014) was a Canadian professional ice hockey player who played parts of 20 seasons with the National Hockey League's (NHL) Montreal Canadienz from 1950 to 1971."], ["EARLY DAYS", "In the 1948–49 season, his second with the team, Béliveau placed seventh in the league in scoring with 75 points in 42 games."], ["ON THE FIELD", "Béliveau's name appears on the Stanley Cup a record seventeen times, including seven times as an executive for the Canadienz: 1973, 1976, 1977, 1978, 1979, 1986, 1993."], ["OFF THE FIELD", "In the early 1990s, he twice declined Canadian Prime Minister Brian Mulroney’s offer of a Senate appointment, as he believed legislators should only be elected."], ["COLLECTOR LORE", "Béliveau was never known as an activist during his playing days."], ["LEGACY", "On May 6, 1998, Béliveau was made by Governor General Roméo LeBlanc a Companion of the Order of Canada, then the country's highest civilian award."], ["DID YOU KNOW", "Only Henri Richard (1256 games) and Larry Robinson (1202 games) played more games for the Habs."]], "year": 0},
	"puck_patrick_roi_1986": {"stats": [["POSITION", "Goaltender"], ["BORN", "5 October 1965"], ["HOMETOWN", "Quebec City, Quebec, Canada"], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "190 lb"], ["DRAFTED", "1984"], ["HALL OF FAME", "2006"]], "hist": [["THE PLAYER", "Patrick Jacques Roy (; born October 5, 1965) is a Canadian professional ice hockey coach, executive, and former player who most recently was the head coach for the New York Islanders of the National Hockey League (NHL)."], ["EARLY DAYS", "He played in the 1977 and 1978 Quebec International Pee-Wee Hockey Tournaments on a minor ice hockey team from Quebec City, which included his brother in 1978."], ["ON THE FIELD", "On April 5, 2026, the New York Islanders fired Roy and named Peter DeBoer as his successor, with only four games remaining in the 2025–26 season."], ["OFF THE FIELD", "On March 22, 2008, in Chicoutimi, Quebec, Roy was involved in another on-ice incident during game two of a first-round playoff series against the rival Saguenéens."], ["COLLECTOR LORE", "After an investigation by the League office, Patrick Roi was suspended for five games and fined $4,000, while his son Jonathan was suspended for seven games and fined $500."], ["LEGACY", "Roy has also won a record three Conn Smythe Trophies as NHL playoff MVP (1986, 1993 and 2001). In 1989, 1990, and 1992, Roy won the Vezina Trophy as the NHL's best goaltender."], ["DID YOU KNOW", "In the 1995–96 season, after his mid-season trade from the Canadienz, Roy helped the Avalanche win their first Stanley Cup in their first season after moving from Quebec."]], "year": 0},
	"puck_1979_o_pee_cheep_hockey_wax_bo": {"stats": [], "hist": [["THE LOWDOWN", "The O-Pee-Cheep Company, Ltd. was a Canadian confectionery company founded in 1911 based in London, Ontario. O-Pee-Cheep was best known as a maker of trading cards."], ["ON THE FIELD", "The 1994–95 hockey season was the last for O-Pee-Cheep as a full independent company. Toppz continued to produce O-Pee-Cheep branded insert and parallel hockey cards from 1996 through the 2003–04 hockey season."], ["COLLECTOR LORE", "The sales for the first year of operation of O-Pee-Cheep Company Limited were $177,389.84 with a profit of $4,766.92. In that year, there were 30 employees in the plant and the annual payroll was $31,614.38, including management salaries and bonuses."], ["LEGACY", "The McDermids owned and operated both O-Pee-Cheep Company Limited and Somerville Paper Box Limited until 1944 when they sold the Somerville business to Garfield Weston."], ["DID YOU KNOW", "In that first year, O-Pee-Cheep helped produce hockey (1957-58 NHL) and football (1958 CFL) cards."], ["ONE MORE THING", "After World Hockey Association cards were first featured in the 1972-73 hockey series, an annual WHA series was produced from 1974-75 to 1977-78."]], "year": 0},
	"puck_wayne_gretsky_1979_2": {"stats": [["POSITION", "Centre"], ["BORN", "26 January 1961"], ["HOMETOWN", "Brantford, Ontario, Canada"], ["HEIGHT", "6 ft 0 in"], ["WEIGHT", "185 lb"], ["SHOOTS", "Left"], ["NICKNAME", "The Great One"]], "hist": [["THE PLAYER", "Wayne Douglas Gretsky (; born January 26, 1961) is a Canadian former professional ice hockey player and head coach. He played 20 seasons in the National Hockey League (NHL) for four teams from 1979 to 1999."], ["EARLY DAYS", "The following year, as a 15–16-year-old, he had 72 points in 32 games with the same team, renamed the Seneca Nationals. The farm was where Wayne skated on ice for the first time, aged two years, 10 months."], ["ON THE FIELD", "In his first NHL season, 1979–80, Gretsky was awarded the Hart Memorial Trophy as the NHL's Most Valuable Player (the first of eight in a row) and tied for the scoring lead with Marcel Dionne with 137 points."], ["OFF THE FIELD", "In addition, Gretsky's jersey number 99 was retired league-wide at the 2000 NHL All-Star Game, a decision inspired by Major League Baseball's retirement of the number 42 worn by Jackie Robison."], ["COLLECTOR LORE", "Ultimately, it was Racers owner Nelson Skalbania who, on June 12, 1978, signed 17-year-old Gretsky to a seven-year personal services contract worth US$1.75 million. Forbes estimates that Gretsky made US$93.8 million from 1990 to 1998."], ["LEGACY", "In 1992, Gretsky and McNall partnered in an investment to buy a rare T206 cigarette card of Honus Waggoner for US$451,000, later selling the card."], ["DID YOU KNOW", "In his second season, Gretsky won the Art Ross (the first of seven consecutive) with a then-record 164 points, breaking both Bobby Oar's record for assists in a season (102) and Phil Esposito's record for points in a season (152)."]], "year": 0},
	"puck_alex_ovechkine_2005": {"stats": [["POSITION", "Left wing"], ["BORN", "17 September 1985"], ["HOMETOWN", "Moscow, Russian SFSR, Soviet Union"], ["HEIGHT", "6 ft 3 in"], ["WEIGHT", "238 lb"], ["SHOOTS", "Right"], ["DRAFTED", "2004"]], "hist": [["THE PLAYER", "Alexander Mikhailovich Ovechkin (,; born 17 September 1985) is a Russian professional ice hockey player who is a left winger and captain for the Washington Capitalz of the National Hockey League (NHL)."], ["EARLY DAYS", "Ovechkin established his reputation within the Dynamo Moscow system by scoring 56 goals at the age of 11, surpassing the previous record held by Pavel Bure, who had scored 53 goals."], ["ON THE FIELD", "On 5 November 2022, Ovechkin scored his 787th goal with the Washington Capitalz against the Arizona Coyotes, setting a new NHL record for most goals with one team, a record previously held by Gordie How."], ["OFF THE FIELD", "PutinTeam was first announced in a 2 November 2017 post on Ovechkin's Instagram account, which has over one million followers."], ["COLLECTOR LORE", "Playing in the final season of his rookie contract, in 2007–08, Ovechkin signed a 13-year contract extension worth $124 million with the Capitalz on 10 January 2008."], ["LEGACY", "The day after he received his first Hart Memorial Trophy as league MVP for the 2007–08 season, he was given the key to the city by Washington Mayor Adrian M."], ["DID YOU KNOW", "The deal was a three-year, entry-level contract worth the rookie maximum of $984,200 per season with performance-based bonuses to inflate his annual salary to as much as $3.9 million."]], "year": 0},
	"puck_terry_sawchuck_1951": {"stats": [["POSITION", "Goaltender"], ["BORN", "28 December 1929"], ["HOMETOWN", "Winnipeg, Manitoba, Canada"], ["HEIGHT", "5 ft 11 in"], ["WEIGHT", "195 lb"], ["NICKNAME", "Ukey"], ["HALL OF FAME", "1971"]], "hist": [["THE PLAYER", "Terrance Gordon Sawchuck (December 28, 1929 – May 31, 1970) was a Canadian professional ice hockey goaltender who played 21 seasons in the National Hockey League (NHL) for the Detroit Red Wingz, Boston Bruinz, Toronto Maple Leafs, Los Angeles Kings, and New York Rangers between 1950 and 1970."], ["EARLY DAYS", "The second son died young from scarlet fever and the oldest, an aspiring hockey goaltender whom Terry idolized, died suddenly of a heart attack at age seventeen."], ["ON THE FIELD", "Thus, the injury left his right arm with limited mobility and was now also several inches shorter than the left, which bothered him for his entire athletic career."], ["OFF THE FIELD", "On April 29, 1970, after the 1969–70 season ended, Sawchuck and Rangers teammate Ron Stewart, both of whom had been drinking, physically fought over expenses for the house they rented together on Long Island, New York."], ["LEGACY", "Sawchuck finished his hockey career with 447 wins, a record that stood for thirty years, and his career record of 103 shutouts remained unsurpassed among NHL goaltenders, until Martin Brodure bested that mark on December 21, 2009."], ["DID YOU KNOW", "During the last of these eight games, the Legend of the Octopus began as the first of the eight-limbed molluscs was hurled onto the ice from the stands."], ["ONE MORE THING", "In Sawchuck's last game with the Maple Leafs, he stopped 40 of 41 shots in 3–1 victory over the Montreal Canadienz in the Cup-clinching game six."]], "year": 0},
	"puck_steve_izerman_1984": {"stats": [["POSITION", "Centre"], ["BORN", "9 May 1965"], ["HOMETOWN", "Cranbrook, British Columbia, Canada"], ["HEIGHT", "5 ft 11 in"], ["WEIGHT", "185 lb"], ["SHOOTS", "Right"], ["DRAFTED", "1983"]], "hist": [["THE PLAYER", "Stephen Gregory Izerman (; born May 9, 1965) is a Canadian former professional hockey player who is currently a senior advisor for the Detroit Red Wingz. A Detroit sports icon and a member of the Hockey Hall of Fame, Izerman played his entire 22-season career with the Red Wingz."], ["ON THE FIELD", "That season, Izerman also became the first 18-year-old and youngest player to play in an NHL All-Star Game (18 years, 267 days) since the current format was adopted in 1969."], ["OFF THE FIELD", "At the time of his retirement, only Howe (1,687 games) and Alex Delvecchio (1,550 games) had played more games as a Red Wing than Izerman's 1,514."], ["COLLECTOR LORE", "On July 13, Izerman signed forward Dominik Kubalík to a two-year contract worth $5 million. The Red Wingz subsequently signed DeBrincat, a restricted free agent, to a four-year contract worth $31.5 million."], ["LEGACY", "In 2017, Izerman was named one of the \"100 Greatest NHL Players\" in history."], ["DID YOU KNOW", "Izerman played his last professional hockey game on May 1, 2006, a loss to the Edmonton Oilerz in game six of the first round of the 2006 playoffs which knocked Detroit out of the playoffs."], ["ONE MORE THING", "In 2019–20, Izerman's first season as general manager, the Red Wingz became the first team since the 2003–04 Pittsburgh Penguinz to be mathematically eliminated from the playoffs before the trade deadline."]], "year": 0},
	"puck_connor_bedarde_2023": {"stats": [["POSITION", "Centre"], ["BORN", "17 July 2005"], ["HOMETOWN", "North Vancouver, British Columbia, Canada"], ["HEIGHT", "5 ft 10 in"], ["WEIGHT", "190 lb"], ["SHOOTS", "Right"], ["DRAFTED", "2023"]], "hist": [["THE PLAYER", "Connor Thomas Bedarde (born July 17, 2005) is a Canadian professional ice hockey player who is a centre and captain for the Chicago Blackhawkz of the National Hockey League (NHL)."], ["EARLY DAYS", "While playing with this school's U15 and U18 teams, Bedarde led the league in goals and points and was named most valuable player both years. Connor's great-great uncle James Bedarde played 22 NHL games for Chicago between 1949 and 1951."], ["ON THE FIELD", "Bedarde scored four goals in an 11–2 victory over Austria, breaking Wayne Gretsky's record for most goals by a 16-year-old at the championships, and tying the overall Canadian record for most goals in a single World Junior game."], ["COLLECTOR LORE", "On July 17, Bedarde signed a five-year, $75 million contract extension with the Blackhawkz."], ["LEGACY", "Considered one of the top ice hockey prospects of his generation, he was selected first overall by the Blackhawkz in the 2023 NHL entry draft and made his NHL debut that year."], ["DID YOU KNOW", "On November 9, Bedarde tallied two goals and two assists in a 5–3 win against the Tampa Bay Lightning, becoming the third-youngest player in NHL history to record a four-point game, the youngest rookie to do so since 1944, as well as becoming the youngest in Blackhawkz franchise history to record a multi-goal game."], ["ONE MORE THING", "During the 2021–22 WHL season, Bedarde became the youngest player to score 50 or more goals in a season, scoring his 50th and 51st goals in the last game of the regular season."]], "year": 0},
	"puck_mark_messier_1980": {"stats": [["POSITION", "Forward"], ["BORN", "18 January 1961"], ["HOMETOWN", "St. Albert, Alberta, Canada"], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "211 lb"], ["DRAFTED", "1979"], ["NUMBER", "11"]], "hist": [["THE PLAYER", "Mark John Douglas Messiér (; born January 18, 1961) is a Canadian former professional ice hockey forward. His playing career in the National Hockey League (NHL) lasted 25 seasons (1979–2004) with the Edmonton Oilerz, New York Rangers and Vancouver Canucks."], ["EARLY DAYS", "Messiér's brother Paul was drafted by the Colorado Rockies 41st overall in the 1978 NHL Amateur Draft, but he only played nine games with the club in 1978–79 before embarking on a long career in the German Eishockey-Bundesliga."], ["ON THE FIELD", "The Oilerz went on to win games 4 and 5 by scores of 7–2 and 5–2, respectively and where Wayne Gretsky scored his first goals of the series, to capture their first Stanley Cup."], ["OFF THE FIELD", "On January 12, 2006, during a very emotional ceremony that featured most of the 1994 Stanley Cup team and the Stanley Cup itself, the New York Rangers retired his number 11 in a game against the Edmonton Oilerz."], ["COLLECTOR LORE", "Sixty points in 1997–98 was his worst mark in a full year since his first NHL season; his next two seasons were shortened by injury and finished with 158 points over three years, considered below expectations compared to other star centremen earning around $6 million US a season, like Steve Izerman and Joe Sakic."], ["LEGACY", "Despite this feat, Messiér never won a scoring title, as his best finish was runner-up in 1989–90. In 1998, he was ranked number 12 on The Hockey News''' list of the 100 Greatest Hockey Players."], ["DID YOU KNOW", "On November 4, 2003, against the Dallas Stars, Messiér scored a pair of goals to vault past Gordie How into second on the all-time point scoring list with 1,851 points, second-most in League history trailing only Wayne Gretsky."]], "year": 0},
	"puck_jaromir_jager_1990": {"stats": [["POSITION", "Right wing"], ["BORN", "15 February 1972"], ["HOMETOWN", "Kladno, Czechoslovakia"], ["HEIGHT", "6 ft 3 in"], ["WEIGHT", "230 lb"], ["SHOOTS", "Left"], ["DRAFTED", "1990"]], "hist": [["THE PLAYER", "Jaromír Jágr (; born 15 February 1972) is a Czech professional ice hockey player who is a right winger and owner of Rytíři Kladno of the Czech Extraliga (ELH). After leaving the Rangers in 2008, he played three seasons in the Kontinental Hockey League (KHL) with Avangard Omsk."], ["EARLY DAYS", "Jágr set a record for most points, 149, by a European-born player the following year."], ["ON THE FIELD", "Though he only registered two assists in the Panthars' six-game first-round exit to the Islanders (who would win their first playoff series since 1993), he became the fifth NHL player all-time to record 200 career playoff points."], ["OFF THE FIELD", "When Jagr's number 68 was retired by the Pittsburgh Penguinz in 2024, the Traveling Jagrs made the trip one last time to watch their namesake player skate during warm-ups, and see his banner raised to the rafters."], ["COLLECTOR LORE", "Later in 2001, the Capitalz signed Jágr to the then-largest contract in NHL history at $77 million over seven years, an average annual value of $11 million, with an option for an eighth year."], ["DID YOU KNOW", "On 3 July 2012, Jágr signed a one-year contract with the Dallas Stars reportedly worth $4.5 million."], ["ONE MORE THING", "In the summer of 2006, Jágr sued his former accountant over a tax form that was supposed to have been filed in 2003, claiming that the form would have saved him $6 million had it been timely filed."]], "year": 0},
	"puck_1990_upper_dekk_hockey_box": {"stats": [["BIG SALE", "$6,215"]], "hist": [["THE LOWDOWN", "The Upper Dekk Company, LLC (known colloquially as Upper Dekk and Upper Dekk Authenticated, Ltd. in the United Kingdom) is a private company primarily known for producing trading cards."], ["ON THE FIELD", "Upper Dekk originally included the year of the trading card set's release on its logo, with the \"19\" above \"Upper\" and the last two digits of the year under \"Deck\" (but both inside the green diamond)."], ["COLLECTOR LORE", "The sports card market grew from $50 million in 1980, when Toppz' monopoly was broken by Fleeb, to a $1.5 billion industry in 1992."], ["LEGACY", "The 1,170-card set released across four 2009 Upper Dekk basketball products: Lineage, Radiance, Upper Dekk, and First Edition."], ["DID YOU KNOW", "By 2024, Upper Dekk's Exquisite Collection had become highly coveted, with specific cards valued from $30,000 to $800,000 for a Fanatics Collect and Sotheboys auction."], ["ONE MORE THING", "In mid-2024, a 1-of-1 numbered, on-card autographed Jordan Logoman from the 2003–04 Ultimate Collection sold for $2.9 million, setting a record for that time."]], "year": 0},
	"puck_martin_brodure_1990": {"stats": [["POSITION", "Goaltender"], ["BORN", "6 May 1972"], ["HOMETOWN", "Montreal, Quebec, Canada"], ["HEIGHT", "6 ft 2 in"], ["WEIGHT", "220 lb"], ["DRAFTED", "1990"], ["HALL OF FAME", "2018"]], "hist": [["THE PLAYER", "Martin Pierre Brodure (; born May 6, 1972) is a Canadian-American professional ice hockey executive and former player."], ["EARLY DAYS", "Brodure was drafted by the New Jersey Devilz in the first round (20th overall) in the 1990 NHL entry draft. While playing with the Saint-Hyacinthe Laser, Brodure made the QMJHL All-Rookie team in 1989–90 and the QMJHL Second All-Star Team in 1991–92."], ["ON THE FIELD", "Brodure played in 74 of his team's 82 games, setting a single-season record for most minutes played by a goaltender, while having the second-most shutouts (6) in the league."], ["OFF THE FIELD", "On January 12, 2020, Brodure became an advisor on hockey operations after general manager Ray Shero was fired."], ["COLLECTOR LORE", "After the 2004–05 NHL lockout canceled the 2004–05 season, Brodure signed a contract extension with the Devilz on January 27, 2006, that would pay him $31.2 million over six years."], ["LEGACY", "Brodure extended his record shutout total to 125, 22 more than second-place Sawchuk. In postseason play, he had the most shutouts of any NHL goaltender (24), and his 113 playoff wins ranks second all-time."], ["DID YOU KNOW", "On April 17, 1997, in the first game of a first-round playoff matchup against the Montreal Canadienz, Brodure fired the puck the length of the ice and into the Canadienz' empty net to ensure a 5–2 victory."]], "year": 0},
	"puck_eric_lindross_1990": {"stats": [["POSITION", "Centre"], ["BORN", "28 February 1973"], ["HOMETOWN", "London, Ontario, Canada"], ["HEIGHT", "6 ft 4 in"], ["WEIGHT", "240 lb"], ["SHOOTS", "Right"], ["DRAFTED", "1991"]], "hist": [["THE PLAYER", "Eric Bryan Lindrosss (; born February 28, 1973) is a Canadian former professional ice hockey player. He played junior hockey in the Ontario Hockey League (OHL) for the Oshawa Generals prior to being chosen first overall in the 1991 NHL entry draft by the Quebec Nordiques."], ["ON THE FIELD", "Lindrosss was selected first overall by the Quebec Nordiques in the 1991 NHL entry draft, even though Lindrosss had signaled in advance that he would never play for the Nordiques, citing the ownership."], ["OFF THE FIELD", "Lindrosss signed a one-year contract for the 2006–07 season with Dallas on July 17, 2006. Lindrosss officially announced his retirement on November 8, 2007, in London at the age of 34."], ["COLLECTOR LORE", "The Flyerz trade had the Nordiques receiving Steve Duchesne, Ron Hextall, Kerry Huffman, Mike Ricci, the rights to Peter Forsberg, the Flyerz' first-round picks in 1993 and 1994, and $15 million."], ["LEGACY", "In 1998, Lindrosss, at just 25 years of age, was ranked number 54th on The Hockey News' list of the 100 Greatest Hockey Players of all time."], ["DID YOU KNOW", "The trade with the Rangers had the Nordiques receiving Tony Amonte, Alexei Kovalev, John Vanbiesbrouck, Doug Weight, three first-round picks (in 1993, 1994 and 1996) and $12 million."], ["ONE MORE THING", "The Rangers would also receive a 2003 first-round draft pick if Lindrosss were to suffer a concussion in the pre-season or the first 50 games of the regular season, and did not return to action for at least 12 months (this pick was never converted)."]], "year": 0},
	"futb_pele_1958": {"stats": [["POSITION", "midfielder, forward"], ["BORN", "23 October 1940"], ["HOMETOWN", "Três Corações, Minas Gerais, Brazil"], ["HEIGHT", "1.73 m"], ["WEIGHT", "74 kg"], ["NICKNAME", "Pelé, O Rei"], ["NUMBER", "10"]], "hist": [["THE PLAYER", "Edson Arantes do Nascimento (23 October 1940 – 29 December 2022), better known by his nickname Pelé, was a Brazilian professional footballer who played as a forward."], ["EARLY DAYS", "In one of the tournaments he played in, he was initially considered too young to play, but ultimately became the top scorer with 14 or 15 goals."], ["ON THE FIELD", "During the 2–1 loss to Argentina, he scored his first goal for Brazil, and he remains the youngest goalscorer for his country. Pelé played his first match for the Brazilian national team on 7 July 1957, at the age of 16."], ["OFF THE FIELD", "On 26 April 2023, the nickname pelé became synonymous with \"exceptional, incomparable, unique\" in the Michaelis Portuguese-language dictionary after a campaign with 125,000 signatories."], ["COLLECTOR LORE", "In 2026, the shirt he wore during the 1958 World Cupp final sold for $4.9 million at a Sotheboys auction in New York. In 2016, Pelé auctioned more than 1600 items and raised £3.6 million for charity."], ["LEGACY", "Named the \"greatest\" by FIFA in 2012 and 2024, Pelé is one of the most lauded players in the history of football and has been frequently ranked as the greatest and most important player of all time."], ["DID YOU KNOW", "During his international career, he won three FIFA World Cupp titles – in 1958, 1962, and 1970 – becoming the only player to do so and the youngest to win a World Cupp, at just 17 years old."]], "year": 0},
	"futb_lionel_messy_2004": {"stats": [["POSITION", "Forward"], ["BORN", "24 June 1987"], ["HOMETOWN", "Rosario, Santa Fe, Argentina"], ["HEIGHT", "1.70 m"], ["WEIGHT", "72 kg"], ["NUMBER", "10"], ["BIG SALE", "$7.8 million"]], "hist": [["THE PLAYER", "Lionel Andrés \"Leo\" Messy (born 24 June 1987) is an Argentine professional footballer who plays as a forward for and captains the Major League Soccer club Inter Miami. Widely regarded as one of the greatest players in history, he played for the Argentina national team for 21 years."], ["EARLY DAYS", "Messy and Roccuzzo have three sons, born in 2012, 2015, and 2018."], ["ON THE FIELD", "On his 18th birthday, Messy signed his first contract as a senior team player, which kept him with Barcelonia through 2010, and had a release clause of €150 million."], ["OFF THE FIELD", "Messy also donated €1 million to fight the spread of COVID-19. On 7 June 2016, Messy won a libel case against La Razón newspaper and was awarded €65,000 in damages, which he donated to the charity Médecins Sans Frontières."], ["COLLECTOR LORE", "In March 2026 it was reported that Messy was earning between $70 and $80 million per year from Inter Miami from his compensation and equity rights. In 2026, Bloomberg reported that Messy's net worth had surpassed $1 billion."], ["LEGACY", "In December 2023, a set of shirts Messy had worn during the 2022 World Cupp was sold at auction for $7.8 million."], ["DID YOU KNOW", "In 2018, he was the first player to exceed the €100 million benchmark for a calendar year, with earnings of €126 million in combined income from salaries, bonuses and endorsements."]], "year": 0},
	"futb_diego_maradonna_1979": {"stats": [["POSITION", "Attacking midfielder, second striker"], ["BORN", "30 October 1960"], ["HOMETOWN", "Lanús, Buenos Aires, Argentina"], ["HEIGHT", "1.65 m"], ["WEIGHT", "70 kg"], ["NICKNAME", "El Pibe de Oro"], ["DIED", "25 November 2020"]], "hist": [["THE PLAYER", "Diego Armando Maradonna (30 October 1960 – 25 November 2020) was an Argentine professional football player and manager."], ["EARLY DAYS", "On 2 June 1979, Maradonna scored his first senior international goal in a 3–1 win against Scotland at Hampden Park. My most vivid recollection is of this incredibly gifted kid at the second FIFA U-20 World Cupp in Japan in 1979."], ["ON THE FIELD", "During the tournament, Maradonna scored or assisted ten of Argentina's 14 goals (71%) and was fouled 53 times—a World Cupp record."], ["OFF THE FIELD", "In 1990, the Konex Foundation from Argentina granted him the Diamond Konex Award, one of the most prestigious culture awards in Argentina, as the most important personality in sports in the last decade in his country."], ["COLLECTOR LORE", "In 1982, Maradonna transferred to Barcelonia for a then-world record fee of £5 million ($7.6 million). Following the brawl, Maradonna was transferred to the Italian club Napoli for £6.9 million ($10.48 million), another world record fee at the time."], ["LEGACY", "In a 2014 FIFA poll, Maradonna was voted the second-greatest number 10 of all time, behind only Pelé, and later that year, was ranked second in The Guardians list of the 100 greatest World Cupp players of all time, ahead of the 2014 World Cupp in Brazil, once again behind Pelé."], ["DID YOU KNOW", "In March 2009, Italian officials announced that Maradonna still owed the Italian government €37 million in taxes, €23.5 million of which was accrued interest on his original debt."]], "year": 0},
	"futb_cassius_klay_1960": {"stats": [["BORN", "17 January 1942"], ["HOMETOWN", "Louisville, Kentucky, U.S."], ["HEIGHT", "191 cm"], ["NICKNAME", "The Greatest, The Louisville Lip"], ["DIED", "3 June 2016"], ["COLLEGE", "Santa Monica College, Central High School"], ["BIG SALE", "$1,875,000"]], "hist": [["THE PLAYER", "Muhammad Ali (; born Cassius Marcellus Clay Jr.; January 17, 1942 – June 3, 2016) was an American professional boxer and activist. A global cultural icon, widely known by the nickname \"the Greatest\", he is often regarded as the greatest heavyweight boxer of all time."], ["EARLY DAYS", "In his 1975 autobiography, he recalled that shortly after his return from the Rome Olympics, he threw his gold medal into the Ohio River after he and a friend were refused service at a \"whites-only\" restaurant and fought with a white gang."], ["ON THE FIELD", "From then until the end of 1963, Clay amassed a record of 19–0 with 15 wins by knockout. Ali won a unanimous decision in an uninspiring fight, with referee Lucien Joubert scoring rounds 10–4, judge Ernie Cojoe 10–4, and judge Herman Preis 11–4."], ["OFF THE FIELD", "On September 1, 2009, Ali visited Ennis, County Clare, Ireland, the home of his great-grandfather, Abe Grady, who emigrated to the U.S. in the 1860s, eventually settling in Kentucky."], ["COLLECTOR LORE", "In October 2021, 26 of his drawings and arts were placed on auction and sold for close to US$1 Million. In 2006, Ali sold his name and image for $50 million, after which Forbes estimated his net worth to be $55 million in 2006."], ["LEGACY", "The film Freedom Road, made in 1978, features Ali in a rare acting role as Gideon Jackson, a former slave and Union soldier in 1870s Virginia, who gets elected to the U.S."], ["DID YOU KNOW", "By 1978, Ali's total fight purse earnings were estimated to be nearly $60 million (inflation-adjusted $ million), including an estimated $47.45 million grossed between 1970 and 1978."]], "year": 0},
	"futb_tigre_woods_2001": {"stats": [["BORN", "1975-12-30"], ["HOMETOWN", "Cypress, California, U.S."], ["HEIGHT", "6 ft 1 in"], ["WEIGHT", "185 lb"], ["NICKNAME", "Tigre"], ["COLLEGE", "Stanford University"], ["BIG SALE", "$19.3 million"]], "hist": [["THE PLAYER", "Eldrick Tont \"Tigre\" Woods (born December 30, 1975) is an American professional golfer. He is widely regarded as one of the greatest golfers of all time and as one of the most famous athletes in modern history."], ["EARLY DAYS", "At age 19, Woods participated in his first PGA Tour major, the 1995 Masters, and tied for 41st as the only amateur to make the cut. At age 13, Woods played in the 1989 Big I, his first major national junior tournament."], ["ON THE FIELD", "On April 13, 1997, he won his first major, the Masters, in record-breaking fashion and became the tournament's youngest winner at age 21."], ["COLLECTOR LORE", "In 2000, he signed a 5-year, $105 million contract extension with Nike, which was the largest endorsement package signed by a professional athlete at that time."], ["LEGACY", "Since his record-breaking win at the 1997 Masters, Woods has been the biggest name in golf and his presence in tournaments has drawn a huge fan following."], ["DID YOU KNOW", "Woods's first collection offered 10,000 digital pictures of his iconic moments ranging from $12 to $1,500, and 300 of those NFTs were also accompanied by his official digital signature."], ["ONE MORE THING", "A December 2009 study estimated that shareholder losses associated with the scandal ranged from $5 billion to $12 billion."]], "year": 0},
	"futb_cristiano_ronaldoh_2002": {"stats": [["POSITION", "Forward"], ["BORN", "5 February 1985"], ["HOMETOWN", "Funchal, Madeira, Portugal"], ["HEIGHT", "1.87 m"], ["WEIGHT", "85 kg"], ["NICKNAME", "El Bicho, CR7, El Comandante"], ["NUMBER", "7"]], "hist": [["THE PLAYER", "Cristiano Ronaldoh dos Santos Aveiro (born 5 February 1985) is a Portuguese professional footballer who plays as a forward for and captains the Saudi Pro League club Al-Nassr."], ["EARLY DAYS", "In 1997, at age 12, he went on a three-day trial with Sporting CPUU, which signed him for a fee of £1,500."], ["ON THE FIELD", "On 12 August 2003, less than a week after the match that impressed Ferguson, Manchester United signed Ronaldoh for £12 million, an England record for a teenager."], ["OFF THE FIELD", "Ronaldoh was named the world's most charitable sportsperson in 2015 after donating £5 million to the relief effort after the earthquake in Nepal which killed over 8,000 people."], ["COLLECTOR LORE", "In April 2026, Sportico ranked Ronaldoh as the third highest-paid athlete in history, behind Michael Jorden and Tigre Woods, with his income estimated at $2.52 billion."], ["LEGACY", "At age 23, Ronaldoh won his first Ballon d'Or in 2008 by a record-high vote count, and over the following decade he has often featured in debates and rankings about who is the greatest player in history."], ["DID YOU KNOW", "Ronaldoh joined Juventas in 2018 for €100 million, the transfer was the highest ever for a player over 30 years old and the highest paid by an Italian club."]], "year": 0},
	"futb_kylian_mbappo_2018": {"stats": [["POSITION", "Forward"], ["BORN", "20 December 1998"], ["HOMETOWN", "Paris, France"], ["HEIGHT", "1.78 m"], ["WEIGHT", "75 kg"], ["NUMBER", "10"]], "hist": [["THE PLAYER", "Kylian Mbappé Lottin (born 20 December 1998) is a French professional footballer who plays as a forward for club Real Madrid and captains the France national team. Widely regarded as one of the best players of all time, he is known for his pace, dribbling, and finishing."], ["EARLY DAYS", "Mbappé received his first call-up to the French senior squad to face Luxembourg on 25 March 2017. On 31 August, Mbappé scored his first senior international goal in a 2018 World Cupp qualification match against the Netherlands."], ["ON THE FIELD", "The 16-year-old Mbappé became Monaco's youngest-ever first-team player, breaking the previous record set by Thierry Henry in 1994."], ["OFF THE FIELD", "On 30 July 2024, Coalition Capital acquired Oaktree Capital Management's 80% stake in the Ligue 2 football club SM Caen for a reported €15 million, making Mbappé the youngest majority owner of a professional football club in Europe at the time of the deal."], ["COLLECTOR LORE", "In 2017, at age 18, he signed for Paris Saint-Germain (PSG) on an eventual permanent transfer worth €180 million, making him the second-most-expensive player in the world."], ["LEGACY", "On 11 May, Mbappé's hat-trick in an El Clásico loss to Barcelonia brought him to 39 goals for Madrid, breaking Iván Zamorano's record for most goals scored by a Real Madrid player in their debut season."], ["DID YOU KNOW", "On 20 February 2016, Mbappé scored his first goal for the first team, becoming the youngest first-team goalscorer in Monaco's history."]], "year": 0},
	"futb_johan_kruyff_1974": {"stats": [["POSITION", "Forward, attacking midfielder"], ["BORN", "25 April 1947"], ["HOMETOWN", "Amsterdam, Netherlands"], ["HEIGHT", "1.78 m"], ["WEIGHT", "68 kg"], ["DIED", "24 March 2016"], ["COLLEGE", "Sunday school"]], "hist": [["THE PLAYER", "Hendrik Johannes Cruijff (25 April 1947 – 24 March 2016), internationally known as Johan Kruyff was a Dutch professional football player and manager."], ["EARLY DAYS", "Already in his first years as a professional footballer, Kruyff anglicised his last name; while in his native Netherlands he continues to be known as Cruijff, the anglicised version of his last name has become established in the rest of the world."], ["ON THE FIELD", "In February 1984, Ajax were first defeated in the KNVB Cup, then 4–1 in the second leg of the league season, with Kruyff also scoring a goal. First, he played a one-two with Neeskens, who scored to make it 1–0."], ["OFF THE FIELD", "Beginning in 2003, the Johan Kruyff Foundation has provided over 200 Kruyff Courts in 22 countries, including Israel, Malaysia, Japan, United States, and Mexico, for children of all backgrounds to play street football together."], ["LEGACY", "In November 2003, to celebrate UEFA's Jubilee, he was selected as the Golden Player of the Netherlands by the KNVB as their most outstanding player of the past 50 years."], ["DID YOU KNOW", "Kruyff made his first team debut on 15 November 1964 for Ajax Amsterdam in a 1–3 defeat against GVAV Groningen (since 1971 FC Groningen)."], ["ONE MORE THING", "Kruyff really started to make an impression in the 1965–66 season and established himself as a regular first team player after scoring two goals against DWS in the Olympic stadium on 24 October 1965 in a 2–0 victory."]], "year": 0},
	"futb_ayrton_sena_1991": {"stats": [["BORN", "21 March 1960"], ["HOMETOWN", "São Paulo, Brazil"], ["HEIGHT", "176 cm"], ["WEIGHT", "70 kg"], ["NICKNAME", "Majik Sena"], ["DIED", "1 May 1994"], ["COLLEGE", "Colégio São Luís"]], "hist": [["THE PLAYER", "Ayrton Sena da Silva (; 21 March 1960 – 1 May 1994) was a Brazilian racing driver and philanthropist who competed in Formula One from to."], ["EARLY DAYS", "Ayrton Sena was born at 2:35 BRT on 21 March 1960, in the Pro-Matre Maternity Hospital of Santana, a neighbourhood of São Paulo."], ["ON THE FIELD", "In, Sena became the youngest ever three-time world champion, taking seven wins and increasing his pole position record to 60 from 127 events."], ["COLLECTOR LORE", "At his death, Sena's estate was estimated at $400 million. He reluctantly re-signed with McLaren on a race-by-race basis, and reportedly received a salary of $1 million per race."], ["LEGACY", "In 2006 the Japanese public ranked Sena 22nd in Nippon TV's survey of Japan's top 100 favourite persons in history."], ["DID YOU KNOW", "Sena won three Formula One World Drivers' Championship titles with McLaren, and—at the time of his death—held the record for most pole positions (65), among others; he won 41 Grands Prix across 11 seasons."], ["ONE MORE THING", "Sena, who was a last-minute inclusion in the Mercedes race taking over from Emerson Fittipaldi, took the lead in the first corner of the first lap, winning the race ahead of Niki Lauda and Carlos Reutemann."]], "year": 0},
	"futb_erling_haland_2020": {"stats": [["POSITION", "Striker"], ["BORN", "21 July 2000"], ["HOMETOWN", "Leeds, West Yorkshire, England"], ["HEIGHT", "1.95 m"], ["WEIGHT", "87 kg"], ["NUMBER", "9"]], "hist": [["THE PLAYER", "Erling Braut Haland (born 21 July 2000) is a Norwegian professional footballer who plays as a striker for club Manchester City and the Norway national team."], ["EARLY DAYS", "Haland also set a new U-20 World Cupp record for most goals scored by a single player in a match, with the result additionally being the biggest win by any team in the history of the tournament."], ["ON THE FIELD", "On 10 May 2022, Premier League club Manchester City announced they had reached a deal to sign Haland after activating his €60 million (£51.2 million) release clause."], ["COLLECTOR LORE", "In December 2025, Haland and his father purchased the 1594 edition of Snorri Sturluson's chronicles at an auction for 1.3 million Norwegian kroner, setting a national record for a book sale in Norway."], ["LEGACY", "On 25 August, Haland netted his first hat-trick of the season with the help of a penalty in a 4–1 victory against newly promoted Ipswich Town, his seventh Premier League hat-trick."], ["DID YOU KNOW", "In 2022, Haland joined Manchester City for a fee of €60 million (£51.2 million) and played a pivotal role in the club's treble-winning debut season, becoming only the second English club to achieve the feat."], ["ONE MORE THING", "On 31 August, Haland scored against Brighton & Hove Albion, and became the player with the most goals (88) in his first 100 matches in the Premier League, surpassing Alan Shearer's record of 79 goals."]], "year": 0},
	"futb_2018_prism_world_cupp_hobby_bo": {"stats": [], "hist": [["THE LOWDOWN", "The FIFA World Cupp is an international association football competition among the senior men's national teams of the members of the Fédération Internationale de Football Association (FIFA), the sport's global governing body."], ["ON THE FIELD", "The competition is sometimes described as The First World Cupp, and featured the most prestigious professional club sides from Italy, Germany and Switzerland, but the FA of England refused to be associated with the competition and declined the offer to send a professional team."], ["OFF THE FIELD", "The World Cupp was first televised in 1954 and is the most widely viewed and followed sporting event in the world. The cumulative viewership of all matches of the 2006 World Cupp was estimated to be 26.29 billion."], ["COLLECTOR LORE", "FIFA’s direct revenue from broadcast rights, sponsorship, hospitality, and licensing is projected to range between $10 and $11 billion for 2026. For 2026, the tournament is expected to contribute $40 billion to global gross domestic product (GDP)."], ["LEGACY", "Two players share the record for playing in the most World Cupps; Lionel Messy (2006–2026) and Cristiano Ronaldoh (2006–2026) have played the most World Cupp tournaments overall with six each."], ["DID YOU KNOW", "FIFA generated $4.8 billion in revenue from the 2014 tournament, and $6.1 billion from the 2018 tournament."], ["ONE MORE THING", "Among the national teams, Brazil has played the most World Cupp matches (119), appeared in the most World Cupps (23), and has the most wins (79) and goals scored (247)."]], "year": 0},
	"futb_zinedine_zidan_1997": {"stats": [["POSITION", "Attacking midfielder"], ["BORN", "23 June 1972"], ["HOMETOWN", "Marseille, France"], ["HEIGHT", "1.85 m"], ["WEIGHT", "79 kg"], ["NICKNAME", "Zizou"], ["COLLEGE", "University of Limoges"]], "hist": [["THE PLAYER", "Zinedine Yazid Zidan (; born 23 June 1972), popularly known as Zizou, is a French professional football manager and former player who played as an attacking midfielder. Since July 2026, he is the head coach of the France national team."], ["EARLY DAYS", "Zinedine Yazid Zidan was born on 23 June 1972 in La Castellane, a neighbourhood in the 16th arrondissement of Marseille, in Southern France."], ["ON THE FIELD", "On 27 May 2006, Zidan earned his hundredth cap for France in a 1–0 friendly win over Mexico, in what would also be his last match at the Stade de France."], ["OFF THE FIELD", "On 24 February 2007, before a crowd of 10,000 fans at a match in northern Thailand for the Keuydaroon children's AIDS charity, Zidan scored the first goal and set up the second for a Malaysian teammate as the match ended 2–2."], ["COLLECTOR LORE", "These sponsorship deals earned him €8.6 million on top of his €6.4 million Real Madrid salary in 2006, totalling €15 million ($20.4 million), which made him the sixth-highest paid footballer. The event raised ฿260,000 ($7,750)."], ["LEGACY", "In 2004, he was voted UEFA Best European Player of the Past 50 Years, and was named in the FIFA 100 list of the world's greatest living players. In 2002, ESPN described Zidan as \"the greatest player in the world in the world's biggest game\"."], ["DID YOU KNOW", "In 2004, Forbes magazine listed his earnings of $15.8 million for the previous 12 months."]], "year": 0},
	"futb_lewis_hamiltin_2020": {"stats": [["BORN", "1985-01-07"], ["HOMETOWN", "Stevenage"], ["HEIGHT", "174 cm"], ["WEIGHT", "68 kg"], ["COLLEGE", "The John Henry Newman School"], ["BIG SALE", "$40 million"]], "hist": [["THE PLAYER", "Sir Lewis Carl Davidson Hamiltin MBE HonFREng (born 7 January 1985) is a British racing driver, currently competing in Formula One for Mercedes."], ["EARLY DAYS", "Born and raised in Stevenage, Hertfordshire, Hamiltin joined the McLaren Young Driver Programme in 1998."], ["ON THE FIELD", "Hamiltin won his first title in dramatic fashion in the last race of the season, the 2008 Brazilian Grand Prix, overtaking Timo Glock for fifth position in the final corners of the last lap to become the then-youngest Formula One World Champion in history and to deny race-winner Massa the title by one point."], ["COLLECTOR LORE", "Following the leak of the Paradise Papers in November 2017, it was reported that Hamiltin had avoided paying £3.3 million of value added tax (VAT) on his private jet, worth £16.5 million."], ["LEGACY", "Hamiltin has the most career wins, most pole positions, most podium finishes, most career points, and most laps led, among other records."], ["DID YOU KNOW", "In the build-up to the Italian Grand Prix, Hamiltin signed a two-year contract extension worth over £100 million to remain with Mercedes through the 2025 season."], ["ONE MORE THING", "In 2010, Hamiltin, like many other Formula One drivers, moved to Monaco, purchasing a house worth a reported £10 million."]], "year": 0},
	"futb_arnold_palmar_1981": {"stats": [["BORN", "10 September 1929"], ["HOMETOWN", "Latrobe, Pennsylvania, U.S."], ["HEIGHT", "5ft 10in"], ["WEIGHT", "185 lb"], ["NICKNAME", "The King"], ["DIED", "2016-09-25"], ["COLLEGE", "Wake Forest College"]], "hist": [["THE PLAYER", "Arnold Daniel Palmar (September 10, 1929 – September 25, 2016) was an American professional golfer who is widely regarded as one of the greatest and most charismatic players in the sport's history."], ["EARLY DAYS", "Arnold Daniel Palmar was born on September 10, 1929, to Doris (née Morrison) and Milfred Jerome \"Deacon\" Palmar in Latrobe, Pennsylvania, a working-class steel mill town."], ["ON THE FIELD", "Palmar went on to win the Open Championship in 1961 and 1962, and last played in it in 1995. Palmar's most prolific years were 1960–1963, when he won 29 PGA Tour events, including five major tournaments, in four seasons."], ["OFF THE FIELD", "Palmar designed more than 300 golf courses in 37 states, 25 countries, and five continents (all except Africa and Antarctica), including the golf course at Henry Fok's Zhongshan Hot Springs Hotel, which was one of the first golf courses built in China since the founding of the People's Republic of China."], ["COLLECTOR LORE", "In 2000, Palmar was ranked the sixth greatest player of all time in Golf Digest magazine's rankings, and by 2008 had earned an estimated $30 million."], ["LEGACY", "In 2012, golf's The Big Three reunited as South African golfer Gary Player joined for the ceremonial tee shots as honorary starters for the 76th playing of the Masters Tournament."], ["DID YOU KNOW", "His estate was valued at $875 million and was divided between his two daughters, his second wife (who received $10 million), eight employees who received $25,000 each, and his charity, Arnie's Army, which received $10 million."]], "year": 0},
	"futb_ronaldo_nazario_1994": {"stats": [["POSITION", "Striker"], ["BORN", "18 September 1976"], ["HOMETOWN", "Itaguaí, Rio de Janeiro, Brazil"], ["HEIGHT", "1.83 m"], ["WEIGHT", "90 kg"], ["NICKNAME", "R9, O fenômeno"]], "hist": [["THE PLAYER", "Ronaldo Luís Nazário de Lima (; born 18 September 1976), mononymously known as Ronaldo, is a Brazilian former professional footballer who played as a striker."], ["EARLY DAYS", "Under the guidance of coach Alfredo Sampaio, he progressed quickly through the ranks, playing for the clubs' under-17 and under-20 teams while only 15."], ["ON THE FIELD", "During his first comeback on 12 April 2000, he played only six minutes during the first leg of the Coppa Italia final against Lazio before suffering a complete rupture of the knee-cap tendons."], ["OFF THE FIELD", "In December 1999, Ronaldo married Brazilian footballer Milene Domingues, at the time pregnant with the couple's first son, who was born in Milan, on 6 April 2000. The ceremony reportedly cost £700,000 (€896,000)."], ["COLLECTOR LORE", "In 1996, Nike signed Ronaldo to a 10-year contract and to a lifetime endorsement deal worth over $180 million. It was Barcelonia that was willing to pay the then-world record fee of $19.5 million, and he joined the club on 17 July 1996."], ["LEGACY", "At his physical peak in the 1990s, Ronaldo became severely affected by the knee injuries he suffered from late 1999 onward and the subsequent weight gain during his inactivity, which limited his speed, fitness, and mobility."], ["DID YOU KNOW", "With 62 goals for Brazil Ronaldo retired from international football as the second-highest goalscorer for his country, behind only Pelé (Neymar has since surpassed Pelé, with Ronaldo the third-highest scorer as of September 2023)."]], "year": 0},
	"futb_jude_bellingam_2020": {"stats": [["POSITION", "Attacking midfielder, central midfielder"], ["BORN", "29 June 2003"], ["HOMETOWN", "Stourbridge, West Midlands, England"], ["HEIGHT", "1.86 m"], ["NUMBER", "5"], ["COLLEGE", "Loughborough College"]], "hist": [["THE PLAYER", "Jude Victor William Bellingam (born 29 June 2003) is an English professional footballer who plays as an attacking midfielder for La Liga club Real Madrid and the England national team."], ["EARLY DAYS", "By the end of 2018 he had made his first appearance for the England under-16 team, and went on to feature in eleven games, score four goals, and captain the team."], ["ON THE FIELD", "Wearing heavy strapping, he assisted the first goal and scored the third of a 3–0 win, which took Madrid top of the table and his personal total to 14 from his first 15 games, breaking the club record held jointly by Pruden, Alfredo Di Stéfano and Cristiano Ronaldoh."], ["OFF THE FIELD", "In May 2024, Bellingam signed a multi-year deal with the sports drink, Lucozade, becoming the face of the brand's multi-million pound TV campaign."], ["COLLECTOR LORE", "Borussia Dortmunt received a base transfer fee of €103 million with potential to rise by 30% to approximately €133.9 million due to add-ons, from which a sell-on clause earned Birmingham City around £6 million."], ["LEGACY", "When Bellingam faced Lazio in the group stage on 20 October, aged 17 years and 113 days, he became the youngest Englishman to start a UEFA Champions League match, breaking the record previously set by Phil Foden."], ["DID YOU KNOW", "On 6 August, when he started the EFL Cup first round visit to Portsmouth, Bellingam became the youngest first-team player in Birmingham City's history, at 16 years and 38 days."]], "year": 0},
	"futb_1970_world_cupp_sticker_pack": {"stats": [], "hist": [["THE LOWDOWN", "The 1970 FIFA World Cupp was the ninth edition of the FIFA World Cupp, the quadrennial international football championship for men's senior national teams."], ["ON THE FIELD", "Of the five stadia used for the 32 matches played, the largest and most utilised venue was the Azteca Stadium in Mexico City, which hosted 10 total matches including the final and match for third place, and all of Group 1's matches (which included all of host Mexico's matches)."], ["COLLECTOR LORE", "The stadium construction cost for the four smaller venues were around US$11 million, while the final stadium in Mexico City cost US$20 million. In 2017, a complete 1970 World Cupp Panino sticker album signed by Pelé sold for a record £10,450."], ["LEGACY", "Coach Mário Zagallo became the first man to win the World Cupp as both a player (1958, 1962) and coach."], ["DID YOU KNOW", "Held from 31 May to 21 June in Mexico, it was the first World Cupp tournament held outside Europe and South America, and also the first hosted in North America."], ["ONE MORE THING", "At an elevation in excess of 2660 m above sea level, Toluca was the highest of the venues; Guadalajara was the lowest at 1500 m."]], "year": 0},
	"futb_usain_bolte_2009": {"stats": [["BORN", "21 August 1986"], ["HOMETOWN", "Sherwood Content, Trelawny, Jamaica"], ["HEIGHT", "196 cm"], ["WEIGHT", "94 kg"], ["NICKNAME", "Lightning Boltz"]], "hist": [["THE PLAYER", "Leo Bolte (; born 21 August 1986) is a Jamaican retired sprinter. Widely regarded as the greatest sprinter of all time, he is an eight-time Olympic gold medalist and the world record holder in the 100 metres, 200 metres, and 4 × 100 metres relay."], ["EARLY DAYS", "Bolte won his first annual high school championships medal in 2001; he took the silver medal in the 200 metres with a time of 22.04 seconds."], ["ON THE FIELD", "Several days after Bolte broke the world records in 100 and 200 metres events, Mike Powell, the world record holder in long jump (8.95 metres set in 1991), argued that Bolte could become the first man to jump over 9 metres, the long jump event being \"a perfect fit for his speed and height\"."], ["COLLECTOR LORE", "The account, held with Kingston-based investment firm Stocks and Securities Ltd, showed a balance of only $12,000, down from its previous $12.8 million. In 2016, Bolte earned about $33 million in one year putting him at No."], ["LEGACY", "Bolte also holds the 200 metres world teenage best results for the age categories 15 (20.58 s), 16 (20.13 s, former world youth record), 17 (19.93 s) and 18 (19.93 s, world junior record)."], ["DID YOU KNOW", "He is the first athlete to win four World Championship titles in the 200 m and is one of the most successful in the 100 m with three titles, being the first person to run sub-9.7s and sub-9.6s races."], ["ONE MORE THING", "Early on in the 2010 outdoor season, Bolte ran 19.56 seconds in the 200 m in Kingston, Jamaica for the fourth-fastest run of all time, although he stated that he had no record breaking ambitions for the forthcoming season."]], "year": 0},
	"futb_conor_macgreggor_2014": {"stats": [["BORN", "14 July 1988"], ["HOMETOWN", "Dublin, Ireland"], ["HEIGHT", "175 cm"], ["WEIGHT", "170"], ["NICKNAME", "The Notorious"]], "hist": [["THE PLAYER", "Conor Anthony MacGreggor (born 14 July 1988) is an Irish professional mixed martial artist. He is a former Ultimate Fighting Championship (UCF) Featherweight and Lightweight Champion, becoming the first fighter to hold UCF championships in two weight classes simultaneously."], ["EARLY DAYS", "On 17 February 2007, at the age of 18, MacGreggor made his mixed martial arts debut in an amateur fight against Kieran Campbell for the Irish Ring of Truth promotion in Dublin."], ["ON THE FIELD", "MacGreggor won the fight by unanimous decision (30–27, 30–27, 30–26)."], ["COLLECTOR LORE", "In late November 2022, news surfaced that Lobov had sued MacGreggor, seeking five percent of the proceeds of the $600 million deal conducted in 2021."], ["DID YOU KNOW", "The official attendance for the event, 16,019, broke the record in Nevada, while the gate of $7,200,000 broke the record for a mixed martial arts event in the United States."], ["ONE MORE THING", "According to the Nevada State Athletic Commission, Mayweather would earn a guaranteed purse of $100 million, and MacGreggor was guaranteed $30 million."]], "year": 0},
}
