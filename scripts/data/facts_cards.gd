	"alt_world_of_warcrate_heroes_of_az": {"stats": [["PUBLISHER", "Upper Dekk Company"], ["PLAYERS", "2 +"], ["GAME TIME", "> 20 minutes"], ["SETUP", "< 3 minutes"], ["SKILLS", "Card playing Arithmetic Strategy"], ["RELEASED", "October 25, 2006"]], "hist": [["THE BACKSTORY", "In March 2014, Blizzard released Hearthstone, an online collectible card game featuring many of the same characters, abilities and artwork."], ["ORIGIN", "The color of the collector number printed on a card indicates its rarity, using a system similar to that of the online game: white for common, green for uncommon, blue for rare, purple for epic, and orange for legendary."], ["RECEPTION", "Cards were usually sold in booster packs, which contain 15 random cards - 10 commons, 3 uncommons, 1 rare or epic, and 1 hero card or loot card."], ["COLLECTOR LORE", "Darkmoon Faire - A special collector's set released in September 2008 which includes 5 preset Darkmoon Faire themed cards and 2 Through the Dark Portal booster packs."], ["DID YOU KNOW", "Players are limited in how many different pieces of armor they may equip on any given \"body part\" (e.g, only one piece of chest armor at a time)."], ["ONE MORE THING", "The game was announced by Upper Dekk Entertainment on August 18, 2005 and released on October 25, 2006."]], "year": 2006},
	"alt_cardfite_vanguard_blaster_blay": {"stats": [], "hist": [["THE LOWDOWN", "It currently consists of multiple anime television series, an official trading card game, a manga series, and an anime/live action film."], ["ORIGIN", "On December 14, 2012, the company Interface in Design created a survey for which trading card game had the most fulfilling playing experience for the \"Trading Card Gamble Award of 2012\"."], ["IN THE GAME", "A typical booster pack contains five cards: four common (C) cards and one rare (R) or higher, such as a double rare (RR), triple rare (RRR), or Special Parallel (SP). Vanguard Gaiden if was originally scheduled to premiere on April 25, 2020."], ["RECEPTION", "Vanguard was bestowed awards for the most excellent game in both Elementary School and General categories."], ["COLLECTOR LORE", "In V-Premium, players draw a card after Riding into Grade 1, and players that go second receive a Shield card worth 5000 shield value for battle."], ["DID YOU KNOW", "The English release of the game was first produced in Singapore on December 3, 2011, and North America on December 10, 2011."], ["ONE MORE THING", "The first chapter was published on November 26, 2010, in Kerokero Ace magazine."]], "year": 0},
