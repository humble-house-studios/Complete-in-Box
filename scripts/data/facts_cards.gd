	"magi_badlandz": {"stats": [["RELEASED", "December 1, 1993"]], "hist": [["THE BACKSTORY", "The base sets were considered descendants of the original Limited Edition, and shaped the default setting and feel of Magic."], ["ORIGIN", "It is estimated that about 500 million cards of the set were produced, which fully eliminated the distribution problems of earlier sets."], ["RECEPTION", "Unlimited was sold in starter packs of 60 cards and booster packs of 15 cards."], ["COLLECTOR LORE", "Similar to Eight Edition, the Ninth Edition Core Game contained 9 \"starter cards\", labeled with the collector numbers S1 through S10 (there is no card labeled S6, however), which were not available in booster packs."], ["DID YOU KNOW", "The print run was recalled and destroyed; however, about 40 booster boxes that were shipped to England and Tennessee survived."], ["ONE MORE THING", "The Revised version is now the most common due to the limited print run of the original, intended versions."]], "year": 1993},
	"magi_bayoo": {"stats": [["RELEASED", "December 1, 1993"]], "hist": [["THE BACKSTORY", "The collectible card game Magick: The Gatherening published nine base sets from 1993–2007, also referred to as core sets."], ["ORIGIN", "Coal bordered, limited editions were produced in French, German, and Italian."], ["RECEPTION", "Revised was the first base edition of the game to be sold in multiple languages."], ["COLLECTOR LORE", "A new misprint occurred with the green card Hurricane; the so-called \"blue Hurricane\" is one of the rarest and most sought-after cards in the entirety of Magic because of its misprint with a blue border."], ["DID YOU KNOW", "An advertisement in the first issue of The Duelist stated that the set would have gray borders and be released with a \"constantly changing card mix\", the first of which would be 30 cards from Arabian Knights."], ["ONE MORE THING", "The print run was recalled and destroyed; however, about 40 booster boxes that were shipped to England and Tennessee survived."]], "year": 1993},
	"magi_taigah": {"stats": [["RELEASED", "December 1, 1993"]], "hist": [["THE BACKSTORY", "All cards were given a white border to mark them as reprints, with a few exceptions (Tenth Edition, foil cards in Seventh - Ninth Editions)."], ["ORIGIN", "Coal bordered, limited editions were produced in French, German, and Italian."], ["RECEPTION", "Unlimited was sold in starter packs of 60 cards and booster packs of 15 cards."], ["COLLECTOR LORE", "A new misprint occurred with the green card Hurricane; the so-called \"blue Hurricane\" is one of the rarest and most sought-after cards in the entirety of Magic because of its misprint with a blue border."], ["DID YOU KNOW", "Serendib Efreet - This blue card was printed with the wrong art and a green card frame, making it the most commonly seen misprint."], ["ONE MORE THING", "It was released on December 1, 1993; this time the run was 40 million cards."]], "year": 1993},
	"magi_tundrah": {"stats": [["RELEASED", "December 1, 1993"]], "hist": [["THE BACKSTORY", "Early in the history of Magic, the sets sold out nearly instantaneously, and supplying the game's growing fan base proved tricky."], ["ORIGIN", "Printing of Revised began in early April 1994 and continued until April 1995, when Fourth Edition was announced."], ["RECEPTION", "Revised was the first base edition of the game to be sold in multiple languages."], ["COLLECTOR LORE", "Similar to Eight Edition, the Ninth Edition Core Game contained 9 \"starter cards\", labeled with the collector numbers S1 through S10 (there is no card labeled S6, however), which were not available in booster packs."], ["DID YOU KNOW", "The print run was recalled and destroyed; however, about 40 booster boxes that were shipped to England and Tennessee survived."], ["ONE MORE THING", "The Revised version is now the most common due to the limited print run of the original, intended versions."]], "year": 1993},
