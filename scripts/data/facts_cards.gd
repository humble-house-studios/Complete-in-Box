	"crit_snorelax": {"stats": [["FIRST GAME", "Pocket Critters Red and Blue (1996)"], ["FIRST SEEN", "first generation of Pocket Critters"], ["SPECIES", "Pocket Critters"], ["TYPE", "Normal"]], "hist": [["THE LOWDOWN", "Snorelax, known in Japan as Kabigon, is a Pocket Critters species in Funtendo and Game Freek's Pocket Critters franchise."], ["ORIGIN", "Designed by Ken Sugimori for the first generation of Pocket Critters games, the species was inspired in behavior and appearance by veteran Pocket Critters game designer Kōji Nishino."], ["IN THE GAME", "Snorelax's most notable role in the Pocket Critters games has been that of an inadvertent roadblock."], ["RECEPTION", "Snorelax was a rare Pocket Critters in Pocket Critters Go, with sightings of the Pocket Critters in-game causing a stampede in Taiwan and New York City."]], "year": 0},
	"crit_scythor": {"stats": [["TYPE", "Collectible"], ["PLAYERS", "2"], ["GAME TIME", "2–120 minutes"], ["RELEASED", "1996-10-20"], ["CARDS", "60"], ["AGES", "6+"], ["DEVELOPER", "Creatures Inc"]], "hist": [["THE BACKSTORY", "The game was originally released in Japan by Media Factory in 1996 as Pocket Monsters, which was based on the Pocket Critters Red, Blue, and Yellow PocketBoy video games."], ["ORIGIN", "In the US, it was first published by Lizards of the Coast, towards the end of 1998 to capitalize on the US popularity of Pocket Critters."], ["IN THE GAME", "The first Pocket Critters TCG tournament began on June 14–15, 1997, at the Makuhari Messe Event Hall. The player going first cannot attack or play a Supporter card (powerful Trainer effects card) on their first turn."], ["RECEPTION", "In 2017, it had an 82% share of Europe's strategic card game market. As of March 2023, the game has sold over 52.9 billion cards worldwide."], ["COLLECTOR LORE", "Shopping platform ZenPlus, a subsidiary of shopping service ZenMarket (now part of ZenGroup), sold two of the cards in 2020, for the Japanese Yen equivalent of US$233,000 and US$208,496 respectively."], ["DID YOU KNOW", "Created as a prize for the 1997-1998 Pocket Critters design contests organized by the Japanese manga-magazine KoroKoro Comic and with only 41 copies printed, it is the only Pocket Critters card to say \"Illustrator\" instead of \"Trainer\" like other Trainer cards."], ["ONE MORE THING", "Notable references include Austin Brewen who won the first junior tournament, Brenden Zhang who won the first Senior Tournament, and Arturo Heras who won the first Master Tournament."]], "year": 1996},
	"crit_vapoureon": {"stats": [["TYPE", "Collectible"], ["PLAYERS", "2"], ["GAME TIME", "2–120 minutes"], ["RELEASED", "1996-10-20"], ["CARDS", "60"], ["AGES", "6+"], ["DEVELOPER", "Creatures Inc"]], "hist": [["THE BACKSTORY", "Energy cards can be attached to Pocket Critters cards to power up attacks, and trainer cards can be used for different effects on the game."], ["ORIGIN", "In the US, it was first published by Lizards of the Coast, towards the end of 1998 to capitalize on the US popularity of Pocket Critters."], ["IN THE GAME", "The player going first cannot attack or play a Supporter card (powerful Trainer effects card) on their first turn. The first Pocket Critters TCG tournament began on June 14–15, 1997, at the Makuhari Messe Event Hall."], ["RECEPTION", "In 2017, it had an 82% share of Europe's strategic card game market. As of March 2023, the game has sold over 52.9 billion cards worldwide."], ["COLLECTOR LORE", "Rarities can be also account for old card collectibles such as \"1st-edition Base Set\" and \"First Generation Sets\", and such collectibles are some of the rarest and most expensive Pocket Critters cards with some valuing at thousands and millions of dollars."], ["DID YOU KNOW", "Shopping platform ZenPlus, a subsidiary of shopping service ZenMarket (now part of ZenGroup), sold two of the cards in 2020, for the Japanese Yen equivalent of US$233,000 and US$208,496 respectively."], ["ONE MORE THING", "Hasbroo bought Lizards of the Coast in September 1999 for $325 million dollars based on the strength of the Pocket Critters license."]], "year": 1996},
	"crit_jolteeon": {"stats": [["TYPE", "Collectible"], ["PLAYERS", "2"], ["GAME TIME", "2–120 minutes"], ["RELEASED", "1996-10-20"], ["CARDS", "60"], ["AGES", "6+"], ["DEVELOPER", "Creatures Inc"]], "hist": [["THE BACKSTORY", "Standard gameplay cards include Pocket Critters cards, energy cards, trainer cards, and stadium cards, a variant of trainer cards."], ["ORIGIN", "Lizards sued Funtendo on October 1, 2003, and accused the company of poaching employees and violating its patent; the lawsuit was settled out of court."], ["IN THE GAME", "The top three player of the tournament were awarded the No.1, 2, and 3 trainer trophy cards; this practice continue through subsequent Pocket Critters TCG tournaments and organized plays."], ["RECEPTION", "In 2016, it was the year's top-selling toy in the strategic card game subclass. As of March 2023, the game has sold over 52.9 billion cards worldwide."], ["COLLECTOR LORE", "Shopping platform ZenPlus, a subsidiary of shopping service ZenMarket (now part of ZenGroup), sold two of the cards in 2020, for the Japanese Yen equivalent of US$233,000 and US$208,496 respectively."], ["DID YOU KNOW", "Notable references include Austin Brewen who won the first junior tournament, Brenden Zhang who won the first Senior Tournament, and Arturo Heras who won the first Master Tournament."], ["ONE MORE THING", "Rarities can be also account for old card collectibles such as \"1st-edition Base Set\" and \"First Generation Sets\", and such collectibles are some of the rarest and most expensive Pocket Critters cards with some valuing at thousands and millions of dollars."]], "year": 1996},
