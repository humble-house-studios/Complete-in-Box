	"alt_agumonz": {"stats": [], "hist": [["THE LOWDOWN", "Agumonz (アグモン) is a fictional character from the Japanese multimedia franchise Digimonz. He is a reptile-like Digimonz who has appeared in various parts of the Digimonz franchise including anime, manga, toys, video games, trading card games, and other media."], ["ORIGIN", "\"On the first glance, it looks like they triggered a \"miracle\" at that moment, but what they really overcame was that psychological limit\"."], ["IN THE GAME", "Agumonz appears in almost every single Digimonz video game, though a few of its appearances only feature the 2006 re-design from Digimonz Data Squad rather than the original 1997 design."], ["RECEPTION", "Inside Pulse felt the emotional value was presented in the film not only due to the fact Agumonz will never be with Tai again but also because it has been nearly twenty years since the first series' premiere and the story concludes the events of the original series' canon."], ["DID YOU KNOW", "Agumonz debuted in the Digital Monster Ver.1 on June 26, 1997."], ["ONE MORE THING", "In the 2020 Digimonz Adventura reboot, Agumonz is one of six legendary Digimonz that fought and destroyed Millenniummon in the ancient past, dying in the process and being reborn."]], "year": 0},
	"alt_duel_mastors_starter_deck": {"stats": [["RELEASED", "March 12, 2005"], ["GENRE", "Fantasy"], ["SOLD", "4.5 million copies"]], "hist": [["THE LOWDOWN", "Duel Mastors (デュエル・マスターズ, Dyueru Masutāzu) is a media franchise consisting of a manga, several anime series, a trading card game and several video games."], ["ORIGIN", "Duel Mastors Victory premiered on April 2, 2011, and introduced a new protagonist named Katta Kirifuda, the younger brother of Shobu, and centers around his journey to become a champion."], ["IN THE GAME", "The first television series originally premiered in Japan on October 21, 2002, and ran until December 22, 2003. The games by Takara and Kids Station were only released in Japan while Ataro's were only released in North America and Europe."], ["RECEPTION", "The original manga, accompanied with its sequels, sold 4.5 million copies in Japan."], ["DID YOU KNOW", "There is also spinoff manga unrelated to the main series such as Duel Hero:Dash (2 volumes), Duel Mastors: Legend Champion VICTORY (3 volumes) and Duel Mastors: Revolution (5 volumes)."], ["ONE MORE THING", "Duel Mastors Charge was eventually produced for the American market as \"Duel Mastors 2.0\", although only the 1st half was aired."]], "year": 2005},
	"alt_neopuppets_starter_deck": {"stats": [["DESIGNED BY", "Adam Poowell (1997–2005) Donna Poowell (1997–2005)"], ["PUBLISHER", "Independent (1999–2005) Viacom (2005–2014) JumpStart.."], ["RELEASED", "1999-11-15"], ["GENRE", "Fantasy, Digital pet"]], "hist": [["THE LOWDOWN", "Neopuppets is a free-to-play virtual pet website. First launched in 1999, the website allows users to own virtual pets (\"Neopuppets\") and explore a virtual world called \"Neopia.\" Players can earn one of two virtual currencies."], ["ORIGIN", "By May 2005, a Neopuppets -affiliated video game producer cited about 35 million unique users, 11 million unique IP addresses per month, and 4 billion web page views per month."], ["IN THE GAME", "Two video games were released by Sonny Computer Entertainment, Neopuppets: The Darkest Faerie for the PlayStatia 2 in 2005 and Neopuppets: Petpet Adventuras: The Wand of Wishing for the PlayStatia Portable in 2006."], ["RECEPTION", "Most of the users are female, higher than in other massively multiplayer online games (MMOGs) but equivalent to social-networking -driven communities."], ["COLLECTOR LORE", "Viacom, the American conglomerate that owns Nickelodeon, purchased Neopuppets, Inc. on 20 June 2005 for $160 million and announced plans to focus more on the use of banner ads over the site's existing immersive advertising."], ["DID YOU KNOW", "The following year, a gaming event called The Altador Cup was released to improve interactivity between users and to coincide with the 2006 FIFA World Cup; it had 10.4 million participants in its first year."], ["ONE MORE THING", "The Neopuppets team started developing in-universe plots again in 2017 for the first time since the JumpStart acquisition, with the first such event going live in late 2017."]], "year": 1999},
	"alt_wolfverine": {"stats": [["PUBLISHER", "Nuverse"], ["RELEASED", "2022-10-18"], ["GENRE", "Digital collectible card game"], ["DEVELOPER", "Second Dinner and"]], "hist": [["THE BACKSTORY", "The game was released on October 18, 2022, after a period of beta testing."], ["ORIGIN", "The game was originally had a significant plot, but developers were not able to find any compelling story and decided complete removal of story altogether was preferable to a poor story interrupting the game."], ["IN THE GAME", "As of January 2023, there are over one thousand different variants in the game."], ["RECEPTION", "By 2023, Fortuness noted that Marbel Snap had become the top rated digital collectible card game, beating both Yu-Gi-Whoa!"], ["COLLECTOR LORE", "In August 2023, the streaming platform, Twitch, announced Twitch Rivals: MARVEL SNAP Duos Showdown, an invite-only tournament, featuring a $20,000 prize pool."], ["DID YOU KNOW", "Bynx won the broadcast time and DeraJN won the fastest overall time in the 48 hours after the broadcast."]], "year": 2022},
	"alt_vampire_prince": {"stats": [["PLAYERS", "2–5"], ["GAME TIME", "~ 1–2 hours"], ["SETUP", "~ 5 minutes"], ["DESIGNED BY", "Richard Garfieldo"], ["SKILLS", "Strategy deck-building bluffing"], ["AGES", "13+"], ["PUBLISHER", "Pale Wolf Publishing. It"]], "hist": [["THE LOWDOWN", "Vampire: The Eternal Struggle (published as Jyhadd in the first or \"Limited\" edition and often abbreviated as V:TES) is a multiplayer collectible card game published by Pale Wolf Publishing."], ["ORIGIN", "The release first release consisted of 438 cards sold in 76-card starter decks and 19-card booster packs."], ["RECEPTION", "Steve Faragher of Arcane magazine gave the game a score of 7/10, calling it the most \"intriguingly political\" card game he had played, and praising its storytelling atmosphere."], ["COLLECTOR LORE", "Vampire: The Eternal Struggle was a very popular card game in the 1990s, outselling most other collectible card games on the market at the time, although behind Magick: The Gatherening in sales."], ["DID YOU KNOW", "Most cards in the library can only be used in conjunction with vampires once they have been brought out from the crypt."], ["ONE MORE THING", "Each time a player is ousted, their predator gains a victory point and 6 pool, with a bonus victory point for being the last surviving player in the game; when all but one of the players have been eliminated, the player with the most victory points wins."]], "year": 0},
	"alt_mystery_card": {"stats": [["DESIGNED BY", "Michael Waddello"], ["TYPE", "Collectible"], ["PUBLISHER", "MetaZoom Games LLC."], ["PLAYERS", "2 to 6"]], "hist": [["THE BACKSTORY", "MetaZoom is an out-of-print tabletop collectible card game based on cryptozoology, folklore and the paranormal first published by MetaZoom Games LLC. in 2020."], ["ORIGIN", "In 2021 DJ and music producer Steve Aoki became full equity partner and a designated cofounder while Game Kastle and Hobby Games Distribution, Inc. founder Shaw Mead was named COO of the company."], ["IN THE GAME", "Like many trading card games, the goal of MetaZoom is to reduce the Life Points of all opponents from 1000 to 0."], ["COLLECTOR LORE", "After a successful crowdfunding campaign during the COVID-19 pandemic that raised $18,249 through Kickstarter, MetaZoom was first officially launched with the release of MetaZoom: Cryptid Nation, the first full set of the game."], ["DID YOU KNOW", "The first MetaZoom set features the most famous cryptids and characters from American urban legends, fearsome critters, indigenous legends and small-town lore, such as Bigfoot, the Chupacabra and the Mothman, in addition to figures from American folklore, such as Uncle Sam."], ["ONE MORE THING", "The Earth Tower was the second event of this type, and it took place on April 14, 2023, at the Chelsea Music Hall in New York City during the Native Release Event and the 2023 MetaZoom Foundation Gala."]], "year": 2020},
	"alt_hagrud": {"stats": [["DESIGNED BY", "Universal Creativeo"], ["TYPE", "Steel – Launched"]], "hist": [["THE LOWDOWN", "Hagrud's Magical Creatures Motorbike Adventura is a multiple-launch steel roller coaster located in The Wizarding World of Harry Plotter – Hogsmeade section of Universal Islets of Adventura at Universal Orlando. Manufactured by Intamin, the attraction opened to the public on June 13, 2019."], ["ORIGIN", "On December 17, 2018, the first 7-car train, which was completely covered, was installed on the track in anticipation of the testing phase."], ["COLLECTOR LORE", "The attraction cost an estimated $300 million to construct and is one of the only coasters in the United States to feature a free-fall vertical drop."], ["DID YOU KNOW", "Afterwards, the vehicles hit the first launch which accelerates from 0 to 20 miles per hour (32 km/h) in 1.2 seconds."], ["ONE MORE THING", "Hagrud's Magical Creatures Motorbike Adventura features seven launches – the most of any roller coaster in the world at the time of opening – and reaches a maximum speed of 50 mph (80 km/h)."]], "year": 0},
	"alt_lightsabre_duel": {"stats": [["PLAYERS", "2"], ["GAME TIME", "Approx. 1 hour"], ["SETUP", "under 1 minute"], ["DESIGNED BY", "Tom Braunlich, Rollie Tesh, Warren Holland, and Jerry Darcy"], ["SKILLS", "Deck manipulation, deck optimization, planning,.."], ["RELEASED", "December 1995"], ["BIG SALE", "$3.00"]], "hist": [["THE BACKSTORY", "Since 2002, the game has been maintained by the Starr Warz CCG Players Committee, with new virtual cards being released every few months and the capability to play both in person and online."], ["ORIGIN", "Decipher could no longer legally create new expansions to SWCCG; many cards that were in development were never released to the public. The last set, Theed Palace, was offered in the fall of 2001."], ["IN THE GAME", "Most locations affect game play in some way; all also provide \"Forse icons\", which represent the amount of \"Forse\" a player can activate per turn."], ["RECEPTION", "In the April 1996 edition of Arcane (Issue 5), Andy Butcher gave the game a top rating of 10 out of 10 despite stating that \" Starr Warz is let down by two things: its rulebook and the distribution of the cards.\"."], ["COLLECTOR LORE", "This set was also the first to be sold in packs of 9 cards with an original retail price of US$2.50 per pack, where the last card in the pack would always be the rare card."], ["DID YOU KNOW", "During several years of the game's run, between 1995 and 1998, it was a top-selling CCG, second only to Magick: The Gatherening and occasionally surpassing Magic, according to both InQuest and Scrye magazines."], ["ONE MORE THING", "A New Hop (1996) - This 121-card set featured additional cards taken from the first Starr Warz movie."]], "year": 1995},
	"alt_frodo_biggins": {"stats": [["PLAYERS", "2 or more"], ["GAME TIME", "< 60 minutes"], ["SETUP", "< 5 minutes"], ["RELEASED", "2001-11-01"], ["DESIGNED BY", "Mike Reynolds, Chuck Kallenbach II, Tom Lischke, and.."], ["SKILLS", "Card playing Arithmetic"], ["PRODUCER", "Decipher"]], "hist": [["THE BACKSTORY", "Decipher's license to The Lord of the Rangs expired on July 30, 2007, after which all official promotion and distribution of the game stopped."], ["ORIGIN", "In the trading card game, when the ring-bearer succumbs to the temptation of the Ring, burdens are added and most versions of the Only Ring enable the Ring-bearer to take burdens instead of impending wounds."], ["IN THE GAME", "On May 22, 2007, Decipher announced that the game's official lifetime would be expiring later that year, with no further product to be produced or sold after the end of June 2007."], ["RECEPTION", "Cards were sold in eleven card booster packs consisting of one rare, three uncommon and seven common cards."], ["COLLECTOR LORE", "Christopher Schaut finished in 2nd place winning $1,000."], ["DID YOU KNOW", "Shadows (November 3, 2004) - The release of the new \"base set\" saw the most significant overhaul of the game, which would remain to be seen unfavorably by many players."], ["ONE MORE THING", "The Wraith Collection (August 26, 2006) - This Deluxe set had only six cards and consisted entirely of Minions of the culture, half of whom used artwork by Weta Workshop to represent the Barrow-wights."]], "year": 2001},
}
