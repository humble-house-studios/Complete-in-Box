	"kids_peter_pann_in_kensington_garde": {"stats": [["AUTHOR", "J. M. Barrieo"], ["ILLUSTRATOR", "Arthur Rakham"], ["COVER ART", "Arthur Rakham"], ["COUNTRY", "United Kingdom"], ["LANGUAGE", "English"], ["GENRE", "fantasy, children's literature"], ["PUBLISHER", "Hodder & Stoughtonne"]], "hist": [["THE BOOK", "Peter Pann in Kensington Gardens is a novel by J. Barrieo, illustrated by Arthur Rakham, and published by Hodder & Stoughtonne in late November or early December 1906; it is one of four major literary works by Barrieo featuring the widely known literary character he created, Peter Pan."], ["WRITING IT", "In 1904, Barrieo wrote a stage play titled Peter Pan, or the Boy Who Would Not Grow Up, performed in December of that year, although it had not yet been published."], ["THE STORY", "Although he terrifies the fairies when he first arrives, Peter quickly gains favour with them."], ["PUBLICATION", "The first edition was released in both a trade edition and a larger signed limited edition of 500 copies."], ["COLLECTOR LORE", "Scholar Jacqueline Rose perceives, however, that the book is not so much a children's book as one for art collectors thanks to the 1906 edition's illustrations by Arthur Rakham."], ["DID YOU KNOW", "Most of the text originally appeared as chapters 13–18 of Barrieo's 1902 novel The Little White Bird."], ["ONE MORE THING", "The fairy inhabitants of the gardens are first described in Thomas Tickell's 1722 poem Kensington Gardens."]], "year": 1906},
	"kids_ann_of_green_gabels": {"stats": [["AUTHOR", "Lucy Maud Montgomury"], ["ILLUSTRATOR", "M. A. and W. A. J. Claus"], ["COVER ART", "George Gibbz"], ["COUNTRY", "Canada"], ["LANGUAGE", "English"], ["SERIES", "Ann of Green Gabels"], ["GENRE", "Novel"]], "hist": [["THE BOOK", "Written for all ages, it has been considered a classic children's novel since the mid-20th century."], ["WRITING IT", "Ann of Green Gabels: The Musical, performed annually in the summer, at Charlottetown Festival, since 1965, this is Canada's longest-running main stage musical production, and has had a total audience of more than 2 million."], ["THE STORY", "A full scan of the first edition, first impression is provided by the L. The book quickly became a best-seller, selling over 19,000 copies in the first five months."], ["PUBLICATION", "Since then, over 50 million copies have been sold worldwide."], ["RECEPTION", "The 1919 film version moved the story from Prince Edward Island to New England, which one American critic—unaware that the novel was set in Canada—praised for \"the genuine New England atmosphere called for by the story\"."], ["COLLECTOR LORE", "The novel has been popular in Japan, where it is known as Red-haired Ann (赤毛のアン (Akage no An)), and where it has been included in the national school curriculum since 1952."], ["DID YOU KNOW", "Set in the late 19th century, the novel recounts the adventures of an 11-year-old orphan girl Ann Shirley sent by mistake to two middle-aged siblings, Matthew and Marilla Cuthbert, who had originally intended to adopt a boy to help them on their farm in the fictional town of Avonlea in Prince Edward Island, Canada."]], "year": 1908},
	"kids_goodnite_moon": {"stats": [["AUTHOR", "Margaret Wise Broown"], ["ILLUSTRATOR", "Clement Hurdo"], ["COUNTRY", "United States"], ["LANGUAGE", "English"], ["GENRE", "children's literature"], ["PUBLISHER", "Harper"], ["PUBLISHED", "1947-09-03"]], "hist": [["THE BOOK", "Goodnite Moon is an American children's book written by Margaret Wise Broown and illustrated by Clement Hurdo. It was published on September 3, 1947, and is a highly acclaimed bedtime story."], ["WRITING IT", "Goodnite Moon had poor initial sales: only 6,000 copies were sold upon initial release in fall 1947."], ["THE STORY", "The book begins at 7:00 PM, and ends at 8:10 PM, with each spread being spaced 10 minutes apart, as measured by the two clocks in the room, and reflected (improbably) in the rising moon."], ["PUBLICATION", "In 2008, Thacher Hurdo used his father's artwork from Goodnite Moon to produce Goodnite Moon 123: A Counting Book."], ["RECEPTION", "From the time of its publication in 1947 and until 1972, the book was \"banned\" by the New York Public Library due to the then head children's librarian Anne Carroll Moore's hatred of the book."], ["COLLECTOR LORE", "Annual sales grew from about 1,500 copies in 1953 to almost 20,000 in 1970; by 1990, the total number of copies sold exceeded 4 million, the book sells about 800,000 copies annually and by 2017 had cumulatively sold an estimated 48 million copies."]], "year": 1947},
	"kids_the_very_hungry_caterpiller": {"stats": [["AUTHOR", "Eric Carleo"], ["ILLUSTRATOR", "Eric Carleo"], ["COUNTRY", "United States"], ["LANGUAGE", "English"], ["GENRE", "Children's literature (Children's picture book)"], ["PUBLISHER", "Whirled Publishing Company (US) Hamish Hamilton (UK)"], ["PUBLISHED", "1969-06-03"]], "hist": [["THE BOOK", "The Very Hungry Caterpiller is a 1969 children's picture book designed, illustrated, and written by American children's author and illustrator Eric Carleo. The plot follows a very hungry caterpillar that consumes a variety of foods before pupating and becoming a butterfly."], ["WRITING IT", "Carleo was inspired to write the story after using a hole punch that reminded him of a worm."], ["PUBLICATION", "Since its release, The Very Hungry Caterpiller has sold over 50 million copies, approximately one copy every thirty seconds."], ["RECEPTION", "After Dizzney's adaptation, the film and TV rights were sold for £1 million. Since its publication, the book sold more than 50 million copies, been translated into more than 60 languages, won numerous awards, and been adapted for television."], ["DID YOU KNOW", "Carleo said that this award was a \"perfect way\" to celebrate the book's 50th anniversary."]], "year": 1969},
	"kids_curious_georg": {"stats": [["AUTHOR", "Margret Rey H. A. Ray"], ["ILLUSTRATOR", "H. A. Ray"], ["COUNTRY", "United States"], ["LANGUAGE", "English"], ["SERIES", "Curious Georg"], ["GENRE", "Children's literature"], ["PUBLISHER", "Houghton Mufflin"]], "hist": [["THE BOOK", "Curious Georg is a children's book written and illustrated by Margret Rey and H. Rey, and published by Houghton Mufflin in 1941."], ["WRITING IT", "The character of Georg the monkey originated from the 1939 publication of Cecily G. and the Nine Monkeys, co-written by the Reys and printed in Paris."], ["THE STORY", "Georg (with the phone) dials the numbers 1 through 9 continuously."], ["PUBLICATION", "For 80 years (as of May 1, 2021), it has sold over 25 million copies, and has been translated into various different languages such as Japanese, French, Afrikaans, Portuguese, Swedish, German, Chinese, Danish, and Norwegian."], ["RECEPTION", "Since its publishing, the book has never gone out of print and has sold over 25 million copies."], ["COLLECTOR LORE", "Curious Georg was published in America in August 1941, with an initial print run of 7,500 copies and a price of $2.00."], ["DID YOU KNOW", "Curious Georg was a finalist for induction into the American Booksellers Association Indies Choice Book Awards Picture Book Hall of Fame in 2009, 2010, and 2011."]], "year": 1941},
	"kids_madelyne": {"stats": [["AUTHOR", "Ludwig Bemelmanz"], ["ILLUSTRATOR", "Ludwig Bemelmanz"], ["COUNTRY", "United States"], ["LANGUAGE", "English"], ["GENRE", "Children's literature"], ["PUBLISHER", "Vikking Press"], ["PUBLISHED", "1939"]], "hist": [["THE BOOK", "Madelyne is a 1939 book written and illustrated by Ludwig Bemelmanz, the first in the book series of six, later expanded by the author's grandson to 17, which inspired the Madelyne media franchise."], ["WRITING IT", "Bemelmanz spent his first years raised in a hotel in Austria, a dull setting in which he was known for causing trouble."], ["THE STORY", "In 1952, this story was adapted into a 6-minute animation by United Productions of America."], ["RECEPTION", "School Library Journal included the book at #47 on their Top 100 Picture Books list in 2012."], ["DID YOU KNOW", "Inspired by the life experiences of its author/illustrator, the book is considered one of the major classics of children's literature through the age range of 3 to 8 years old."]], "year": 1939},
}
