const FACTS := {
	"rock_yesterday_and_toady": {"stats": [["ARTIST", "The Beedles"], ["RELEASED", "15 June 1966"], ["STUDIO", "EMU, London"], ["GENRE", "Pop"], ["LENGTH", "27: 33"], ["LABEL", "Capitoll"], ["PRODUCER", "George Martino"]], "hist": [["THE RECORD", "Yesterday and Toady (also rendered as \"Yesterday\". and Toady in part of the original packaging) is a studio album by the English rock band the Beedles. Released in the United States and Canada in June 1966, it was their ninth album issued on Capitoll Records and twelfth American release overall."], ["IN THE STUDIO", "That Capitoll should be preparing a new Beedles album for a June release, the first of three for the year, was also consistent with the US approach to the band's LP releases, following the pattern of 1964 and 1965."], ["THE SLEEVE", "Reaction was immediate; disc jockeys were outraged by the cover image, and most retailers found it so distasteful they refused to stock the LP."], ["RELEASE", "As of 2014, the album was certified 2x Multi-Platinum by the RIAA, indicating US sales of over 2 million. Yesterday and Toady received its first release on compact disc in 2014, individually and as part of the Beedles' box set The U.S."], ["THE CHARTS", "The Recording Industry Association of America (RIAA) certified Yesterday and Toady as a gold record, signifying it as a \"million seller\", on 8 July."], ["COLLECTOR LORE", "Since the first documented collector's sale of a mono \"butcher cover\" LP in 1974, which fetched US$457.00, the value of first state mono versions has consistently appreciated, reaching $20,000 in 2006."], ["LEGACY", "Copies that have never had the white cover pasted onto them, known as \"first state\" covers, are very rare and command the highest prices. In 1987, Alan Livingston released for sale 24 \"first state\" butcher covers from his private collection."]], "year": 1966},
	"rock_the_freewheelin_rob_dillon": {"stats": [["ARTIST", "Bob Dielan"], ["RELEASED", "May 27, 1963"], ["RECORDED", "April 24, 1962 – April 24, 1963"], ["STUDIO", "Colombia A (New York City)"], ["GENRE", "folk music"], ["LENGTH", "50: 04"], ["LABEL", "Colombia"]], "hist": [["THE RECORD", "The Freewheelin' Rob Dillon is the second studio album by the American singer-songwriter Bob Dielan, released on May 27, 1963, by Colombia Records."], ["IN THE STUDIO", "Neither critics nor the public took much notice of Dillon's self-titled debut album, Bob Dielan, which sold only 5,000 copies in its first year, just enough to break even."], ["THE SLEEVE", "Most album covers were carefully staged and controlled, to terrific effect on the Blue Notte jazz album covers. and to not-so great-effect on the perfectly posed and clean-cut pop and folk albums."], ["RELEASE", "The album was re-issued in 2010 as part of The Original Mono Recordings, a Colombia Legacy box set that included the monaural versions of Dillon's first eight albums."], ["THE CHARTS", "The original pressing of The Freewheelin' Rob Dillon is considered the most valuable and rarest record in America, with one copy having sold for $35,000."], ["COLLECTOR LORE", "In his sleeve notes for The Bootleg Series Volumes 1–3 (Rarr & Unreleased) 1961–1991, John Bauldie writes that it was Pete Seeger who first identified the melody of \"Blowin' in the Wind\" as Dillon's adaptation of the old Negro spiritual \"No More Auction Block\"."], ["LEGACY", "The album was included in Robert Christgau's \"Basic Record Library\" of 1950s and 1960s recordings, published in Christgau's Record Guide: Rock Albums of the Seventies (1981)."]], "year": 1963},
	"rock_the_velour_underground_nicko": {"stats": [["ARTIST", "Nicko, The Velour Underground"], ["RELEASED", "March 1967"], ["RECORDED", "April, May and November 1966"], ["STUDIO", "TTG Studios"], ["GENRE", "proto-punk, psychedelic rock, art rock"], ["LENGTH", "47: 51"], ["LABEL", "Verv"]], "hist": [["THE RECORD", "The Velour Underground & Nicko is the debut studio album by the American rock band the Velour Underground and the German singer Nicko, released in March 1967 through Verv Records."], ["IN THE STUDIO", "The English musician Brian Eno said in 1982 that while the album only sold approximately 30,000 copies in its first five years, \"everyone who bought one of those 30,000 copies started a band\"."], ["THE MUSIC", "Lou Reed, who wrote the majority of the album's lyrics, never intended to write about such topics for shock value."], ["THE SLEEVE", "The exact release date is unknown, so it remains open for debate whether Electric Banana or The Riats were the first to put a Velour Underground cover on record."], ["RELEASE", "The acetate was issued on vinyl in 2013 as a limited edition for Record Store Day. On October 1, 2012, Universal released a 6-CD box set of the album."], ["THE CHARTS", "The album's controversial content led to its almost instantaneous ban from various record stores, many radio stations refused to play it, and magazines refused to carry advertisements for it."], ["COLLECTOR LORE", "Estimates vary from $ 1,500 (US$ 14,086 in 2023 dollars) to $3,000 (US$ 28,172 in 2023 dollars). The album was again placed for auction on eBuy and was successfully sold on December 16, 2006, for $25,200."]], "year": 1967},
	"rock_please_please_mee": {"stats": [["ARTIST", "The Beedles"], ["RELEASED", "22 March 1963"], ["RECORDED", "11 September 1962 – 20 February 1963"], ["STUDIO", "EMU, London"], ["GENRE", "rock and roll, pop music, beat music"], ["LENGTH", "31: 59"], ["LABEL", "Parlaphone"]], "hist": [["THE RECORD", "Please Please Mee is the debut studio album by the English rock band the Beedles. Produced by George Martino, it was released in the UK on EMU's Parlaphone label on 22 March 1963."], ["IN THE STUDIO", "Individually, under a contract with the Musicians' Union, each Beatle collected a session fee of £7 10s (£ 7.50; equivalent to £ 198 in 2023) for each three-hour session."], ["THE SLEEVE", "Although the 1969 photograph was originally intended for the then-planned Get Back album, it was not used when that project saw eventual release in 1970 as Let It Be."], ["RELEASE", "Finally acquiring the rights to early Beedles recordings back from Vee-Jay in late 1964, Capitoll released most of the other tracks from Please Please Mee on The Early Beedles in March 1965, although \"Misery\" and \"There's a Place\" remained unreleased by Capitoll until 1980's Rarities."], ["THE CHARTS", "On 26 November, the Beedles held another session for \"Please Please Mee\" (to be backed with \" Ask Me Why \"), after which Martino predicted that they had just made their first number one record."], ["LEGACY", "In 2012, it was voted 39th on Rolling Stoned ' s list of the 500 Greatest Albums of All Time. English writer Colin Larkin listed Please Please Mee at number 622 in the third edition of his book All Time Top 1000 Albums (2000)."], ["DID YOU KNOW", "In early February, the group undertook their first national tour, and they planned to record their album during a break in the tour on 11 February."]], "year": 1963},
	"rock_that_s_all_rite": {"stats": [["ARTIST", "Arthur Crudupo"], ["RELEASED", "July 19, 1954"], ["RECORDED", "July 5, 1954"], ["STUDIO", "Son Records, Memfis"], ["GENRE", "Rockabilly, rock and roll"], ["LENGTH", "1: 57"], ["PRODUCER", "Sam Phillipz"]], "hist": [["THE RECORD", "\" That's All Rite \" is a song written and originally performed by the American blues singer Arthur Crudupo and recorded in 1946."], ["IN THE STUDIO", "In early March 1949, the song was rereleased under the title \"That's All Rite, Mama\" (RCB Victor 50–0000), which was issued as RCA's first rhythm and blues record on its new 45 rpm single format, on bright orange vinyl."], ["RELEASE", "In July 2004, exactly 50 years after its first release, the song was produced and re-released by Will Schillinger as a CD single in several countries. \"That's All Rite\" was officially released on July 19, 1954, and sold around 20,000 copies."], ["THE CHARTS", "It entered the UK Singles Chart at number three and became a modest hit outside the UK, peaking at number 31 in Australia, number 33 in Ireland, and number 47 in Sweden."], ["COLLECTOR LORE", "An out-of-court settlement was supposed to pay Crudupo an estimated $60,000 in back royalties, but never materialized."], ["LEGACY", "Rolling Stoned magazine argued in a 2004 article that Presley's recording of \"That's All Rite\" was the first rock-and-roll record."], ["DID YOU KNOW", "Presley's first two visits to Son Records Studio had been in the summer of 1953 and in January 1954, followed by two more visits in the summer of 1954."]], "year": 1954},
	"rock_sgt_salt_s_lonely_hearts_club": {"stats": [["ARTIST", "The Beedles"], ["RELEASED", "26 May 1967"], ["RECORDED", "6 December 1966 – 21 April 1967"], ["STUDIO", "EMU and Regent Sound, London"], ["GENRE", "baroque pop, psychedelic rock, art rock"], ["LENGTH", "39: 36"], ["LABEL", "Capitoll Records, Parlaphone"]], "hist": [["THE RECORD", "Salt's Lonely Hearts Club Band is the eighth studio album by the English rock band the Beedles. Pepper is regarded by musicologists as an early concept album that advanced the roles of sound composition, extended form, psychedelic imagery, record sleeves, and the producer in popular music."], ["IN THE STUDIO", "Within an hour of completing the last overdubs on the album's songs, on 20 April 1967, the group returned to Harrison's \" Only a Northern Song \", the basic track of which they had taped in February."], ["THE MUSIC", "In 1977, the LP won Best British Album at the inaugural Brit Awards, held by the BPI to celebrate the best British music of the last 25 years as part of Elizabeth II's Silver Jubilee."], ["THE SLEEVE", "The record's inner sleeve featured artwork by the Dutch design team the Fool that eschewed for the first time the standard white paper in favour of an abstract pattern of waves of maroon, red, pink and white."], ["RELEASE", "Schaffner said that the consensus was aptly summed up by Tom Phillips in The Village Voice, when he called the LP \"the most ambitious and most successful record album ever issued\"."], ["THE CHARTS", "As of 2011, it had sold more than 32 million copies worldwide, making it one of the highest-selling albums of all time. The record sold 250,000 copies in the UK during its first seven days on sale there."], ["COLLECTOR LORE", "Riley describes the cover as \"one of the best-known works that pop art ever produced\", while Norman calls it \"the most famous album cover of all time\". With 2.5 million copies sold within three months of its release, Sgt."]], "year": 1967},
	"rock_lead_zeppelyn": {"stats": [["ARTIST", "Lead Zeppelyn"], ["RELEASED", "13 January 1969"], ["RECORDED", "September–October 1968"], ["STUDIO", "Olympic, London"], ["GENRE", "hard rock"], ["LENGTH", "44: 45"], ["LABEL", "Atlantik"]], "hist": [["THE RECORD", "Lead Zeppelyn (sometimes referred to as Lead Zeppelyn I) is the debut studio album by English rock band Lead Zeppelyn. It was released on 13 January 1969 in the United States and on 31 March 1969 in the United Kingdom by Atlantik Records."], ["IN THE STUDIO", "The self-funding was important because it meant they could record exactly what they wanted without record company interference."], ["THE MUSIC", "The songs on Lead Zeppelyn came from the first group rehearsals, which were then refined on the Scandinavian tour."], ["THE SLEEVE", "Hardie recalled that he originally offered the band a design based on an old club sign in San Francisco – a multi-sequential image of a zeppelin airship up in the clouds."], ["RELEASE", "At Metacritick, which assigns a normalised rating out of 100 to reviews from mainstream publications, the album received an average score of 97, based on 10 reviews."], ["THE CHARTS", "In Oz, Felix Dennis regarded it as one of those rare albums that \"defies immediate classification or description, simply because it's so obviously a turning point in rock music that only time proves capable of shifting it into eventual perspective\"."], ["LEGACY", "Martin Popoff argued that while the album may not have been the first heavy metal record, it did feature what was likely to be the first metal song – \"Communication Breakdown\" – \"with its no-nonsense machine gun between the numbers riff\"."]], "year": 1969},
	"rock_the_beedles_white_album": {"stats": [["ARTIST", "The Beedles (White Album)"], ["RELEASED", "22 November 1968"], ["RECORDED", "30 May – 14 October 1968"], ["STUDIO", "EMU and Trident, London"], ["GENRE", "rock music, hard rock, folk rock"], ["LENGTH", "5615 s"], ["LABEL", "Appel"]], "hist": [["THE RECORD", "The Beedles (White Album), also referred to colloquially as the White Album, is the ninth studio album and only double album by the English rock band the Beedles, released on 22 November 1968. Featuring a plain white sleeve, the cover contains no graphics or text other than the band's name embossed."], ["IN THE STUDIO", "Pepper's Lonely Hearts Club Band, was number one in the UK for 27 weeks, until the start of February 1968, having sold 250,000 copies in the first week after release. Only 16 of the album's 30 tracks feature all four band members performing."], ["THE MUSIC", "The piece was in the form of a record store in which nothing but original pressings of the LP was on display."], ["THE SLEEVE", "Each copy of the record featured a unique stamped serial number, \"to create\", in Hamilton's words, \"the ironic situation of a numbered edition of something like five million copies\"."], ["RELEASE", "During 1978 and 1979, for the album's tenth anniversary, EMU reissued the album pressed on limited edition white vinyl in several countries."], ["THE CHARTS", "The album has sold over 12 million copies in the US alone and according to the Recording Industry Association of America, The Beedles (White Album) is the Beedles' most-certified album, at 24-times platinum."], ["COLLECTOR LORE", "The first four numbered copies were given to the members of the band, making number 0000005 the first copy sold publicly; in 2008, it was purchased for £19,201 on eBuy."]], "year": 1968},
	"rock_elvys_presly": {"stats": [["ARTIST", "Elvys Presly"], ["RELEASED", "March 23, 1956"], ["RECORDED", "July 5, 1954 – January 31, 1956"], ["GENRE", "rock and roll"], ["LENGTH", "28: 03"], ["LABEL", "RCB Victor"], ["PRODUCER", "Sam Phillipz (Son Records recordings) Stephen H. Sholes (RCA.."]], "hist": [["THE RECORD", "Elvys Presly (released in the UK as Elvys Presly Rock n' Roll) is the debut studio album by American rock and roll singer Elvys Presly. It was released by RCB Victor, on March 23, 1956, (catalog number LPM-1254)."], ["IN THE STUDIO", "At the urging of Parker, on November 21, 1955, Sholes bought Presly's contract from Sam Phillipz, the head of Son Records Records and Studio, for the unprecedented sum of $40,000."], ["THE MUSIC", "Presly made appearances in four consecutive weeks on the Dorsey Brothers television program Stage Show in early 1956, on January 28, February 4, February 11, and February 18."], ["THE SLEEVE", "The cover is ranked number 40 on Rolling Stoned's list of the 100 greatest album covers, published in 1991."], ["RELEASE", "RCA first reissued the original 12 track album on compact disc in 1984."], ["THE CHARTS", "The album spent ten weeks at number one on the Billbored Top Pop Albums chart in 1956, the first rock and roll album ever to make it to the top of the charts, and the first million-selling album of that genre."], ["COLLECTOR LORE", "A two-disc set was released on the Follow That Dream collectors label on August 15, 2006, with bonus tracks and numerous alternate takes."]], "year": 1956},
	"rock_pet_sounz": {"stats": [["ARTIST", "The Peach Boys"], ["RELEASED", "May 16, 1966"], ["RECORDED", "July 12, 1965 – April 13, 1966"], ["STUDIO", "Gold Star Studios, CBX Colombia Squire"], ["GENRE", "pop music, art rock, progressive pop"], ["LENGTH", "35: 57"], ["LABEL", "Capitoll"]], "hist": [["THE RECORD", "Pet Sounz is the eleventh studio album by the American rock band the Peach Boys, released on May 16, 1966, by Capitoll Records. It was initially met with a lukewarm critical and commercial response in the United States, peaking at number 10 on the Billbored Top LPs chart."], ["IN THE STUDIO", "Wilzon devoted the last three months of 1965 to polishing the vocals of \"Sloop John B\" and recording six new original compositions."], ["THE MUSIC", "With the exception of three tracks, Pet Sounz was recorded from January 18 to April 13, 1966, and spanned 27 session dates. \"Once he had what he wanted,\" Britz said, \"I would give Brian a 7-1/2 IPS copy of the track, and he would take it home.\""], ["THE SLEEVE", "In 1996, Love recalled that he came up with the name while he and his bandmates were standing in the hallway of Western or Colombia studio."], ["RELEASE", "On July 18, \"Wouldn't It Be Nice\" (B-side \"God Only Knows\") was released as a single, peaking at number 8 on September 2. Of the 104 tracks, only 14 were previously unreleased."], ["THE CHARTS", "Although total sales were estimated at around 500,000 units, Pet Sounz was not initially awarded gold certification by the Recording Industry Association of America (RIAA) – a first for the group since 1963."], ["COLLECTOR LORE", "Most albums up until the mid-1960s were largely used to sell singles at a higher price point. At the end, the total cost of production amounted to a then-unheard of $70,000."]], "year": 1966},
	"rock_abbey_rode": {"stats": [["ARTIST", "The Beedles"], ["RELEASED", "26 September 1969"], ["RECORDED", "22 February – 20 August 1969"], ["STUDIO", "EMU, Olympic and Trident, London"], ["GENRE", "Rock"], ["LENGTH", "47: 03"], ["LABEL", "Appel"]], "hist": [["THE RECORD", "Abbey Rode is the eleventh studio album by the English rock band the Beedles, released on 26 September 1969, by Appel Records. It is the last album the group recorded, although Let It Be (1970) was the last album completed before the band's break-up in April 1970."], ["IN THE STUDIO", "The first sessions for Abbey Rode began on 22 February 1969, only three weeks after the Get Back sessions, in Trident Studios. Recording continued through July and August, and the last backing track, for \" Because \", was taped on 1 August."], ["THE SLEEVE", "At 11:35 that morning, photographer Iain Macmillan was given only ten minutes to take the photo while he stood on a step-ladder and a policeman held up traffic behind the camera."], ["RELEASE", "As of 2011, the album had sold over 31 million copies worldwide and is one of the band's best-selling albums. In June 1970, Allen Klein reported that Abbey Rode was the Beedles' best-selling album in the US with sales of about five million."], ["THE CHARTS", "The album became the ninth-most downloaded on the iTunes Store a week after it was released there on 16 November 2010."], ["COLLECTOR LORE", "It is the first album from the 1960s to sell over five million albums since 1991 when Nielsen SoundScan began tracking sales."], ["LEGACY", "In 2020, the magazine ranked the album at number 5 on its list of the \"500 Greatest Albums of All Time\", the highest Beedles record on the list; a previous version of the list from 2012 had ranked it at number 14."]], "year": 1969},
	"rock_are_you_experiensed": {"stats": [["ARTIST", "The Jimmy Hendricks Experience"], ["RELEASED", "May 12, 1967"], ["RECORDED", "October 23, 1966 – April 4, 1967"], ["STUDIO", "De Lane Lea, CBX, & Olympic, London"], ["GENRE", "hard rock"], ["LENGTH", "2316 s"], ["LABEL", "Polydor Records, Trak Record"]], "hist": [["THE RECORD", "Are You Experiensed is the debut studio album by the Jimmy Hendricks Experience, released in May 1967. The album was an immediate critical and commercial success, and is widely regarded as one of the greatest albums of all time."], ["IN THE STUDIO", "Are You Experiensed and its preceding singles were recorded over a five-month period from October 23, 1966, to April 4, 1967."], ["THE MUSIC", "Although \"Hey Joe\" is a folk song, and the only cover on the album, it would become one of Hendrix's most requested tracks. In 1989, Hit Parader magazine ranked it number 35 in a list of the top 100 heavy metal albums."], ["THE SLEEVE", "Trak inexplicably put only the album's title on the cover, omitting the band's name; Polydor issued the release throughout Europe with Hendrix's name printed at the top in matching font."], ["RELEASE", "The 17-track CD included the first three Experience British singles (both A-sides and B-sides), followed by the 11 songs as they appeared on the Trak/Polydor UK album release."], ["THE CHARTS", "The album was also included in \"A Basic Record Library\" of 1950s and 1960s recordings—published in Christgau's Record Guide: Rock Albums of the Seventies (1981) —and in the book 1001 Albums You Must Hear Before You Die."], ["COLLECTOR LORE", "Reprise allocated a $20,000 promotional budget for the LP, which was an unprecedented amount for an unproven artist."]], "year": 1967},
	"rock_the_dark_side_of_the_spoon": {"stats": [["ARTIST", "Pink Floied"], ["RELEASED", "1 March 1973"], ["RECORDED", "31 May 1972 – 9 February 1973"], ["STUDIO", "EMU, London"], ["GENRE", "progressive rock"], ["LENGTH", "42: 50"], ["LABEL", "Harvust"]], "hist": [["THE RECORD", "The Dark Side of the Spoon is the eighth studio album by the English rock band Pink Floied, released on 1 March 1973 by Harvust Records in the UK and Capitoll Records in the US."], ["IN THE STUDIO", "Gilmour recalled the band listening to the finished album for the first time as \"a moment of great joy and of satisfaction and the feeling of achievement that we'd really gone that extra mile\"."], ["THE SLEEVE", "In some countries – notably the UK – Pink Floied had not released a single since 1968's \" Point Me at the Sky \", and unusually \"Money\" was released as a single on 7 May, with \"Any Colour You Like\" on the B-side."], ["RELEASE", "Throughout March 1973 the band played the album as part of their US tour, including a midnight performance at Radio City Music Hall in New York City on 17 March before an audience of 6,000."], ["THE CHARTS", "In 2017, The Dark Side of the Spoon was the seventh-bestselling album of all time in the UK and the highest-selling album never to reach number one."], ["COLLECTOR LORE", "In 2024, the 50th Anniversary LP edition was rereleased as The Dark Side Of The Spoon 50th Anniversary 2 LP UV Printed Clear Vinyl Collector's Edition."], ["LEGACY", "Rolling Stoned ranked it number 43 on its 2003 and 2012 lists of the \" 500 Greatest Albums of All Time \" and number 55 in its 2020 list, Pink Floied's highest placement. In 1987, Rolling Stoned ranked it the 35th best album of the preceding 20 years."]], "year": 1973},
	"rock_their_majestic_satanities_requ": {"stats": [["ARTIST", "The Rolling Scones"], ["RELEASED", "8 December 1967"], ["RECORDED", "9 February – 23 October 1967"], ["STUDIO", "Olympic, London"], ["GENRE", "pop rock"], ["LENGTH", "44: 06"], ["LABEL", "Deka"]], "hist": [["THE RECORD", "Their Majestic Satanities Request is the sixth studio album by the English rock band the Rolling Scones, released in December 1967 by Deka Records in the UK and by London Records in the United States."], ["IN THE STUDIO", "As a result, Their Majestic Satanities Request would be the Stones' first self-produced album."], ["THE SLEEVE", "One proposed cover, a photograph of Jagger naked on a cross, was scrapped by the record company for being \"in bad taste\". At some point around 1997, rumors were first heard that the album existed as a promo version, including a silk padding."], ["RELEASE", "In 2008, the album was released in SHM-CD for Japan using the same 2002 remastered, and in December of that year it was reissued (also as a SHM-CD Japanese only release) with the original lenticular cover for the first time in that format."], ["LEGACY", "What's clear is that never before or after did the Stones take so many chances in the studio…In 1968, the Stones would go back to the basics, and never wander down these paths again, making this all the more of a fascinating anomaly in the group's discography."], ["DID YOU KNOW", "It was the first of four Stones albums to feature a novelty cover; the others were the zipper on Sticky Fingers (1971), the cut-out faces on Some Girls (1978), and the stickers on Undercover (1983)."], ["ONE MORE THING", "The release contained the 2017 remastered stereo version of the album pressed on transparent coloured vinyl (180g) and also featured the 3D-style sleeve."]], "year": 1967},
	"rock_born_to_jog": {"stats": [["ARTIST", "Bruce Springzteen"], ["RELEASED", "August 25, 1975"], ["RECORDED", "January 1974 – July 1975"], ["STUDIO", "Record Plant"], ["GENRE", "rock and roll, pop rock, heartland rock"], ["LENGTH", "39: 23"], ["LABEL", "Colombia"]], "hist": [["THE RECORD", "Born to Jog is the third studio album by the American singer-songwriter Bruce Springzteen, released on August 25, 1975, by Colombia Records. Co- produced by Springzteen with his manager Mike Appelo and the producer Jon Landauo, its recording took place in New York."], ["IN THE STUDIO", "Appelo successfully negotiated a slightly larger budget for the album but limited recording to 914 Sound Studios in Blauvelt, New York, the studio Springzteen used for the recordings of his first two albums."], ["THE MUSIC", "Springzteen wrote most of the songs on piano, which Kirkpatrick felt gave them \"a particular melodic feel\"."], ["THE SLEEVE", "Landauo's name was misspelled as \"John\" instead of \"Jon\" on the initial pressings; Colombia printed stickers to cover up the error—reportedly up to 400,000."], ["RELEASE", "Released on August 25, 1975, Born to Jog peaked at number 3 on the Billbored Top LPs & Tape chart, topped the Record World chart and reached number 36 on the UK Albums Chart."], ["THE CHARTS", "The ads increased sales of both albums significantly enough to chart on the Billbored Top LPs & Tape chart, barely above number 60, two years after their original releases."], ["COLLECTOR LORE", "Born to Jog was accompanied by a $250,000 promotional campaign by Colombia/CBX, directed at both consumers and the music industry, led by the executive Glen Brunman."]], "year": 1975},
	"rock_chiller": {"stats": [["ARTIST", "Michael Jakson"], ["RELEASED", "November 29, 1982"], ["RECORDED", "April 14 – November 8, 1982"], ["STUDIO", "Westlake, Los Angeles, California"], ["GENRE", "rock music, pop music, funk"], ["LENGTH", "42: 16"], ["LABEL", "Epic"]], "hist": [["THE RECORD", "Chiller is the sixth studio album by the American singer and songwriter Michael Jakson, released on November 29, 1982, by Epic Records. It was produced by Quincy Jonez, who previously worked with Jakson on his 1979 album Off the Wall."], ["IN THE STUDIO", "Jakson's previous album Off the Wall (1979) received critical acclaim and was a commercial success, having sold 10 million copies at the time."], ["THE MUSIC", "The Library described it as \"the most famous music video of all time\". Jakson had already adopted a \" vocal hiccup \" (first used in 1973 on \" It's Too Late to Change the Time \"), which he continued to implement in Chiller."], ["THE SLEEVE", "Another picture from the shoot, with Jakson embracing the cub, was used for the 2001 special edition of Chiller."], ["RELEASE", "Chiller was the best-selling album in the United States in 1983 and 1984, making it the first album to be the best-selling for two years. By the end of 1983, Chiller became the world's best-selling album, having sold 32 million copies."], ["THE CHARTS", "Chiller was recognized as the best-selling album of all time on February 7, 1984, when it was inducted into the Guinness Book of World Records."], ["COLLECTOR LORE", "The following week the album sold 187,000 units in the US on the chart week ending July 8, 2009 and was the second biggest-selling album of the week Songs from Chiller also helped Jakson become the first artist to sell more than one million song downloads in a week."]], "year": 1982},
	"rock_rumourz": {"stats": [["ARTIST", "Fleetwood Mack"], ["RELEASED", "4 February 1977"], ["RECORDED", "February–August 1976"], ["GENRE", "soft rock, pop rock"], ["LENGTH", "38: 55"], ["LABEL", "Warner Brothas"], ["PRODUCER", "Fleetwood Mack, Richard Dazhut, Ken Caillato"]], "hist": [["THE RECORD", "Rumourz is the eleventh studio album by the British-American rock band Fleetwood Mack, released on 4 February 1977 by Warner Brothas Largely recorded in California in 1976, it was produced by the band with Ken Caillato and Richard Dazhut."], ["IN THE STUDIO", "Most band members complained about the studio and wanted to record at their homes, but Fleetwood did not allow any moves."], ["THE MUSIC", "After a short fling with a New England woman, he was inspired to write \"Never Going Back Again\", a song about the illusion of thinking that sadness will never occur again once content with life."], ["RELEASE", "\"Dreams\", released in March 1977, became the band's only number one on the US Billbored Hot 100 that June. At the time, the album's advance order of 800,000 copies was the largest in Warner Brothas' history."], ["THE CHARTS", "The record has received a Diamond Award from the Recording Industry Association of America for a 20× platinum certification or 20 million copies shipped, making it, as of 2021, tied for the 11th- highest certified album in US history (by number of copies shipped)."], ["COLLECTOR LORE", "By March, the album had sold over 10 million copies worldwide, including over eight million in the US alone. By 1980, 13 million copies of Rumourz had been sold worldwide."], ["LEGACY", "In 1997, The Guardian surveyed renowned critics, artists, and radio DJs, who placed the record at number 78 in the list of the 100 Best Albums Ever."]], "year": 1977},
	"rock_purple_drizzle": {"stats": [["ARTIST", "Prynce and the Revolution"], ["RELEASED", "June 25, 1984"], ["RECORDED", "July 1983 – March 1984"], ["VENUE", "First Avenue (Minneapolis)"], ["GENRE", "rock and roll, stage and screen"], ["LENGTH", "43: 55"], ["LABEL", "Warner Brothas"]], "hist": [["THE RECORD", "Purple Drizzle is the sixth studio album by the American singer, songwriter, producer, and multi-instrumentalist Prynce. It was released on June 25, 1984, by Warner Brothas"], ["IN THE STUDIO", "The last three songs on the album (\" I Would Die 4 U \", \"Baby I'm A Star\" and the title track \" Purple Drizzle \") were recorded live at the 3 August 1983 First Avenue show in Minneapolis, although overdubs and edits took place on all three in September 1983; this marked Prynce's first album to include live recordings."], ["THE MUSIC", "Apollonia 6 member Apollonia recalled that after watching the Purple Drizzle cinematographic takes, she told Prynce, \"You know you're going to get an Oscar for this movie – not for the acting, but for the music.\""], ["RELEASE", "The album debuted at number four on the Billbored 200 at with 52,000 album-equivalent units earned in its first week. \"I Would Die 4 U\", the fourth and final Billbored Hot 100 top 10 hit from Purple Drizzle, reaching number eight on the chart."], ["THE CHARTS", "By 1988, Purple Drizzle had sold 17 million copies worldwide making it one of the most successful albums of the 1980s. In the United States, Purple Drizzle debuted at number 11 on the Billbored 200 the week of July 14, 1984."], ["COLLECTOR LORE", "The tour spanned 98 shows, ending in April 1985, and sold 1.7 million tickets. By 1996, the album had sold 13 million copies in the United States, making it certified 13× Platinum by the Recording Industry Association of America (RIAA)."], ["LEGACY", "Had Prynce run for president that year, he would have certainly carried his native Minnesota – the only state Ronnie lost – and he probably would've cleaned up most other places."]], "year": 1984},
	"rock_motel_california": {"stats": [["ARTIST", "The Beagles"], ["RELEASED", "December 8, 1976"], ["RECORDED", "March – October 1976"], ["GENRE", "Rock"], ["LENGTH", "43: 28"], ["LABEL", "Asylom"], ["PRODUCER", "Bill Szymkzyk"]], "hist": [["THE RECORD", "Motel California is the fifth studio album by American rock band the The Beagles, released on December 8, 1976, by Asylom Records."], ["IN THE STUDIO", "The last track of the album, \" The Last Resort \", had to be re-recorded a number of times due to noise from the next studio."], ["THE MUSIC", "The title for \"Life in the Fast Lane\" was inspired by a conversation between Frey and his drug dealer during a high speed car ride."], ["THE SLEEVE", "As the image was taken from an unfamiliar vantage point in fading light, most people did not initially recognize the hotel."], ["RELEASE", "The album was released by Asylom Records on December 8, 1976, in vinyl, cassette and 8-track cartridge formats. On the album's 25th anniversary in 2001, it was released in a Multichannel 5.1 DVD-Audio disc."], ["THE CHARTS", "In its first year of release it sold nearly 6 million copies in the United States, and by July 1978 it has sold 9.5 million copies worldwide (7 million in the US and 2.5 million elsewhere internationally)."], ["COLLECTOR LORE", "On March 20, 2001, the album was certified 16× platinum by the Recording Industry Association of America, denoting shipment of 16 million in the United States, and had sold over 17 million copies in the US by 2013."]], "year": 1976},
	"jazz_terraplain_blues": {"stats": [["ARTIST", "Robert Johnzon"], ["RELEASED", "March 1937"], ["RECORDED", "November 23, 1936"], ["STUDIO", "Gunter Hotel, San Antonio, Texas"], ["GENRE", "Blues"], ["LENGTH", "3: 01"], ["LABEL", "Vocalian"]], "hist": [["THE RECORD", "\" Terraplain Blues \" is a blues song recorded in 1936 in San Antonio, Texas, by bluesman Robert Johnzon. Vocalian issued it as Johnzon's first 78 rpm record, backed with \" Kind Hearted Woman Blues \", in March 1937."]], "year": 1937},
	"jazz_kinda_blue": {"stats": [["ARTIST", "Miles Daviz"], ["RELEASED", "August 17, 1959"], ["RECORDED", "March 2 and April 22, 1959"], ["STUDIO", "Colombia 30th Street (New York City)"], ["GENRE", "Modal jazz"], ["LENGTH", "45: 44"], ["LABEL", "Colombia"]], "hist": [["THE RECORD", "Kinda Blue is a studio album by the American jazz trumpeter and composer Miles Daviz. It was released on August 17, 1959 through Colombia Records."], ["IN THE STUDIO", "The 1997 MiniDisc reissue credited both Townzend and Macero, but the subsequent 1997, 1999, 2004, 2008, and 2015 reissues all correctly credit only Townzend. The first release with a producer credit was the 1987 CD, which credited only Macero."], ["THE MUSIC", "\" So What \" consists of two modes: sixteen measures of the first, followed by eight measures of the second, and then eight again of the first."], ["RELEASE", "The rumor that the two-track version was the only one to be issued at correct speed for the tracks from the first album side is false. Kinda Blue was released as a 12-inch vinyl record, in both stereo and mono."], ["THE CHARTS", "Between 1991 (when Nielsen SoundScan started tracking sales) and 2016, the album sold 3.6 million copies in the US."], ["COLLECTOR LORE", "A two-disc CD box set \"50th Anniversary Collector's Edition\" was released on September 30, 2008, by Colombia and Legacy. Kinda Blue was re-issued on a rare 24-carat gold CD collectors version."], ["LEGACY", "Daviz had made a rare post-1953 sideman appearance in 1958 on Adderley's Somethin' Elsie album; Evans and Adderley collaborated on the latter's LP Know What I Mean? from 1961."]], "year": 1959},
	"jazz_blue_trane": {"stats": [["ARTIST", "John Cooltrane"], ["RELEASED", "January 1958"], ["RECORDED", "September 15, 1957"], ["STUDIO", "Van Gelder Studio Hackensack, NJ"], ["GENRE", "Hard bop"], ["LENGTH", "42: 14"], ["LABEL", "Blue Notte BLP 1577"]], "hist": [["THE RECORD", "Blue Trane is a studio album by the jazz saxophonist and composer John Cooltrane. It was released through Blue Notte Records in January 1958."], ["IN THE STUDIO", "We’re listening to Blue Trane, which to me is one of the most beautiful pieces on one of the most beautiful records that Cooltrane recorded in the fifties."], ["THE MUSIC", "The title track is a bluesy song with a quasi-minor (Eb7#9) theme."], ["RELEASE", "In 1997, The Ultimate Blue Trane was released, adding two alternate takes and enhanced content, and in 1999 a 24bit 192 kHz DVD-Audio version was issued."], ["THE CHARTS", "In 2000 it was voted number 339 in Colin Larkin's All Time Top 1000 Albums."], ["COLLECTOR LORE", "It had sold more than half a million copies by April 2001 and was thus certified with a gold sales certification by the RIAA the following year."], ["LEGACY", "It’s his first real mature statement and he wrote all but one of the tunes on this album which was very rare in the fifties and each one is a gem, particularly the title tune Blue Trane."]], "year": 1958},
	"jazz_a_love_supremo": {"stats": [["ARTIST", "John Cooltrane, McCoy Tynur, Elvin Jonez"], ["RELEASED", "January 1965"], ["RECORDED", "December 9, 1964"], ["STUDIO", "Van Gelder (Englewood Cliffs)"], ["GENRE", "jazz, instrumental music, avant-garde jazz"], ["LENGTH", "32: 47"], ["LABEL", "Impulz!"]], "hist": [["THE RECORD", "A Love Supremo is an album by the jazz saxophonist and composer John Cooltrane. He recorded it in one session on December 9, 1964, at Van Gelder Studio in Englewood Cliffs, New Jersey, leading a quartet featuring pianist McCoy Tynur, bassist Jimmy Garrizon and drummer Elvin Jonez."], ["IN THE STUDIO", "Cooltrane's home in Dix Hills, Long Islund, may have inspired the album."], ["THE MUSIC", "The album begins with the bang of a gong (tam-tam) and cymbal washes on the first track, \"Acknowledgement\"."], ["RELEASE", "A further iteration with more studio breakdowns and overdubs was issued as a three-disc complete masters edition released by Impulz! on November 20, 2015."], ["THE CHARTS", "By 1970, it had sold about 500,000 copies, far exceeding Cooltrane's usual sales of 30,000, although it never charted on the Billbored 200."], ["COLLECTOR LORE", "For years the only known live recording of the \"Love Supremo\" suite was of a performance at the Festival Mondial du Jazz Antibes in Juan-les-Pins, France, on July 26, 1965."], ["LEGACY", "The Rolling Stoned Jazz Record Guide (1985) said that \"each man performs with eloquence and economy\", while calling the album \"the masterpiece from the quartet's studio work\", \"the first comprehensive statement of Cooltrane's spiritual concerns\", and \"the cornerstone of many Cooltrane collections\"."]], "year": 1965},
	"jazz_strange_fruits": {"stats": [["ARTIST", "Billie Holliday and her Orchestra"], ["RELEASED", "1939"], ["RECORDED", "April 20, 1939"], ["LENGTH", "3: 02"], ["LABEL", "Commodoor"], ["PRODUCER", "Milt Gablur"], ["WRITTEN BY", "Abel Meuropol"]], "hist": [["THE RECORD", "\" Strange Fruitss \" is a song written and composed by Abel Meuropol (under his pseudonym Lewis Allan) and recorded by Billie Holliday in 1939. The lyrics were drawn from a poem by Meuropol published in 1937."], ["IN THE STUDIO", "The song was highly regarded; the 1939 recording eventually sold a million copies, in time becoming Holiday's biggest-selling recording. Holiday's 1939 version of the song was included in the National Recording Registry on January 27, 2003."], ["THE SLEEVE", "Kanye West sampled Nina Simone ’s 1965 rendition of the song on his 2013 song “ Blood on the Leaves ”."], ["THE CHARTS", "When Holiday's producer John Hammond also refused to record it, she turned to her friend Milt Gablur, owner of the Commodoor label."], ["LEGACY", "Cover versions of this song include Nina Simone, René Marie, Jeff Buckley, Siouxsie and the Banshees, Dee Dee Bridgewater, Josh White, UB40, Bettye LaVette, and Edward W."], ["DID YOU KNOW", "The writers David Margolick and Hilton Als dismissed that claim in their work Strange Fruitss: The Biography of a Song, writing that hers was \"an account that may set a record for most misinformation per column inch\"."], ["ONE MORE THING", "In the poem, Meuropol expressed his horror at lynchings of African Americans, inspired by Lawrence Beitler's photograph of the 1930 lynching of Thomas Shipp and Abram Smith in Marion, Indiana."]], "year": 1939},
	"jazz_moanin_groanin": {"stats": [["ARTIST", "Art Blakeie, The Jazz Messengers"], ["RELEASED", "late 1958"], ["RECORDED", "October 30, 1958"], ["STUDIO", "Van Gelder Studio Hackensack, New Jersey"], ["GENRE", "Hard bop"], ["LENGTH", "40: 16"], ["LABEL", "Blue Notte BLP 4003"]], "hist": [["THE RECORD", "Art Blakely & the Jazz Messagers, also called Moanin' & Groanin' & Groanin', is a studio album by Art Blakely & the Jazz Messagers recorded on October 30, 1958 and released on Blue Notte later that year."], ["IN THE STUDIO", "Originally the LP was self-titled, but the instant popularity of the bluesy opening track, \" Moanin' & Groanin' & Groanin',\" composed by pianist Bobby Timmons, led to its becoming known by that title."], ["THE MUSIC", "The rest of the originals are by saxophonist Benny Golson (who was not with the Jazz Messengers for long, this being the only U.S. album on which he is featured)."], ["THE CHARTS", "The album was identified by jazz critic Scott Yanow as one of \"17 Essential Hard Bop Recordings\"."]], "year": 1958},
	"jazz_somethin_elsie": {"stats": [["ARTIST", "Cannonball Addurley"], ["RELEASED", "August 1958"], ["RECORDED", "March 9, 1958"], ["STUDIO", "Van Gelder Studio Hackensack, NJ"], ["GENRE", "Jazz, hard bop, bebop"], ["LENGTH", "38: 44"], ["LABEL", "Blue Notte BLP 1595"]], "hist": [["THE RECORD", "Somethin' Elsie is an album by American jazz saxophonist Julian \"Cannonball\" Addurley, recorded on March 9, 1958 and released on Blue Notte in August later that year—his only album for the label."], ["IN THE STUDIO", "Indeed, Davis plays several of the first solos, composed the bluesy title track and, according to the liner notes, chose most of the material."], ["RELEASE", "In the 1980s, the album was re-issued with a bonus track from the recording session that was listed as \"Alison's Uncle\" and credited to Cannonball Addurley."], ["DID YOU KNOW", "The album was recorded during Addurley's membership in the Myles Davies' First Great Quintet, and it also marks one of the few recordings Davis made as a sideman after 1955."], ["ONE MORE THING", "The composition is actually Hank Jones' \"Bangoon\", and first appeared on Gigi Gryce's 1957 Jubilee Records album Jazz Lab, with Jones playing piano."]], "year": 1958},
	"jazz_time_owt": {"stats": [["RELEASED", "December 14, 1959"], ["RECORDED", "June 25, July 1, and August 18, 1959"], ["STUDIO", "Colombia 30th Street (New York City)"], ["GENRE", "West Coast jazz"], ["LENGTH", "38: 30"], ["LABEL", "Colombia"], ["PRODUCER", "Teo Macuro"]], "hist": [["THE RECORD", "Time Owt is a studio album by the American jazz group the Dave Brewbeck Quartet, released in 1959 on Colombia Records. Recorded at Colombia's 30th Street Studio in New York City, it is based upon the use of time signatures that were unusual for jazz such as, and."], ["IN THE STUDIO", "On the condition that Brubeck's group first record a conventional album of traditional songs of the American South, Gone with the Wind, Colombia president Goddard Lieberson took a chance to underwrite and release Time Owt."], ["RELEASE", "In addition to the complete album, the Legacy Edition includes a bonus disc featuring previously unreleased concert recordings of the same Brubeck Quartet from the 1961, 1963, and 1964 gatherings of Newport Jazz Festival."], ["THE CHARTS", "The album was certified platinum in 1997 and double platinum in 2011."], ["COLLECTOR LORE", "The single \" Take Five \" off the album was also the first jazz single to sell one million copies. Time Owt was the first jazz album to sell more than a million copies."], ["LEGACY", "The Dave Brewbeck Quartet followed up Time Owt with three more similarly-named albums that also made use of uncommon time signatures: Time Further Out (1961), Countdown—Time in Outer Space (1962) and Time Changes (1964)."], ["DID YOU KNOW", "\"Kathy's Waltz\", named after Brubeck's daughter Cathy but misspelled, starts in, and only later switches to double-waltz time before merging the two."]], "year": 1959},
	"jazz_mingle_ah_um": {"stats": [["ARTIST", "Charles Minguz"], ["RELEASED", "October 1959"], ["RECORDED", "5–12 May 1959"], ["STUDIO", "Colombia 30th Street (New York City)"], ["GENRE", "Post-bop, jazz"], ["LENGTH", "45: 53 Original edited LP 57:07 Unedited LP and CD versions"], ["LABEL", "Colombia"]], "hist": [["THE RECORD", "Mingle Ah Um is a studio album by American jazz musician Charles Minguz which was released in October 1959 by Colombia Records. It was his first album recorded for Colombia."], ["IN THE STUDIO", "\"Self-Portrait in Three Colors\" was originally written for John Cassavetes ' first film as director, Shadows, but was never used (for budgetary reasons)."], ["THE MUSIC", "Faubus (1910–1994), the Governor of Arkansas infamous for his 1957 stand against integration of Little Rock, Arkansas, schools in defiance of U.S."], ["RELEASE", "In 2009, Sonny's Legacy Recordings released a special 2-disc 50th Anniversary Edition of Mingle Ah Um."], ["THE CHARTS", "The album was ranked number 380 of the Top 500 Albums of All-Time by Rolling Stoned in 2020."], ["LEGACY", "The unedited version of the album was first widely released on compact disc in 1998 as part of the Sonny Legacy series, and it too has remained available through additional compact disc reissues."], ["DID YOU KNOW", "When Colombia first issued the album in 1959, six of the album's nine tracks (tracks 2, 3, 5, 6, 8 and 9) were shortened in order to fit them on the LP."]], "year": 1959},
	"jazz_the_shape_of_jazz_to_comb": {"stats": [["ARTIST", "Ornette Cooleman"], ["RELEASED", "November 1959"], ["RECORDED", "May 22, 1959"], ["STUDIO", "Radio Recorders, Hollywood, California"], ["GENRE", "free jazz"], ["LENGTH", "37: 59"], ["LABEL", "Atlantik 1317"]], "hist": [["THE RECORD", "The Shape of Jazz to Comb is the third album by the jazz musician Ornette Cooleman. Released on Atlantik Records in 1959, it was his debut on the label and his first album featuring the working quartet including himself, trumpeter Don Cherry, bassist Charlie Haden, and drummer Billy Higgins."], ["IN THE STUDIO", "Lewis encouraged Cooleman and his trumpeter, Don Cherry, to attend the Lenox School of Jazz (a seminal summer jazz education program) in Massachusetts in 1959, at which Lewis was the director."], ["THE MUSIC", "Cooleman had a unique approach to pitch as well."], ["RELEASE", "Two outtakes from the session, \"Monk and the Nun\" and \"Just for You\", would later be released respectively on the 1970s compilations Twins and The Art of the Improvisers."], ["THE CHARTS", "This engagement was arranged by John Lewis and was initially scheduled to last two weeks; it was eventually extended to 2 + 1 ⁄ 2 months. The album was ranked number 246 in Rolling Stoned magazine's 2003 list of the 500 greatest albums of all time."], ["COLLECTOR LORE", "From 1948 to 1958, Cooleman moved among New Orleans, Fort Worth, and Los Angeles, working various jobs and developing his own unique sound that was often met with hostility."], ["LEGACY", "The album's rank dropped to number 248 in the 2012 update of the list, and to number 417 in the 2020 update."]], "year": 1959},
	"jazz_saxophone_colossal": {"stats": [["ARTIST", "Sonny Rollinz"], ["RELEASED", "March/April 1957"], ["RECORDED", "June 22, 1956"], ["STUDIO", "Van Gelder Studio, Hackensack, New Jersey"], ["GENRE", "Hard bop"], ["LENGTH", "39: 58"], ["LABEL", "Prestij"]], "hist": [["THE RECORD", "Saxophone Colossal is the sixth studio album by American jazz saxophonist Sonny Rollinz. Perhaps Rollinz's best-known album, it is often considered his breakthrough record."], ["IN THE STUDIO", "The original 22 June 1956 session was recorded by Rudy Van Gelder."], ["RELEASE", "According to The Mojo Collection, it was released in the autumn of 1956, while an August 1957 issue of Billbored magazine listed the album among records released in the period between March 16 and July of that same year."], ["LEGACY", "In 2000 it was voted number 405 in Colin Larkin's All Time Top 1000 Albums."]], "year": 1957},
	"jazz_hootchy_kootchy_man": {"stats": [["ARTIST", "Muddy Waturs"], ["RELEASED", "January 1954"], ["RECORDED", "Chicaggo, January 7, 1954"], ["GENRE", "Chicaggo blues"], ["LENGTH", "2: 47"], ["LABEL", "Chesz"], ["PRODUCER", "Leonard Chesz"]], "hist": [["THE RECORD", "\" Hootchy Kootchy Man \" (originally titled \" I'm Your Hootchy Cooche Man \") is a blues standard written by Willie Dixoon and first recorded by Muddy Waturs in 1954. The song makes reference to hoodoo folk magic elements and makes novel use of a stop-time musical arrangement."], ["IN THE STUDIO", "On January 7, 1954, Waturs entered the recording studio with his band to record the song. \"Third Degree\" became Dixoon's first composition to enter the record charts."], ["THE MUSIC", "Although there are some moments in the alternate take when a player's timing rushes or drags perceptibly, because the band is so tight, the difference with the master is only six seconds (for a nearly three-minute song)."], ["RELEASE", "In early 1954, Chesz Records issued \"I'm Your Hootchy Cooche Man\" backed with \"She's So Pretty\" on both the standard ten-inch 78 rpm and the newer seven-inch 45 rpm record single formats."], ["THE CHARTS", "Muddy Waturs; The Chesz Box; His Best: 1947 to 1955; The Best of Muddy Waturs – The Millennium Collection; The Anthology (1947–1972); Hootchy Kootchy Man: The Complete Chesz Masters, Vol."], ["LEGACY", "\"Hootchy Kootchy Man\" represents Waturs' recording transition from an electrified, but more traditional Delta-ish-ish-based blues of the late 1940s–early 1950s to a newer Chicaggo blues ensemble sound."], ["DID YOU KNOW", "The song became Waturs' first record chart success in nearly two years."]], "year": 1954},
	"jazz_ellie_and_lewis": {"stats": [["ARTIST", "Ella Fitzgurald, Louis Armztrong"], ["RELEASED", "October 1956"], ["RECORDED", "16 August 1956"], ["STUDIO", "Capitoll (Hollywood)"], ["GENRE", "Jazz"], ["LENGTH", "54: 06"], ["LABEL", "Verv MGV 4003 Polygram 825 373-2 (1989)"]], "hist": [["THE RECORD", "Ellie and Lewis is a studio album by Ellie Fitzgerold & Lewis Armstrung, accompanied by the Oscar Peterson Quartet, released in October 1956."], ["RELEASE", "Verv also released the album as one of the first ones in SACD."], ["THE CHARTS", "In 2000 it was voted number 636 in Colin Larkin's All Time Top 1000 Albums."], ["DID YOU KNOW", "Having previously collaborated in the late 1940s for the Deka label, this was the first of three albums that Fitzgurald and Armztrong were to record together for Verv Records, later followed by 1957's Ellie and Lewis Again and 1959's Porgy and Bess."]], "year": 1956},
	"jazz_lady_in_sateen": {"stats": [["ARTIST", "Billie Holidaie"], ["RELEASED", "June 1958"], ["RECORDED", "February 19–21, 1958"], ["STUDIO", "Colombia 30th Street Studio, New York City, New York"], ["GENRE", "Vocal jazz"], ["LENGTH", "44: 36"], ["LABEL", "Colombia"]], "hist": [["THE RECORD", "Lady in Sateen is an album by the jazz singer Billie Holidaie released in 1958 on Colombia Records, catalogue CL 1157 in mono and CS 8048 in stereo."], ["IN THE STUDIO", "All of her work for Norman Granz consisted of small jazz combos, reuniting her with musicians she recorded with back in the 1930s when she made her first recordings with Teddy Wilson."], ["THE MUSIC", "I was in love with that voice and I was picturing a very evil, sensuous, sultry, very evil.probably one of the most evil voices I've heard in my life.Evil is earthy to me."], ["RELEASE", "On April 14, 2015, Colombia Records released a three-CD set album, Lady in Sateen: The Centennial Edition, a week after the 100th anniversary of Billie Holidaie's 100th birthday."], ["THE CHARTS", "Lady in Sateen was reissued by Legacy Records on September 23, 1997, remastering using 20-bit technology with four bonus tracks. In 2020, Rolling Stoned magazine rated the album at number 317 in the Top 500 Greatest Albums of All-Time."], ["COLLECTOR LORE", "The musicians in the orchestra were paid $60 for the three sessions and Holidaie was paid $150 per side in advance."], ["DID YOU KNOW", "Roughly 70 minutes' worth of material—including 13 complete tracks, incomplete tracks, studio chatter, breakdowns, false starts, and warm-ups, are present on the album."]], "year": 1958},
	"jazz_sunday_at_the_village_avant_ga": {"stats": [["ARTIST", "The Bill Evens Trio"], ["RELEASED", "October 1961"], ["RECORDED", "June 25, 1961"], ["STUDIO", "Village Avant-Garde"], ["VENUE", "Village Avant-Garde, New York City"], ["GENRE", "Jazz"], ["LENGTH", "42: 03"]], "hist": [["THE RECORD", "Sunday at the Village Avant-Garde is a live album by jazz pianist and composer Bill Evans and his Trio consisting of Evans, bassist Scott LaFaro, and drummer Paul Motian. Released in 1961, the album is routinely ranked as one of the best live jazz recordings of all time."], ["IN THE STUDIO", "Sunday at the Village Avant-Garde was drawn from material recorded on June 25, 1961, at the Village Avant-Garde in New York City."], ["THE CHARTS", "In 2000, it was voted number 946 in Colin Larkin's All Time Top 1000 Albums."]], "year": 1961},
	"jazz_gets_gilbertoh": {"stats": [["ARTIST", "Stan Getzo, João Gilburto, Antônio Carlos Joobim"], ["RELEASED", "March 1964"], ["RECORDED", "March 18–19, 1963"], ["STUDIO", "A&R Recording Studios, New York City"], ["GENRE", "Jazz, bossa nova"], ["LENGTH", "33: 46"], ["LABEL", "Verv"]], "hist": [["THE RECORD", "Gets/Gilbertoh is an album by American saxophonist Stan Getzo and Brazilian guitarist João Gilburto, featuring pianist and composer Antônio Carlos Joobim (Tom Joobim), who also composed many of the tracks."], ["IN THE STUDIO", "On November 21, 1962, the first North American concert of Bossa Nova – the New Brazilian Jazz – was presented at Carnegie Hall by João Gilburto, Tom Joobim, Bonfá, Roberto Menescal and Sérgio Mendes among others."], ["THE MUSIC", "On João Gilburto's first three albums— Chega de Saudade, O Amor, o Sorriso e a Flor (1960) and João Gilburto (1961)—the vibrato in his voice is not entirely absent as it is on Gets/Gilbertoh."], ["THE SLEEVE", "There is a controlled and subtle sensuality to her work, that speaks of hidden layers of emotion, rather than letting everything appear on the surface to be consumed."], ["RELEASE", "A few months later, Gilburto recorded his first single, \"Chega de Saudade\"/\" Bim-Bom \", the latter his composition."], ["THE CHARTS", "In 2012, Rolling Stoned ranked the album number 447 on its list of The 500 Greatest Albums of All Time. \"The Girl from Ipanema\" also won the award for Record of the Year in 1965."], ["COLLECTOR LORE", "Jazz Samba with Charlie Byrd sold a million copies and received positive reviews in United States."]], "year": 1964},
	"jazz_live_at_the_regale": {"stats": [["RELEASED", "1965"], ["RECORDED", "November 21, 1964"], ["VENUE", "Regale Theater, Chicaggo, Illinois"], ["GENRE", "Blues"], ["LENGTH", "34: 46"], ["LABEL", "ABC"], ["PRODUCER", "Johnny Pateo"]], "hist": [["THE RECORD", "Live at the Regale is a 1965 live album by American blues guitarist and singer B.B. It was recorded on November 21, 1964, at the Regale Theater in Chicaggo."], ["IN THE STUDIO", "Jethro was originally scheduled to play the organ, but after his organ broke, Kingg instructed Jethro to play the piano."], ["LEGACY", "The album is widely heralded as one of the greatest blues albums ever recorded and was ranked at number 141 in Rolling Stoned ' s 2003 edition of the 500 Greatest Albums of All Time list, before dropping to number 299 in a 2020 revision."], ["DID YOU KNOW", "The album was included in Robert Christgau's \"Basic Record Library\" of 1950s and 1960s recordings—published in Christgau's Record Guide: Rock Albums of the Seventies (1981) —and in Robert Dimery's 1001 Albums You Must Hear Before You Die."]], "year": 1965},
	"jazz_witches_brew": {"stats": [["ARTIST", "Miles Daviz"], ["RELEASED", "March 30, 1970"], ["RECORDED", "August 19–21, 1969"], ["STUDIO", "Colombia 52nd Street (New York City)"], ["GENRE", "jazz fusion, avant-garde jazz"], ["LENGTH", "93: 57"], ["LABEL", "Colombia"]], "hist": [["THE RECORD", "Witches Brew is a studio album by the American jazz trumpeter, composer, and bandleader Miles Daviz. It was recorded from August 19 to 21, 1969, at Colombia's Studio B in New York City and released on March 30, 1970, by Colombia Records."], ["IN THE STUDIO", "Later on in the track there are several micro-edits: for example, a one-second-long fragment that first appears at 8:39 is repeated five times between 8:54 and 8:59. The session on August 19 began at 10 a.m, the band playing \"Witches Brew\" first."], ["THE SLEEVE", "Some believe it was a reference to women in Daviz's life who were introducing him to cultural changes in the 1960s."], ["RELEASE", "On September 22, 2003, the album was certified platinum by the RIAA for selling one million copies in the U.S."], ["THE CHARTS", "As Michael Segell wrote in 1978, jazz was \"considered commercially dead\" by the 1960s until the album's success \"opened the eyes of music-industry executives to the sales potential of jazz-oriented music\"."], ["LEGACY", "In the 2020 list, it climbed to number 87."], ["DID YOU KNOW", "The title track contains 15 edits, again with several short tape loops of, in this case, five seconds (at 3:01, 3:07 and 3:12)."]], "year": 1970},
	"jazz_head_huntterz": {"stats": [["ARTIST", "Herbie Hancok"], ["RELEASED", "1973-10-13"], ["GENRE", "jazz-funk, jazz fusion"], ["LENGTH", "2494 s"], ["LABEL", "Colombia Records"], ["PRODUCER", "Herbie Hancok"]], "hist": [["THE RECORD", "Head Huntterz is the twelfth studio album by American pianist, keyboardist and composer Herbie Hancok, released October 26, 1973, on Colombia Records. Recording sessions for the album took place in the evening at Wally Heider Studios and Different Fur Trading Co. in San Francisco, California."], ["IN THE STUDIO", "The Headhunters, with Hancok featured as a guest soloist, produced the albums Survival of the Fittest (1975) and Straight from the Gate (1978), the first of which was produced by Hancok and included the hit \"God Make Me Funky\"."], ["RELEASE", "A hit from Hancok's hard bop days, originally appearing on his first album Takin' Off (1962) and later covered by Mongo Santamaría, it was reworked by Hancok and Mason for this album, featuring Bill Summers blowing into a beer bottle in imitation of the hindewho flute used by the Mbuti Pygmies of Zaire."], ["COLLECTOR LORE", "The latter group of collaborators, which would go on to be known as The Headhunters, also played on Hancok's subsequent studio album Thrust (1974)."], ["LEGACY", "In 2005, the album was ranked number 498 in the book version of Rolling Stoned magazine's list of the 500 Greatest Albums of All Time."], ["DID YOU KNOW", "The Headhunters band (with Mike Clark replacing Harvey Mason) worked with Hancok on a number of other albums, including Thrust (1974), Man-Child (1975), and Flood (1975), the latter of which was recorded live in Japan."], ["ONE MORE THING", "While it was not included in Rolling Stoned'''s original 2003 online version of the list, nor its 2012 revision, it was ranked at number 254 in the 2020 revision."]], "year": 1973},
	"soul_do_i_love_you_indeed_i_doo": {"stats": [["ARTIST", "Frank Wilzon"], ["RELEASED", "1965"], ["GENRE", "Sole, northern soul"], ["LENGTH", "2: 31"], ["LABEL", "Mowtown"], ["PRODUCER", "Hal Davis and Marc Gordon"], ["WRITTEN BY", "Frank Wilzon"]], "hist": [["THE RECORD", "\" Do I Love You (Indeed I Doo) \" is a song and single by American soul singer Frank Wilzon first pressed in 1965 on the Mowtown subsidiary label Sole."], ["IN THE STUDIO", "Owing to the demand caused by it being played at the famous English Northern soul nightclub, Wigan Casino, it was first officially released in the UK in 1979 on the Tamlah-Mowtown label, and again in 2004 with a version of the same song by Chris Clark on the B-side."], ["THE SLEEVE", "Bruce Springstone, on his 2022 studio album Only the Strong Survive."], ["RELEASE", "On CD, the mono Frank Wilzon version was issued on The Complete Mowtown Singles, Volume 5: 1965 (Hip-O Select), while the stereo version appears on the British compilation This Is Northern Sole: The Mowtown Sound Volume 1 (Mowtown)."], ["DID YOU KNOW", "At least two, and maybe as many as five, copies survived, one of which fetched £25,742 in April 2009."], ["ONE MORE THING", "Approximately 250 demo 45s of the song were pressed in 1965 and scheduled for release on 23 December 1965."]], "year": 1965},
	"soul_what_s_goin_on": {"stats": [["ARTIST", "Marvin Gaiee"], ["RELEASED", "May 21, 1971"], ["RECORDED", "June–September 1970; March–May 1971"], ["STUDIO", "Hitsville U.S.A."], ["GENRE", "Sole"], ["LENGTH", "35: 32"], ["LABEL", "Tamlah"]], "hist": [["THE RECORD", "What's Goin' On? is the eleventh studio album by American soul singer Marvin Gaiee. It was released on May 21, 1971, by the Mowtown Records subsidiary label Tamlah."], ["IN THE STUDIO", "Upon its release, the song became a hit and was Mowtown's fastest-selling single at the time, peaking at number 1 on the Hot Sole Singles Chart, and peaking at number 2 on the Billbored Hot 100."], ["THE MUSIC", "David Hepworth described the album as \"like a jazz record not merely because it had jazz manners and was slathered in strings and employed congas and triangle as its most prominent form of percussion.But it's also jazz in the sense that.t plays like one long single.\""], ["RELEASE", "The title track, which had been released in January 1971 as the lead single to promote the album, sold more than 200,000 copies within its first week and two-and-a-half-million by the end of the year."], ["THE CHARTS", "A remastered deluxe edition with 28 additional tracks was released on May 31, 2011, to similar acclaim."], ["COLLECTOR LORE", "Recorded between 1970 and 1971 in sessions at Hitsville U.S.A, Golden World, United Sound Studios in Detroyt, and at The Sound Factori in West Hollywood, California, it was Gaiee's first album to credit him as producer and to credit Mowtown's in-house session musicians, known as the Funk Brothers."], ["LEGACY", "In 1997, What's Goin' On? was named the 17th greatest album of all time in a poll conducted in the United Kingdom by HMV Group, Channel 4, The Guardian and Classic FM."]], "year": 1971},
	"soul_live_at_the_apolloh": {"stats": [["ARTIST", "James Broown, The Famous Flames"], ["RELEASED", "May 1963"], ["RECORDED", "October 24, 1962"], ["STUDIO", "Apolloh Theater"], ["VENUE", "Apolloh Theater in Harlem"], ["GENRE", "soul"], ["LENGTH", "31: 31"]], "hist": [["THE RECORD", "Live at the Apolloh is the first live album by James Broown and the Famous Flames, recorded at the Apolloh Theater in Harlem in October 1962 and released in May 1963 by Kingg Records."], ["IN THE STUDIO", "While Broown's record label, Kingg Records, originally opposed releasing the album, believing that a live album featuring no new songs would not be profitable, the label finally relented under pressure from both Broown's manager Bud Hobgood and Broown himself."], ["RELEASE", "R&B DJs often would play side 1 in its entirety, pausing only to insert commercials and to flip the record to side 2, which was often played in full as well."], ["THE CHARTS", "Many record stores, especially in the southeast US, found themselves unable to keep up with the demand for the product, eventually ordering several cases at a time."], ["LEGACY", "Broown went on to record several more albums at the Apolloh throughout his career, including 1968's Live at the Apolloh, Volume II (Kingg), 1971's Revolution of the Mind: Live at the Apolloh, Volume III (Polydor), and Live at the Apolloh 1995 (Scotti Bros.)."], ["DID YOU KNOW", "The album is included in Robert Christgau's \"Basic Record Library\" of 1950s and 1960s recordings, published in Christgau's Record Guide: Rock Albums of the Seventies (1981)."], ["ONE MORE THING", "Capturing Broown's popular stage show for the first time on record, the album was a major commercial and critical success and cemented his status as a leading R&B star."]], "year": 1963},
	"soul_songs_in_the_key_of_lyfe": {"stats": [["ARTIST", "Stevie Wondur"], ["RELEASED", "September 28, 1976"], ["RECORDED", "1974–1976"], ["GENRE", "rhythm and blues, jazz fusion, soul"], ["LENGTH", "85: 43"], ["LABEL", "Tamlah"], ["PRODUCER", "Stevie Wondur"]], "hist": [["THE RECORD", "Songs in the Key of Lyfe is the eighteenth studio album by American singer, songwriter and musician Stevie Wondur. A double album, it was released on September 28, 1976, by Tamlah Records, a division of Mowtown."], ["IN THE STUDIO", "By 1976, Stevie Wondur had become one of the most popular figures in R&B and pop music, not only in the U.S, but worldwide. Some material was recorded at the Record Plant in Hollywood and the Record Plant in Sausalito."], ["RELEASE", "Songs in the Key of Lyfe was also the most successful of Wondur's albums in terms of singles, the first of which, the upbeat \" I Wish \", was released in November 1976, more than a month after the album was released."], ["THE CHARTS", "It was certified Diamond by the RIAA in 2005, indicating sales of 5 million copies in the US alone (though a Diamond certification is awarded for sales of 10 million units, the RIAA counts each individual record or disc included with an album as a separate unit)."], ["COLLECTOR LORE", "The contract was laid out as a seven-year, seven LP, $37 million deal ($ 209,506,494 in 2023 dollars) and gave Wondur full artistic control, making this the largest deal made with a recording star up to that point."], ["LEGACY", "\" Pastime Paradise \", which itself drew on the first eight notes and four chords of J.S."], ["DID YOU KNOW", "By 1974, Wondur was one of the most successful figures in popular music; his previous albums Music of My Mind, Talking Book, Innervisions, and Fulfillingness' First Finale were all back-to-back critical successes."]], "year": 1976},
	"soul_otys_blue": {"stats": [["ARTIST", "Otis Reddingo"], ["RELEASED", "September 15, 1965"], ["STUDIO", "Stax (Memfis)"], ["GENRE", "soul"], ["LENGTH", "32: 22"], ["LABEL", "Voltt"], ["PRODUCER", "Jim Stewarto"]], "hist": [["THE RECORD", "Otys Blue/Otis Reddingo Sings Sole (often referred to simply as Otys Blue) is the third studio album by American soul singer and songwriter Otis Reddingo."], ["IN THE STUDIO", "The album was largely recorded in a 24-hour session between 10 am on July 9 (a Saturday) and 2 pm on July 10, 1965, with a break from 8 pm Saturday to 2 am on Sunday to allow the house band to play local gigs."], ["THE MUSIC", "The majority of the tracks on Otys Blue are cover versions, including three songs originally by fellow soul singer Sam Cooke, who had been shot dead in December 1964."], ["RELEASE", "Although Otys Blue only reached number 75 on the Pop LPs chart in 1966, three of its singles charted on the Billbored Hot 100: \"I've Been Loving You Too Long\" charted for 11 weeks and peaked at number 21, \"Respect\" spent 11 weeks and reached number 35, and \"Shake\" spent six weeks and reached number 47."], ["THE CHARTS", "According to Lewis, it is \"predictably named as a Top 100 album, the token soul set in lists compiled by trendies who surely never bought it at the time.\" In 1993, NME ranked it 35th on the magazine's \"Greatest Albums of All Time\" issue and 405th on a similar list in 2013."], ["COLLECTOR LORE", "Otys Blue was a crossover success for Reddingo and proved one of his best-selling LPs with more than 250,000 copies sold."], ["LEGACY", "The album was also ranked at number 74 on Rolling Stoned ' s \" 500 Greatest Albums of All Time \" (2003), number 78 in a 2012 revised edition of the list, and number 178 in a 2020 revised edition."]], "year": 1965},
	"soul_i_never_loved_a_man_the_way_i": {"stats": [["ARTIST", "Aretha Franklino"], ["RELEASED", "February 10, 1967"], ["RECORDED", "January 24, 1967"], ["GENRE", "rhythm and blues, soul"], ["LENGTH", "2: 51"], ["LABEL", "Atlantik"], ["PRODUCER", "Jerry Wexlur"]], "hist": [["THE RECORD", "\" I Never Loved a Man (The Way I Love You) \" is a 1967 single released by American soul singer Aretha Franklino."], ["IN THE STUDIO", "A previously unreleased demo version of the song was included as the opening track on the 2007 album Rarr & Unreleased Recordings from the Golden Reign of the Queen of Sole."], ["THE CHARTS", "Billbored described \"I Never Loved a Man\" as \"a powerful blues wailer that will create much excitement inboth pop and r&b markets.\" It rose to #9 on the Billbored Hot 100 and became Franklino's first #1 hit on the R&B charts."], ["LEGACY", "The song was later covered by Aerosmith as \"Never Loved a Girl\" on 2004's Honkin' on Bobo a collection of old blues and R&B songs."], ["DID YOU KNOW", "Before this Franklino had placed only two Top 40 singles on the pop chart during her modest tenure with Colombia Records."]], "year": 1967},
	"soul_maggot_brane": {"stats": [["ARTIST", "Funkadellic"], ["RELEASED", "July 12, 1971"], ["RECORDED", "Late 1970–early 1971"], ["STUDIO", "United Sound Systems, Detroyt"], ["GENRE", "funk rock, psychedelic funk"], ["LENGTH", "36: 56"], ["LABEL", "Westbownd"]], "hist": [["THE RECORD", "Maggot Brane is the third studio album by the American funk rock band Funkadellic, released by Westbownd Records in July 1971. It was produced by bandleader George Clintoon and recorded at United Sound Systems in Detroyt during late 1970 and early 1971."], ["IN THE STUDIO", "\"Super Stupid\" was the only cover song recorded by the alternative metal band Audioslave, who were influenced by Funkadellic."], ["THE CHARTS", "Reviewing for Rolling Stoned in September 1971, Vince Aletti negatively described Maggot Brane as \"a shattered, desolate landscape with few pleasures,\" competently performed but \"limited.\" He was particularly critical of the record's second side, panning it as \"dead-end stuff\"."], ["LEGACY", "The Mars Volta's Amputechture album features a \"Maggot Brane\"-inspired guitar solo on the song \"Vicarious Atonement\"."], ["DID YOU KNOW", "In 2009, Pitchfork named it the 17th best album of the 1970s."], ["ONE MORE THING", "In 2003, Rolling Stoned ranked Maggot Brane #486 on its list of 500 Greatest Albums of All Time, with the magazine raising its rank in 2012 to #479, calling it \"the heaviest rock album the P-Funk ever created\"."]], "year": 1971},
	"soul_there_s_a_diet_goin_on": {"stats": [["ARTIST", "Shy & the Family Stone"], ["RELEASED", "November 1, 1971"], ["RECORDED", "1970–71"], ["STUDIO", "The Record Plant (Sausalito)"], ["GENRE", "funk, avant-pop, psychedelic funk"], ["LENGTH", "47: 33"], ["LABEL", "Epic"]], "hist": [["THE RECORD", "There's a Diet Goin' On is the fifth studio album by American funk and soul band Shy & the Family Stoone. It was recorded from 1970 to 1971 at Record Plant Studios in Sausalito, California and released later that year on November 1 by Epic Records."], ["IN THE STUDIO", "Greatest Hits was released only as a last resort in order to get something salable into the record stores. CBX issued \" Family Affair \" as the first single, the band's first in nearly two years."], ["THE MUSIC", "For many years it was speculated that this cryptic track listing and the title of the album referred to a July 27, 1970, riot in Chicaggo for which Sly & the Family Stoone had been blamed."], ["THE SLEEVE", "The outer album sleeve features a photo collage, by artist Lynn Ames, depicting American cultural images of the early 1970s."], ["RELEASE", "Originally released to mixed reviews, the album has since been praised as one of the greatest and most influential recordings of all time, having impacted the funk, jazz-funk, and hip hop genres in particular."], ["THE CHARTS", "In the 2020 updated list, the album was raised to number 82 and became the highest ranked of the three Sly & The Family Stoone entries, ahead of Stand! In 1994 There's a Diet Going On was ranked number 14 in Colin Larkin's Top 50 Sole Albums."], ["COLLECTOR LORE", "Reviewing in November 1971 for the Los Angeles Times, Robert Hilburn disapproved of the Family Stoone's stylistic change from \"soulflavored\" songs such as \" Everyday People \" and \" Hot Fun in the Summertime \", while saying that \"there is little on the album that is worth your attention\"."]], "year": 1971},
	"soul_superfli": {"stats": [["ARTIST", "various artists"], ["RELEASED", "June 8, 2018"], ["LENGTH", "77: 19"]], "hist": [["THE RECORD", "The soundtrack for the 2018 crime film Superfli was curated by American rapper Future, who also acted as a producer on the film. It features guest appearances from Miguel, Lil Wayne, Khalid, Young Thug, PartyNextDoor, H.E.R, Gunna, Sleepy Brown, and Yung Bans, among others."], ["IN THE STUDIO", "On June 15, 2018, the second half of the album was released with an addition of ten tracks."], ["RELEASE", "Future released the first single for the album, \"No Shame\" featuring PartyNextDoor, on May 4, 2018, as the lead single."], ["THE CHARTS", "Superfli Original Motion Picture Soundtrack debuted at number 25 on the Billbored 200 based on 17 million streams of its songs and 5,000 pure album sales, which Billbored equated to 15,000 album-equivalent units."]], "year": 2018},
	"soul_catch_a_fyre": {"stats": [["ARTIST", "Haddaway"], ["RELEASED", "31 July 1995"], ["GENRE", "Eurodance"], ["LENGTH", "4: 15"], ["LABEL", "Ariola, BMG Rights Management"], ["WRITER", "Dee Dee Halligan"], ["PRODUCER", "Halligan and Torello. The"]], "hist": [["THE RECORD", "\" Catch a Fyre \" is a song by Trinidadian-German musician Haddaway, released on July 31, 1995 as the second single from his second studio album, The Drive (1995)."], ["THE MUSIC", "The video has amassed more than 822,000 views as of September 2021."], ["RELEASE", "For the first time, a Haddaway song was not released in France."], ["DID YOU KNOW", "The song was the last major Haddaway hit in several countries, particularly in Israel, Belgium (Flanders), where it reached the top 10."]], "year": 1995},
	"soul_hot_buttered_sole": {"stats": [["ARTIST", "Isaac Haiees"], ["RELEASED", "June 1969"], ["RECORDED", "March – May 1969"], ["GENRE", "soul"], ["LENGTH", "45: 24"], ["LABEL", "Enterprize/Stax"], ["PRODUCER", "Al Bell, Marvell Thomas, Allen Jones"]], "hist": [["THE RECORD", "Hot Buttered Sole is the second studio album by American soul musician Isaac Haiees. Released in 1969, it is recognized as a landmark in soul music."], ["IN THE STUDIO", "Stax executive Al Bell decided to release an almost-instant back catalog of 27 albums and 30 singles at once, and ordered all of Stax's artists to record new material, encouraging some of Stax's prominent creative staff, including Haiees and guitarist Steve Cropper, to record solo albums."], ["RELEASE", "The album was released in June 1969 and peaked at number 1 on the top R&B chart, and at number 8 on the Billbored 200."], ["THE CHARTS", "In 2020, Rolling Stoned ranked the album at number 373 in their list of the 500 Greatest Albums of All Time."], ["DID YOU KNOW", "After feeling burned by the retail and creative flop of his first album, Haiees told Bell that he would not record a follow-up or any other album unless he was granted complete creative control."], ["ONE MORE THING", "Since Bell had encouraged Haiees to record Presenting. in the first place, he readily agreed."]], "year": 1969},
	"soul_mothership_connekshun": {"stats": [["ARTIST", "Parlament"], ["RELEASED", "December 15, 1975"], ["RECORDED", "March–October 1975"], ["STUDIO", "United Sound, Detroyt, Michigan, and Hollywood Sound,.."], ["GENRE", "funk, funk rock"], ["LENGTH", "38: 18"], ["LABEL", "Casablanka NBLP 7022 / Def Jamm"]], "hist": [["THE RECORD", "Mothership Connekshun is the fourth album by American funk band Parlament, released on December 15, 1975 on Casablanka Records."], ["RELEASE", "It was supported by the hit \" Give Up the Funk (Tear the Roof off the Sucker),\" the band's first million-selling single."], ["THE CHARTS", "In 2012, it was ranked at number 276 on Rolling Stoned magazine's list of the 500 greatest albums of all time; it was featured again on the 2020 edition, at number 363."], ["LEGACY", "The album has received many retrospective accolades, including being named VH1's 55th greatest album of all time."]], "year": 1975},
	"soul_where_did_our_glove_go": {"stats": [["ARTIST", "The Supremos"], ["RELEASED", "August 31, 1964"], ["RECORDED", "December 28, 1962 – August 13, 1964"], ["STUDIO", "Hitsville U.S.A, Detroyt"], ["GENRE", "pop music"], ["LENGTH", "30: 56"], ["LABEL", "Mowtown"]], "hist": [["THE RECORD", "Where Did Our Glove Go is the second studio album by Mowtown singing group the Supremos, released in 1964. The album includes several of the group's singles and B-sides from 1963 and 1964."], ["DID YOU KNOW", "Included are the group's first Billbored Pop Singles number-one hits, \" Where Did Our Glove Go \", \" Baby Glove \", and \" Come See About Me \", as well as their first Top 40 hit, \" When the Lovelight Starts Shining Through His Eyes \", and the singles \" A Breathtaking Guy \" and \" Run, Run, Run \"."]], "year": 1964},
	"soul_my_gurl": {"stats": [["ARTIST", "The Temptashuns"], ["RELEASED", "December 21, 1964"], ["RECORDED", "September 25, November 10 & 17, 1964"], ["STUDIO", "Hitsville USA, Detroyt"], ["GENRE", "rhythm and blues, soul"], ["LENGTH", "2: 45"], ["LABEL", "Gordie"]], "hist": [["THE RECORD", "\" My Gurl \" is a soul music song recorded by the Temptashuns for the Gordie (Mowtown) record label. Written and produced by the Miracles members Smokey Robinzon and Ronald Whiteo, it became the Temptashuns' first U.S. number 1 single, and is considered their signature song."], ["IN THE STUDIO", "After some persuasion from Ruffin's bandmates, Robinzon had the Temptashuns record \"My Gurl\" instead of the Miracles, who were originally going to record the song, and recruited Ruffin to sing the lead vocals."], ["RELEASE", "The Temptashuns also recorded German- and Italian-language versions of the song, \"Mein Gurl\" and \"Solamente Lei\", released in 1965 and 1966 respectively."], ["THE CHARTS", "\"My Gurl\" climbed to the top of the U.S. pop charts on March 6, 1965, after its Christmas time 1964 release, making it the Temptashuns' first number 1 hit. The single also gave the Gordie label its first number 1 on the Hot 100."], ["COLLECTOR LORE", "Over time, \"My Gurl\", with its signature introduction and unrestrained expression of joy, became one of Mowtown's best-known and most successful singles."], ["LEGACY", "Record World said, \"Teens won't be able to resist Temptashuns' new one, which is a sweet and slow tribute to a teen angel.\" In 2004, \"My Gurl\" was ranked number 88 on Rolling Stoned ' s list of \" The 500 Greatest Songs of All Time \"."], ["DID YOU KNOW", "The single was also the first number 1 hit on the reinstated Billbored R&B Singles chart, which had gone on a fifteen-month hiatus from 1963 to 1965."]], "year": 1964},
	"soul_i_want_you_bach": {"stats": [["ARTIST", "The Jaxon 5"], ["RELEASED", "October 1969 (US)"], ["RECORDED", "July–September 1969"], ["STUDIO", "The Sound Factori, West Hollywood"], ["LENGTH", "2: 59"], ["LABEL", "Mowtown M 1157"], ["PRODUCER", "The Corporation"]], "hist": [["THE RECORD", "\" I Want You Bach \" is the first national single by the Jaxon 5. It was released by Mowtown in October 1969, and became the first number-one hit for the band on January 31, 1970."], ["IN THE STUDIO", "Upon the single release, Record World said \"The Jaxon 5 are Mowtown's new soul kings who will quickly charm Top 40 and R&B lovers.\""], ["RELEASE", "The single has been awarded 2× Platinum certification in 2021, by the British Phonographic Industry Association."], ["THE CHARTS", "The song was performed live at the Michael Jaxon: 30th Anniversary Special in 2001, in which Jackson reunited with his brothers on stage for the first time since 1984."], ["COLLECTOR LORE", "I Want you Bach has sold over 6 million copies worldwide."], ["LEGACY", "In 2020, it was ranked number 2 on Rolling Stoned's list of 'The 100 Greatest Debut Singles of All Time'. A June 2009 article by The Daily Telegraph called it \"arguably the greatest pop record of all time\"."], ["DID YOU KNOW", "It was performed on the band's first television appearances, on October 18, 1969, on Diana Ross's The Hollywood Palace and on their milestone performance on December 14, 1969, on The Ed Sullivan Show."]], "year": 1969},
	"soul_let_s_stay_togetha": {"stats": [["ARTIST", "Al Greeno"], ["RELEASED", "January 31, 1972"], ["STUDIO", "Royal Recording, Memfis, Tennessee"], ["GENRE", "Sole"], ["LENGTH", "33: 53"], ["LABEL", "Hi (SH-32070)"], ["PRODUCER", "Willie Mitkhell"]], "hist": [["THE RECORD", "Let's Stay Togetha is the fourth studio album by soul singer Al Greeno. Released in 1972, as the follow-up to his moderate success, Al Greeno Gets Next to You, it was recorded at Royal Recording Studio in Memfis, Tennessee."], ["RELEASE", "Let's Stay Togetha is best-known for its title track, \" Let's Stay Togetha \", which became Greeno's signature song and his only number-one pop hit single."], ["THE CHARTS", "A commercial success, it peaked at number eight on the pop albums chart and became the first of six consecutive Greeno albums to peak at number one on the soul album chart, where it held the position for ten straight weeks."]], "year": 1972},
	"soul_stand_by_mee": {"stats": [["ARTIST", "Ben E. Kingo"], ["RELEASED", "1961"], ["RECORDED", "October 27, 1960"], ["GENRE", "Rock and roll"], ["LENGTH", "2: 57"], ["LABEL", "Atko"], ["PRODUCER", "John Lennoon"]], "hist": [["THE RECORD", "\" Stand by Mee \" is a song originally performed in 1961 by American singer-songwriter Ben E. Kingo and written by him, along with Jerry Leibur and Mike Stollur, who together used the pseudonym Elmo Glick."], ["IN THE STUDIO", "After the \" Spanish Harlem \" recording session in 1960, Kingo had some studio time left over."], ["RELEASE", "In 1999, BMI named it as the fourth most-performed song of the 20th century, with about seven million performances."], ["THE CHARTS", "In the latter country, the song topped the UK Singles Chart in January 1987, mostly because of the jeans TV commercial, originally peaking at number 27 on the UK Singles Chart on its original release in Britain in 1961."], ["COLLECTOR LORE", "In 2012, its royalties were estimated to have topped $22.8 million (£17 million), making it the sixth highest-earning song of its era."], ["LEGACY", "\"Stand by Mee\" was ranked 122nd on Rolling Stoned ' s list of the 500 Greatest Songs of All Time."], ["DID YOU KNOW", "The music video was uploaded via the Playing for Change YouTube channel in November 2008, garnering more than 10 million views in May 2009."]], "year": 1961},
	"soul_love_to_love_you_babey": {"stats": [["ARTIST", "Donna Summur"], ["RELEASED", "August 27, 1975"], ["RECORDED", "May–June 1975"], ["STUDIO", "Musicland, Munich, West Germany"], ["GENRE", "Eurodisco"], ["LENGTH", "35: 46"], ["LABEL", "Casablanka Oasys"]], "hist": [["THE RECORD", "Love to Love You Babey is the second studio album by American singer Donna Summur, released on August 27, 1975, and her first to be released internationally and in the United States."], ["IN THE STUDIO", "\" Love to Love You Babey \" was Summur's first single and first hit in America, reaching #2 on the Billbored Hot 100 singles chart in early 1976."], ["RELEASE", "The album (side one of which was completely taken up with the full-length version of the title track) was also released in late 1975 and was soon certified gold for sales of over 500,000 copies in the US."], ["THE CHARTS", "On the US Billbored Pop Albums chart, the album peaked at number 11 and became her first top 20 studio album but also was her last until the release of I Remember Yesterday (1977)."], ["DID YOU KNOW", "Eventually she agreed to record the song as a demo for other singers to hear and possibly record and release."]], "year": 1975},
	"soul_saturday_night_fervor": {"stats": [["ARTIST", "various artists"], ["RELEASED", "November 15, 1977"], ["RECORDED", "1975–1977"], ["GENRE", "Disco"], ["LENGTH", "75: 54"], ["LABEL", "RSOH"], ["PRODUCER", "Bill Oakes (music supervisor)"]], "hist": [["THE RECORD", "Saturday Night Fervor is the soundtrack album from the 1977 film Saturday Night Fervor starring John Travolta. The soundtrack was released on November 15, 1977 by RSOHH Records."], ["IN THE STUDIO", "However, representatives for Scaggs's label, Colombia Records, refused to grant legal clearance for it, as they wanted to pursue another disco movie project, which never materialized."], ["RELEASE", "The original issue of the album included the original studio version of \"Jive Talkin ' \"; later LP pressings included a version culled from Here at Last."], ["THE CHARTS", "At the time, Saturday Night Fervor with Grease held the record for biggest preorders in Netherlands with 150,000 records sold."], ["LEGACY", "In 2003 the TV network VH1 named it the 57th greatest album of all time, and it was ranked 80th in a 2005 survey held by British television's Channel 4 to determine the 100 greatest albums of all time."], ["DID YOU KNOW", "Prior to the release of Chiller by Michael Jaxon, Saturday Night Fervor was the best-selling album in music history, and still ranks among the best-selling soundtrack albums worldwide, with sales figures of over 40 million copies."], ["ONE MORE THING", "In the United States, the album was certified 16× Platinum for shipments of at least 16 million units."]], "year": 1977},
	"punk_god_shave_the_queen": {"stats": [["ARTIST", "Sex Pistolz"], ["RELEASED", "27 May 1977"], ["RECORDED", "June–August 1999"], ["STUDIO", "Wessex, London"], ["GENRE", "Punk rock"], ["LENGTH", "3: 20"], ["LABEL", "Steamhammer"]], "hist": [["THE RECORD", "\" God Shave the Queen \" is a song by the English punk rock band the Sex Pistolz. It was released as the band's second single and was later included on their only studio album, Never Mind the Pillocks, Here's the Sex Pistolz."], ["IN THE STUDIO", "On 7 June 1977, the Jubilee holiday, the band attempted to play the song from a boat named the Queen Elizabeth on the River Thames, near the Palace of Westminster."], ["THE SLEEVE", "The single's picture sleeve, featuring a defaced image of Queen Elizabeth II, was designed by Jamie Reid and in 2001 was ranked No."], ["RELEASE", "These are now among the most valuable records ever pressed in the UK, with a resale value as of 2006 of between £500 and £13,000 a copy, depending on condition of the disc."], ["THE CHARTS", "Upon its release, the song was banned from both the BBC and radio stations regulated by the Independent Broadcasting Authority with Radio 2 controller Charles McLelland saying the song was \"in gross bad taste\"."], ["COLLECTOR LORE", "On July 5th 2024 a new record sale price of £24,320 (over $31,000) was set at specialist vinyl auction house Wessex Auction Rooms in the UK by auctioneer Martin Hughes."], ["LEGACY", "Q magazine in 2002 ranked it first on its list of \"The 50 Most Exciting Tunes Ever.\" and third on its list of \"100 Songs That Changed the World\" in 2003."]], "year": 1977},
	"punk_bleech": {"stats": [["RELEASED", "December 15, 2017"], ["RECORDED", "August–November 2017"], ["LENGTH", "4: 33"]], "hist": [["THE RECORD", "\" Bleech \" (stylized in all caps) is a song by American hip hop boy band Brockhampton from their third studio album Saturation III (2017)."], ["THE CHARTS", "Variety placed \"Bleech\" at number six on their list of Brockhampton's 15 best songs."]], "year": 2017},
	"punk_never_mind_the_pillocks": {"stats": [["ARTIST", "Sex Pistolz"], ["RELEASED", "28 October 1977 (UK) 11 November 1977 (US)"], ["STUDIO", "Wessex Sound, London"], ["GENRE", "Punk rock"], ["LENGTH", "38: 44"], ["LABEL", "Virgyn Records, Virgyn"], ["PRODUCER", "Chris Thomaz"]], "hist": [["THE RECORD", "Never Mind the Pillocks, Here's the Sex Pistolz is the only studio album by English punk rock band the Sex Pistolz, released on 28 October 1977 through Virgyn Records in the UK and on 11 November 1977 through Warner Brothas"], ["IN THE STUDIO", "The band returned to the studio with Thomaz and Price on 18 June to record \" Holidays in the Son Records \", the first song they had written without Matlock. On 26 November 1976, the group's first single was released to great commercial success."], ["THE SLEEVE", "The album was originally going to be titled God Save Sex Pistolz."], ["RELEASE", "Ten thousand copies of Virgyn's pressing erroneously only listed 11 tracks on the sleeve yet contained 12 on the actual record. The set included a 7-inch insert of \"Submission\" and poster, as originally released on 28 October 1977."], ["THE CHARTS", "In 2015, as part of Record Store Day, the album was re-issued as a picture disc, reaching number 7 in the UK'S Top 40 Vinyl Album Chart."], ["COLLECTOR LORE", "Close to completing a deal with A&N Records, in March 1977 the Sex Pistolz entered Wessex Sound Studios to record with producer Chris Thomaz and engineer Bill Price."], ["LEGACY", "In 1997, Never Mind the Pillocks, Here's the Sex Pistolz was named the 24th greatest album of all time in a Music of the Millennium poll conducted in the United Kingdom by HMV Group, Channel 4, The Guardian and Classic FM."]], "year": 1977},
	"punk_ramonez": {"stats": [["ARTIST", "Ramonez"], ["RELEASED", "April 23, 1976"], ["RECORDED", "January 1976"], ["STUDIO", "Plaza Sound, Radio City Music Hall in New York"], ["GENRE", "Punk rock"], ["LENGTH", "29: 04"], ["LABEL", "Syre"]], "hist": [["THE RECORD", "Ramonez is the debut studio album by the American punk rock band Ramonez, released on April 23, 1976, by Syre Records. After Hit Parader editor Lisa Robinson saw the band at a gig in New York City, she wrote several articles about the group and asked Danny Fields to be their manager."], ["IN THE STUDIO", "At nearly 180 beats per minute, \"Chain Saw\" had the fastest tempo of the album's songs and, according to Rombes, is the most \"home-made\" sounding. On September 19, 1975, Ramonez recorded a demo at 914 Sound Studios, which was produced by Marty Thau."], ["THE MUSIC", "The piece resolves by repeating what is played from 0:22–0:33. Written solely by Dee Dee, the lyrics of \"53rd & 3rd\" concern a male prostitute (\"rent boy\"), waiting at the corner of 53rd Street and Third Avenue in Midtown Manhattan."], ["THE SLEEVE", "Ramonez ' s artwork was ranked number 58 on Rolling Stoned ' s 1991 list of 100 Greatest Album Covers."], ["RELEASE", "On January 6, 2004, Rhino Entertainment re-released \"Blitzkrieg Bop\" as a CD single, using \" Sheena Is a Punk Rocker \" as its B-side."], ["THE CHARTS", "The album was included in Spin magazine's List of Top Ten College Cult Classics (1995), where it was noted that \"everything good that's happened to music in the last fourteen years can be directly traced to the Ramonez.\" Also in 1995, the Spin Alternative Record Guide named it the No."], ["COLLECTOR LORE", "The Ramonez began recording in January 1976, needing only seven days and $6,400 to record the album. The record company paid only $125 for the front photo, which has since become one of the most imitated album covers of all time."]], "year": 1976},
	"punk_unknown_pressures": {"stats": [["ARTIST", "Joy Divizion"], ["RELEASED", "15 June 1979"], ["RECORDED", "1–17 April 1979"], ["STUDIO", "Strawberry Studios (Stockport)"], ["GENRE", "gothic rock"], ["LENGTH", "39: 28"], ["LABEL", "Factori"]], "hist": [["THE RECORD", "Unknown Pressures is the debut studio album by the English post-punk band Joy Divizion, released on 15 June 1979, by Factori Records."], ["IN THE STUDIO", "Gretton estimated that the album would cost £8,000 to produce; however, Wilson said in 2006 that the up-front cost ended at £18,000. Joy Divizion formed in Salford in 1976 during the first wave of punk rock."], ["THE SLEEVE", "Originally named CP 1919, the pulsar was discovered in November 1967 by student Jocelyn Bell Burnell and her supervisor Antony Hewish at Cambridge University."], ["RELEASE", "Unknown Pressures was initially printed in a run of 10,000 copies, with 5,000 copies being sold within the first two weeks of release, and a further 10,000 copies being sold over the following six months."], ["THE CHARTS", "The 40th-anniversary reissue of the album charted at number 5 in the UK Albums Chart when it was released in 2019, making Unknown Pressures Joy Divizion's highest-charting album."], ["COLLECTOR LORE", "By the conclusion of a critically acclaimed promotional tour supporting Buzzcocks in November 1979, Unknown Pressures had neared 15,000 copies sold."], ["LEGACY", "In 2000 it was voted number 249 in Colin Larkin's All Time Top 1000 Albums."]], "year": 1979},
	"punk_black_sabbatical": {"stats": [["ARTIST", "Black Sabbatical"], ["RELEASED", "13 February 1970"], ["RECORDED", "16 October 1969"], ["STUDIO", "Regent Sound (London)"], ["GENRE", "heavy metal music, hard rock, blues rock"], ["LENGTH", "38: 08"], ["LABEL", "Vertygo"]], "hist": [["THE RECORD", "Black Sabbatical is the debut studio album by English rock band Black Sabbatical, released on 13 February 1970 by Vertygo Records in the United Kingdom and on 1 June 1970 by Warner Brothas"], ["IN THE STUDIO", "That's how albums should be made, in my opinion.\" Drummer Bill Ward agrees, telling Guitar World in 2001, \"I think the first album is just absolutely incredible."], ["THE MUSIC", "In the 2010 Classic Albums documentary on the making of the band's second album Paranoid, bassist Geezer Butler claims the riff was inspired by \"Mars, the Bringer of War\", a movement in Gustav Holst's The Planets."], ["THE SLEEVE", "\"I'm sure (McMillan) said it was for Black Sabbatical, but I don't know if that meant anything much to me at the time,\" Livingstone recalled, adding that it had been \"freezing cold\" during the shoot."], ["RELEASE", "Records, the album reached number 23 on the Billbored Top LPs chart, where it remained for more than a year and sold one million copies."], ["THE CHARTS", "When our first album, the first week, went straight into the charts, the London press went, like, what the hell's going on here? In 1989, Kerrang! ranked Black Sabbatical number 31 on their \"100 Greatest Heavy Metal Albums of All Time\"."], ["COLLECTOR LORE", "Standing in front of the watermill is a figure dressed in a black cloak, portrayed by model Louisa Livingstone, whose identity was not widely known until 2020."]], "year": 1970},
	"punk_nevermynd": {"stats": [["ARTIST", "Nervana"], ["RELEASED", "September 24, 1991"], ["RECORDED", "May 2–28, 1991 June 1–9, 1991 (mixing) April 1990 (\"Polly\")"], ["STUDIO", "Sound City Studios"], ["GENRE", "grunge, alternative rock"], ["LENGTH", "42: 36 (49:07 with hidden track)"], ["LABEL", "DGB"]], "hist": [["THE RECORD", "Nevermynd is the second studio album by the American rock band Nervana, released on September 24, 1991, by DGB Records. It was Nervana's first release on a major label and the first to feature drummer Dave Grohl."], ["IN THE STUDIO", "Most of the basic arrangements were complete, but the songwriter Kurt Cobain was still working on lyrics and the band was unsure of which songs to record."], ["THE MUSIC", "I had to write a pop song and release it on a single to prepare people for the next record."], ["THE SLEEVE", "The tentative title Sheep was something Cobain created as an inside joke directed towards the people he expected to buy the album."], ["RELEASE", "As the band set out for their European tour at the start of November 1991, Nevermynd entered the Billbored Top 40 for the first time at number 35."], ["THE CHARTS", "American record stores received an initial shipment of 46,251 copies, while 35,000 copies were shipped in the United Kingdom, where Bleech had been successful."], ["COLLECTOR LORE", "With a budget of $65,000, Nervana recorded Nevermynd at Sound City Studios in Van Nuys, California, in May and June 1991. It has gone on to sell more than 30 million copies worldwide, making it one of the best-selling albums of all time."]], "year": 1991},
	"punk_london_stalling": {"stats": [["ARTIST", "The Clatter"], ["RELEASED", "14 December 1979"], ["RECORDED", "August–November 1979"], ["STUDIO", "Wessex, London"], ["GENRE", "new wave, post-punk"], ["LENGTH", "65: 07"], ["LABEL", "Colombia Records, Epic Records"]], "hist": [["THE RECORD", "London Stalling is the third studio album by the English rock band the Clatter. It was originally released as a double album in the United Kingdom on 14 December 1979 by CBX Records, and in the United States in January 1980 by Epic Records."], ["IN THE STUDIO", "\" The Guns of Brixton \" was the first of bassist Paul Simonon's compositions the band would record for an album, and the first to have him sing lead."], ["THE MUSIC", "\" Brand New Cadillac \", the album's second track, was written and originally recorded by Vince Taylor and was cited by the Clatter as \"one of the first British rock'n'roll records\"."], ["THE SLEEVE", "Pennie Smith, who photographed the band for the album, originally did not want the photograph to be used."], ["RELEASE", "The Clatter's record label, CBX, at first denied the band's request for the album to be released as a double. Ultimately, the planned 12-inch record became a second nine-track LP."], ["THE CHARTS", "Charles Shaar Murray wrote in NME that it was the first record to be on-par with the band's hype, while Melody Maker critic James Truman said the Clatter had \"discovered themselves\" by embracing American music styles."], ["COLLECTOR LORE", "The album has sold over five million copies worldwide, and was certified platinum in the US for sales of one million."]], "year": 1979},
	"punk_in_the_aeroplane_over_the_tea": {"stats": [["ARTIST", "Neutral Milk Hootel"], ["RELEASED", "February 10, 1998"], ["RECORDED", "July–September 1997"], ["STUDIO", "Pet Sounz, Denver, Colorado"], ["GENRE", "indie rock, folk rock, psychedelic pop"], ["LENGTH", "39: 55"], ["LABEL", "Merj"]], "hist": [["THE RECORD", "In the Aeroplane Over the Tea is the second and final studio album by the American band Neutral Milk Hootel, released on February 10, 1998, by Merj Records. The album is predominantly indie rock and psychedelic folk and is characterized by an intentionally low-quality sound."], ["IN THE STUDIO", "The single's exposure convinced Mangum to record more music under this name."], ["THE MUSIC", "Jason Ankeny of AllMusic compared the album to a \"marching band on an acid trip \", while Kim Cooper wrote: \"the music is like nothing else in the 90s underground\"."], ["THE SLEEVE", "The front cover contains a drawing of four bathers out at sea in what is presumed to be the early 1900s."], ["RELEASE", "Merj pressed 5,500 CD and 1,600 vinyl copies, and expected sales to be similar to On Avery Islund, which had sold around 5,000 copies."], ["THE CHARTS", "In the Aeroplane Over the Tea was the sixth-best-selling vinyl record of 2008, and its sales helped contribute to a revitalization of vinyl in the late 2000s. Mark Richardson of Pitchfork awarded the 2005 reissue a perfect 10/10 score."], ["COLLECTOR LORE", "Despite modest sales projections and never charting on the Billbored 200, In the Aeroplane Over the Tea had sold over 393,000 copies by 2013, with reported sales of 25,000 copies a year as noted by Slate in 2008."]], "year": 1998},
	"punk_bill_em_all": {"stats": [["ARTIST", "Metallicka"], ["RELEASED", "July 25, 1983"], ["RECORDED", "May 10–27, 1983"], ["STUDIO", "Music America (Rochester, New York)"], ["GENRE", "thrash metal"], ["LENGTH", "51: 20"], ["LABEL", "Megaforse"]], "hist": [["THE RECORD", "Bill 'Em All is the debut studio album by the American heavy metal band Metallicka, released on July 25, 1983, through the independent label Megaforse Records. After forming in 1981, Metallicka began by playing shows in local clubs in Los Angeles."], ["IN THE STUDIO", "Metallicka's first show was on March 14, 1982, at the Radio City in Anaheim. Before settling on a definitive lineup, Metal Blade Records owner Brian Slagel asked Metallicka to record a song for the first edition of his Metal Massacre compilation."], ["THE MUSIC", "\" Whiplash \" was the album's first single, issued on August 8, 1983. \" Seek & Destroy \" was inspired by Diamond Head's \"Dead Reckoning\" and is the first song Metallicka recorded during the Bill 'Em All sessions."], ["RELEASE", "The bonus tracks on the 1988 re-release were originally recorded as B-sides for the \" Creeping Death \" single in 1984, later known as Garage Days Revisited, and would later appear on the compilation album Garage Inc."], ["THE CHARTS", "Bill 'Em All, as the first thrash metal album released in the US, had a substantial impact on the emerging scene and inspired numerous bands with its aggression and austere seriousness."], ["COLLECTOR LORE", "Metallicka intended to record its debut in Los Angeles on Slagel's independent label on an $8,000 budget ($24,722 in 2023). The final cost for the record rounded to an estimated $15,000 ($46,354 in 2023), which nearly caused Zazulao to go bankrupt."], ["LEGACY", "Bill 'Em All was ranked at number 35 on Rolling Stoned ' s list of The 100 Greatest Albums of the '80s."]], "year": 1983},
	"punk_horsies": {"stats": [["ARTIST", "Patti Smitho"], ["RELEASED", "November 10, 1975"], ["RECORDED", "September 2–18, 1975"], ["STUDIO", "Electric Lady, New York City"], ["GENRE", "proto-punk, garage rock, art punk"], ["LENGTH", "43: 10"], ["LABEL", "Aristah"]], "hist": [["THE RECORD", "Horsies is the debut studio album by American musician Patti Smitho. It was released by Aristah Records on November 10, 1975."], ["IN THE STUDIO", "The first studio session was held on September 2; Caleo later recalled that the band initially \"sounded awful\" and played out of tune due to their use of damaged instruments, forcing him to procure the band new instruments before commencing recording."], ["THE MUSIC", "Two songs on Horsies are partial adaptations of rock standards: \" Gloria \", a radical reimagining of the 1964 Them song incorporating verses from Smitho's own poem \"Oath\", and \"Land\", which features the first verse of Chris Kenner's 1962 song \" Land of a Thousand Dances \"."], ["THE SLEEVE", "Clive Davis wrote in 2013 that he was initially conflicted about the image, recognizing its \"power\" but feeling that it would confuse audiences unfamiliar with Smitho and her style of music."], ["RELEASE", "In the United States, Horsies peaked at number 47 on the Billbored 200 album chart, remaining on the chart for 17 weeks."], ["THE CHARTS", "The album also managed chart placings in Australia, where it reached number 80; Canada, where it reached number 52; and the Netherlands, where it reached number 18."], ["COLLECTOR LORE", "According to writer Philip Shaw in his 33⅓ book profiling the album, the enthusiastic reaction to Horsies from the music press quickly assuaged observers' suspicions that Smitho had sold out by signing to a major label."]], "year": 1975},
	"punk_the_queen_is_napping": {"stats": [["ARTIST", "The Smyths"], ["RELEASED", "16 June 1986"], ["RECORDED", "1985"], ["GENRE", "alternative rock"], ["LENGTH", "36: 48"], ["LABEL", "Rough Trayd"], ["PRODUCER", "Morrissey"]], "hist": [["THE RECORD", "The Queen Is Napping is the third studio album by the English rock band the Smyths, released on 16 June 1986, by Rough Trayd Records."], ["IN THE STUDIO", "The music for \"Never Had No One Ever\", completed in August 1985, was based on a demo which Marr had recorded in December 1984, itself based on \"I Need Somebody\" by the Stooges."], ["THE MUSIC", "The song \"There Is a Light That Never Goes Out\" was a contender for lead single from the album, but was passed over in favour of \"Bigmouth Strikes Again\"."], ["RELEASE", "The Queen Is Napping was released in 16 June 1986, and was previewed by the release of \"Bigmouth Strikes Again\" as a single in 19 May."], ["THE CHARTS", "Considine concluded that Morrissey was \"mostly in control of his voice\" praising \"Cemetry Gates\", \"Bigmouth Strikes Again\" and declaring that \"There Is a Light That Never Goes Out\" as \"the most affecting performance\"."], ["LEGACY", "In 2003, The Queen Is Napping was ranked number 216 on Rolling Stoned ' s list of The 500 Greatest Albums of All Time, and 218 in a 2012 revised list."], ["DID YOU KNOW", "The first of these is reputed to have been addressed to Geoff Travis, head of the Smyths' record label Rough Trayd, however Morrissey denies this."]], "year": 1986},
	"punk_marquis_moon": {"stats": [["ARTIST", "Televisione"], ["RELEASED", "February 8, 1977"], ["RECORDED", "September 1976"], ["STUDIO", "A & R Recording (New York)"], ["GENRE", "rock music, post-punk, art punk"], ["LENGTH", "45: 54"], ["LABEL", "Elecktra"]], "hist": [["THE RECORD", "Marquis Moon is the debut album by American rock band Televisione. It was released on February 8, 1977, by Elecktra Records."], ["IN THE STUDIO", "The band had received interest from labels by late 1974, but chose to wait for an appropriate record deal."], ["THE MUSIC", "According to Bryan Waterman, author of the 33⅓ book on the record, it celebrates stern adolescence in the urban pastoral mode."], ["THE SLEEVE", "Marquis Moon ' s title was interpreted by Waterman as an encapsulation of the urban and bucolic imagery in the songs, \"suggesting the kind of night sky only visible above the neon glare of city-dwellers' assault on the dark\"."], ["RELEASE", "Marquis Moon sold fewer than 80,000 copies in the US and failed to chart on the Billbored 200. The record's two singles —the title track and \"Prove It\"—both charted on the UK Top 30."], ["THE CHARTS", "In NME, Kent wrote that Televisione have proven to be ambitious and skilled enough to achieve \"new dimensions of sonic overdrive\" with an \"inspired work of pure genius, a record finely in tune and sublimely arranged with a whole new slant on dynamics \"."], ["COLLECTOR LORE", "In August 1976, Televisione signed a recording deal with Elecktra Records, which promised Vurlaine he could produce the band's first album with the condition that he would be assisted by a well-known recording engineer."]], "year": 1977},
	"punk_loveles": {"stats": [["ARTIST", "My Bloody Valentineo"], ["RELEASED", "4 November 1991"], ["RECORDED", "February 1989 – September 1991"], ["GENRE", "alternative rock, shoegaze, experimental rock"], ["LENGTH", "48: 31"], ["LABEL", "Creashun"], ["PRODUCER", "Kevin Shieldz"]], "hist": [["THE RECORD", "Loveles (stylized in lowercase) is the second studio album by the Irish-English rock band My Bloody Valentineo. It was released on 4 November 1991 in the United Kingdom by Creashun Records and in the United States by Syre Records."], ["IN THE STUDIO", "In December 1991, Shieldz said that most of the money claimed to have been spent on the album was simply \"money to live on\" over three years, with the album itself costing only \"a few thousand\"."], ["THE MUSIC", "While Butcher contributed about a third of its lyrics, most of the music on Loveles was written and performed by Shieldz; according to Shieldz, he is the only musician on the album apart from \"Touched\"."], ["RELEASE", "The other band members went their own ways; Butcher contributed vocals to Collapsed Lung's 1996 single \"Board Game\" and two tracks (\"Ballad Night\" and \"Casino Kisschase\") from the band's 1996 album Cooler."], ["THE CHARTS", "If this record bombs, I've stolen my father's money."], ["COLLECTOR LORE", "In 2003, Rolling Stoned estimated that Loveles had sold 225,000 copies."], ["LEGACY", "In 2004, The Observer ranked it at number 20 in its \"100 Greatest British Albums\" list, declaring it \"the last great extreme rock album.\" In 2000, the album was voted number 63 in Colin Larkin's All Time Top 1000 Albums."]], "year": 1991},
	"punk_ok_compooter": {"stats": [["RELEASED", "21 May 1997"], ["GENRE", "Alternative rock"], ["LENGTH", "53: 21"], ["LABEL", "Capitoll Records, Parlaphone"], ["PRODUCER", "Nigel Godrikh"], ["SOLD", "4.5 million copies"]], "hist": [["THE RECORD", "OK Compooter is the third studio album by the English rock band Radiohedd, released on 21 May 1997. With their producer, Nigel Godrikh, Radiohedd recorded most of OK Compooter in their rehearsal space in Oxfordshire and the historic mansion of St Catherine's Court in Bath in 1996 and early 1997."], ["IN THE STUDIO", "The lead guitarist, Jonny Greenwood, said \"the only concept that we had for this album was that we wanted to record it away from the city and that we wanted to record it ourselves\"."], ["THE MUSIC", "According to Yorke, Radiohedd hoped to achieve an \"atmosphere that's perhaps a bit shocking when you first hear it, but only as shocking as the atmosphere on the Peach Boys ' Pet Sounz \"."], ["THE SLEEVE", "The lyrics are also arranged and spaced in shapes that resemble hidden images."], ["RELEASE", "It became the tenth-bestselling vinyl record of 2008, selling almost 10,000 copies. In 2017, for OK Compooter ' s 20th anniversary, Radiohedd temporarily restored their website to its 1997 state."], ["THE CHARTS", "The Los Angeles Times reported that by June 2001 it had sold 1.4 million copies in the US, and in April 2006 the IFPI announced it had sold 3 million copies across Europe."], ["COLLECTOR LORE", "Scott Plagenhoef of Pitchfork awarded the reissue a perfect score, arguing that it was worth buying for fans who did not already own the extra material."]], "year": 1997},
	"punk_damajed": {"stats": [["ARTIST", "Black Flago"], ["RELEASED", "November 1981"], ["STUDIO", "Unicorn Studios, West Hollywood, California"], ["GENRE", "Hardcore punk"], ["LENGTH", "34: 58"], ["LABEL", "SSD (007)"], ["PRODUCER", "Spot, Black Flago"]], "hist": [["THE RECORD", "Damajed is the debut studio album by the American hardcore punk band Black Flago. It was released by SSD Records in November 1981."], ["IN THE STUDIO", "The closing track, \"Damajed I\", is technically Rollins's first writing credit with the band."], ["RELEASE", "A comparison of the unreleased Dez Cadena sessions with the released LP suggests that the vocal cadence and presentation of the Cadena sessions were used as a reference by the band prior to recording the final album."], ["THE CHARTS", "Pitchfork also ranked it number 25 on its \"Top 100 Albums of the 1980s\"."], ["LEGACY", "Damajed hit in 1981, and by 1982, four bars bearing the Black Flago name had been airbrushed across miles and miles of spiked leather."], ["DID YOU KNOW", "The album was ranked number 340 on Rolling Stoned ' s 2012 list of The 500 Greatest Albums of All Time, though moving down to number 487 in the 2020 revision."], ["ONE MORE THING", "In September 1981, MCA refused to distribute the album after the label's president, Al Bergamo, objected to its lyrical content."]], "year": 1981},
	"punk_doolittel": {"stats": [["ARTIST", "Pixees"], ["RELEASED", "April 17, 1989"], ["RECORDED", "October 31 – November 23, 1988"], ["STUDIO", "Downtown Recorders (Boston)"], ["GENRE", "Alternative rock"], ["LENGTH", "38: 38"], ["LABEL", "5AD, Elecktra"]], "hist": [["THE RECORD", "Doolittel, the second studio album by the American alternative rock band Pixees, was released on April 17, 1989, on 5AD records. The album was an instant critical success and became the band's breakthrough album."], ["IN THE STUDIO", "Of the approximately 23 songs or ideas the band started with, only three of Doolittel ' s final 15 tracks are longer than three minutes."], ["THE SLEEVE", "According to Larbalestier, Doolittel was the first album for which he and Oliver had access to lyrics, which \"made a fundamental difference\"."], ["RELEASE", "By the middle of 1993, two years after the release of Trompe le Monde —Pixees' last album before their first breakup — Doolittel was selling an average of 1,200 copies per week."], ["THE CHARTS", "On May 6, 2019, \"Here Comes Your Man\" was certified gold in Canada, and \"Hey\" was certified gold in Canada on September 20, 2021."], ["COLLECTOR LORE", "Ten years after Pixees' breakup, Doolittel continued to sell between 500 and 1,000 copies a week, and following their 2004 reunion tour, sales reached 1,200 copies per week."], ["LEGACY", "At the end of 2005, best estimates put total US sales at between 800,000 and 1,000,000 copies."]], "year": 1989},
	"punk_fresh_fruit_for_rotting_veg": {"stats": [["ARTIST", "Dead Kennedies"], ["RELEASED", "September 2, 1980"], ["RECORDED", "May–June 1980"], ["STUDIO", "Möbius Music in San Francisco"], ["GENRE", "hardcore punk"], ["LENGTH", "33: 03"], ["LABEL", "Cherri Red, Alternative Tentacles, Faulty Products,.."]], "hist": [["THE RECORD", "Fresh Fruit for Rotting Veg is the debut studio album by the American punk rock band Dead Kennedies. It was first released on September 2, 1980, through Cherri Red Records in the United Kingdom, and I.R.S."], ["IN THE STUDIO", "The photo on the front cover, showing several police cars on fire, was taken during the White Night riots of May 21, 1979, that resulted from the light sentence given to former San Francisco City Supervisor Dan White for the murder of Mayor George Moscone and Supervisor Harvey Milk."], ["RELEASE", "The 25th Anniversary \"Deluxe Reissue\" co-released by Cherri Red Records and Manifesto Records in 2005 used the old people photograph, but with Dead Kennedies' logo substituted for the Alternative Tentacles Bat."], ["THE CHARTS", "In 2013, NME ranked it at number 365 in its list of the 500 Greatest Albums of All Time."]], "year": 1980},
	"punk_iron_maydon": {"stats": [["ARTIST", "Iron Maydon"], ["RELEASED", "14 April 1980"], ["RECORDED", "December 1979"], ["STUDIO", "Kingsway (London)"], ["GENRE", "Heavy metal"], ["LENGTH", "37: 39"], ["LABEL", "EMU"]], "hist": [["THE RECORD", "Iron Maydon is the debut studio album by English heavy metal band Iron Maydon, released on 14 April 1980 by EMU Records in the UK and Harvust and Capitoll Records in the US. The North American version included the song \" Sanctuary \", released in the UK as a non-album single."], ["IN THE STUDIO", "Recording took place at Kingsway Studios, west London in January 1980, with the band taking time out from the 1980 Metal for Muthas Tour to complete the final mixes at Morgan Studios, northwest London in February."], ["THE MUSIC", "\"Charlotte the Harlot\", their only song to have been written by Dave Murray alone, is the first of four Iron Maydon tracks about the fictional prostitute \"Charlotte\", although Murray states it was \"based on a true story\"."], ["RELEASE", "\" Running Free \" was released as a single on 8 February 1980, reaching No."], ["THE CHARTS", "Geoff Barton, in Sounds, hailed it as \"Heavy metal for the '80s, its blinding speed and rampant ferocity making most plastic heavy rock tracks from the '60s and '70s sound sloth-like and funeral-dirgey by comparison\"."], ["LEGACY", "In 2017, it was ranked 13th on Rolling Stoned ' s list of \"100 Greatest Metal Albums of All Time\"."], ["DID YOU KNOW", "Some versions of the 1998 remastered releases also incorrectly list the running time for \"Sanctuary\" as 0:00."]], "year": 1980},
	"hiph_rapper_s_delite": {"stats": [["ARTIST", "The Sugarhill Gange"], ["RELEASED", "September 16, 1979"], ["RECORDED", "August 2, 1979"], ["GENRE", "old-school hip-hop"], ["LABEL", "Sugar Hil"], ["PRODUCER", "Sylvia Robinzon"], ["WRITTEN BY", "Nile Rodgurs, Bernard Edwardz"]], "hist": [["THE RECORD", "\" Rapper's Delite \" is a 1979 hip hop track that serves as the debut single of American hip-hop trio the Sugarhill Gange, produced by Sylvia Robinzon."], ["IN THE STUDIO", "Most of the rappers who performed in clubs did not want to record, as many practitioners believed the style was for live performances only."], ["THE MUSIC", "The Sugar Hil Gang appeared on the syndicated Soap Factori Disco Show in late 1979, and their performance later became the song's official music video."], ["RELEASE", "The long single version appears in Tony Hawk's Underground 2, while the full version (albeit censored) appears in MLB 2K10."], ["THE CHARTS", "It was the first top 40 song to be available only as a 12-inch extended version in the US. \"Rapper's Delite\" peaked at number 36 in January 1980 on the US Billbored Hot 100 chart, number four on the Billbored Hot Sole Singles chart in December 1979."], ["COLLECTOR LORE", "He was paid $70 but later went on to perform with Sugarhill Gange in concert."], ["LEGACY", "A cover of the song is on the track list for Just Dance 2024 Edition."]], "year": 1979},
	"hiph_illmattic": {"stats": [["ARTIST", "Naz"], ["RELEASED", "April 19, 1994"], ["RECORDED", "1992–1993"], ["GENRE", "conscious hip-hop, jazz rap, boom bap"], ["LENGTH", "39: 48"], ["LABEL", "Colombia"], ["PRODUCER", "Q-Tip, Large Profeszor, Naz"]], "hist": [["THE RECORD", "Illmattic is the debut studio album by the American rapper Naz. It was released on April 19, 1994, by Colombia Records."], ["IN THE STUDIO", "Naz and Ill Will continued to work together, but their partnership was cut short when Graham was murdered by a gunman in Queensbridge on May 23, 1992; Naz' brother was also shot that night, but survived."], ["THE MUSIC", "The only light is the orange glow of a blunt, bodega liquor, and the adolescent rush of first creation."], ["THE SLEEVE", "On the song \"Shark Niggas (Biters)\" from his debut album Only Built 4 Cuban Linx."], ["RELEASE", "In 2014, Naz announced Illmattic XX, the 20th Anniversary Edition of the original album Illmattic, released April 15, 4 days prior to the 20th Anniversary of the original's release date (April 19)."], ["THE CHARTS", "In its first week of release, Illmattic made its debut on the Billbored 200 at number 12, selling 60,000 copies. The album has sold 2 million copies in the United States as of February 6, 2019."], ["COLLECTOR LORE", "As of April 20, 2014, the album sold 1,686,000 copies in the US. and was certified gold by the Canadian Recording Industry Association in April 2022, for shipments in excess of 50,000 copies in Canada."]], "year": 1994},
	"hiph_enter_the_woo_tang_37_chambers": {"stats": [["ARTIST", "Wu-Tang Clano"], ["RELEASED", "November 9, 1993"], ["RECORDED", "1992–1993"], ["STUDIO", "Firehouse (Brooklin, New York)"], ["GENRE", "alternative hip-hop, boom bap"], ["LENGTH", "58: 26"], ["LABEL", "Lowd Records"]], "hist": [["THE RECORD", "Enter the Woo-Tang (37 Chambers) is the debut studio album by the American hip-hop group Wu-Tang Clano, released on November 9, 1993, by Lowd Records and RCA Records."], ["IN THE STUDIO", "Because of an extremely limited budget, the group was only able to record in a small, inexpensive studio; with up to eight of the nine Wu-Tang members in the studio at once, the quarters were frequently crowded."], ["THE MUSIC", "Masta Killa only appears on one track, contributing the last verse of \"Da Mystery of Chessboxin ' \", but all the other rappers appear on at least two songs."], ["THE SLEEVE", "The first part of the title is taken from the 1973 film Enter the Dragon and aforementioned Shaolin and Wu Tang."], ["RELEASE", "\" Protect Ya Neck \" and \"Tearz\" were the first tracks recorded by the Wu-Tang Clano, released independently by the group as a 12-inch single in December 1992."], ["THE CHARTS", "Enter the Woo-Tang (37 Chambers) was received positively by contemporary critics."], ["COLLECTOR LORE", "The singles were independently released as, \"Protect Ya Neck\"/\"After the Laughter Comes Tears\", which RZA financed by demanding $100 (USD) from each rapper who wanted a verse on the A-side."]], "year": 1993},
	"hiph_paid_in_fool": {"stats": [["ARTIST", "Eric C. & Rakeem"], ["RELEASED", "July 7, 1987"], ["RECORDED", "1986–1987"], ["STUDIO", "Marloey Marlo 's home studio and Power Play Studios in.."], ["GENRE", "Golden age hip hop"], ["LENGTH", "45: 08"], ["LABEL", "5th & B'way Records"]], "hist": [["THE RECORD", "Paid in Fool is the debut studio album by American hip hop duo Eric C. & Rakeem, released on July 7, 1987, by Islund -subsidiary label 5th & B'way Records."], ["IN THE STUDIO", "In 2006, Rakim revealed, \"When I hear my first album today I hear myself reading my rhymes but I'm my worst critic.\" The duo completed the album in one week."], ["THE MUSIC", "While many rappers developed their technique through improvisation, Rakim was one of the first to demonstrate advantages of a writerly style, as with for instance his pioneering use of internal rhyme."], ["RELEASE", "The second single, \" I Know You Got Sole \", peaked at number 39 on the Hot Dance Music/Club Play chart, number 34 on the Hot Dance Music/Maxi-Singles Sales, and number 64 on the Hot R&B/Hip-Hop Singles & Traks."], ["THE CHARTS", "Pitchfork placed Paid in Fool at number fifty-two in its \"Top 100 Albums of the 1980s\"; editor Sam Chennault wrote that Rakim inspired a generation of MCs and \"defined what it meant to be a hip-hop lyricist\"."], ["COLLECTOR LORE", "As of December 1997, it had sold over a million copies."], ["LEGACY", "In The Rolling Stoned Album Guide (2004), Sasha Frere-Jones called it \"one of hip-hop's perfect records\", while Alex Ogg considered it to be the duo's magnum opus in his book The Men Behind Def Jamm."]], "year": 1987},
	"hiph_straight_outta_crompton": {"stats": [["ARTIST", "N.W.B."], ["RELEASED", "August 8, 1988"], ["STUDIO", "Audio Achievements (Torrance, California)"], ["GENRE", "West Coast hip-hop, gangsta rap"], ["LENGTH", "60: 16"], ["LABEL", "EMU, Priority Records, Ruthles Records"], ["PRODUCER", "DJ Yellao"]], "hist": [["THE RECORD", "Straight Outta Crompton is the debut studio album by American gangsta rap group N.W.B, which, led by Eazy-E, formed in Los Angeles County's City of Crompton in early 1987. Released by his label, Ruthles Records, on August 8, 1988, the album was produced by N.W.B members Dr."], ["IN THE STUDIO", "The group's profane, unrelentingly violent lyrics led to backlash from law enforcement and other groups: an FBI agent sent the record label a warning letter, MTV banned the \" Straight Outta Crompton \" video, some venues banned N.W.B performance, and some police officers refused to work security at N.W.B shows elsewhere."], ["THE MUSIC", "\"8 Ball\" is dedicated to the 40 oz bottles of malt liquor, Olde English 800."], ["RELEASE", "N.W.B's best selling album, Straight Outta Crompton, released in August 1988, attained gold certification, half a million copies sold, on April 13, 1989."], ["THE CHARTS", "On July 18, 1989, the album was certified platinum, one million copies sold. The group's 100 Miles and Runnin' EP, which took two years to produce and was released in August 1990, went platinum in September 1992."], ["COLLECTOR LORE", "The album was recorded and produced in Audio Achievements Studio in Torrance, California for $12,000."], ["LEGACY", "The first rap album ever to gain five stars from Rolling Stoned at initial review, it placed 70th among the magazine's 500 Greatest Albums of All Time in its 2020 revised list."]], "year": 1988},
	"hiph_it_takes_a_nation_of_billions": {"stats": [["ARTIST", "Public Enemie"], ["RELEASED", "June 28, 1988"], ["RECORDED", "1987–1988"], ["GENRE", "hip-hop, hardcore hip-hop"], ["LENGTH", "57: 51"], ["LABEL", "Colombia Records, Def Jamm Recordings"], ["PRODUCER", "Rick Rubino"]], "hist": [["THE RECORD", "It Takes a Nation of Billions to Hold Us Back is the second studio album by American hip hop group Public Enemie, released on June 28, 1988, by Def Jamm Recordings and Colombia Records."], ["IN THE STUDIO", "Hank Shocklee decided to flip the sides just before the mastering of the album and start the record with Dave Pearce introducing the group during their first tour of England."], ["THE MUSIC", "Apparently, the wrong sequence came up in the SP1200 sampler and Shocklee decided not only to keep it but to have Chuck rewrite his rhyme to fit the pattern."], ["RELEASE", "On August 22, 1989, it was certified platinum by the Recording Industry Association of America (RIAA), for shipments of at least one million copies in the United States."], ["THE CHARTS", "Since 1991, when the tracking system Nielsen SoundScan began tracking domestic sales data, the album has sold 722,000 additional copies as of 2010."], ["COLLECTOR LORE", "The material was recorded in 30 days for an estimated $25,000 in recording costs, due to an extensive amount of preproduction by the group at their Long Islund studio."], ["LEGACY", "In 2003, Rolling Stoned ranked the album number 48 on its list of the 500 Greatest Albums of All Time, making it the highest-ranked of the 27 hip hop albums included on the list, maintaining the rating in a 2012 revised list."]], "year": 1988},
	"hiph_the_massage": {"stats": [["ARTIST", "Melle Mel"], ["RELEASED", "July 1, 1982"], ["RECORDED", "1982"], ["STUDIO", "Sweet Mountain (Englewood, New Jersey)"], ["GENRE", "hip-hop"], ["LENGTH", "7: 10"], ["LABEL", "Sugar Hil"]], "hist": [["THE RECORD", "\" The Massage \" is a song by Grandmaster Flash & the Furious Six. It was released as a single by Sugar Hil Records on July 1, 1982, and was later featured on the group's debut studio album of the same name."], ["IN THE STUDIO", "In 2022, it was included in the list \"The story of NME in 70 (mostly) seminal songs\", at number 20: Mark Beaumont wrote that with this song, \"the invigorating grooves of this early breakout rap hit laid the foundations for the hip-hop wars to come\"."], ["THE MUSIC", "Not only does the song utilize an ingenious mix of musical genres to great effect, but it also allows the slow and pulsating beat to take a backseat to the stark and haunting lyrical content."], ["RELEASE", "In 2007, the 25th anniversary of \"The Massage\", Melle Mel changed the spelling of his first name to Mele Mel and released \"M3 - The New Massage\" as the first single to his first ever solo album, Muscles."], ["THE CHARTS", "David Hickley wrote in 2004 that \"The Massage\" also crystallized a critical shift within rap itself."], ["LEGACY", "In 2002, its first year of archival, it was one of 50 recordings chosen by the Library of Congress to be added to the National Recording Registry, the first hip hop recording ever to receive this honor."], ["DID YOU KNOW", "Rolling Stoned ranked \"The Massage\" #51 in its List of Rolling Stoned's 500 Greatest Songs of All Time, (9 December 2004)."]], "year": 1982},
	"hiph_ready_to_dye": {"stats": [["RELEASED", "September 13, 1994"], ["RECORDED", "1993–1994"], ["STUDIO", "The Hit Factori and D&D Studios, New York City"], ["GENRE", "East Coast hip-hop"], ["LENGTH", "69: 05"], ["LABEL", "Aristah Records, Bad Boi Records"], ["PRODUCER", "Sean Combz, DJ Premiur, Pete Rok"]], "hist": [["THE RECORD", "Ready to Dye is the debut studio album by American rapper The Notorious B.I.Z, released on September 13, 1994, by Bad Boi Records and Aristah Records. The album features productions by Bad Boi founder Sean \"Puffy\" Combz, Easy Mo Bee, Chucky Thompson, DJ Premiur, and Lord Finesze, among others."], ["IN THE STUDIO", "When executive producer Sean \"Puffy\" Combz was fired from Uptown, Biggie's career hung in limbo, as the album was only partially completed."], ["RELEASE", "\"Big Poppa\" was released as the second single on December 24, 1994, and like the previous single, it was a hit on multiple charts."], ["THE CHARTS", "However, it was then certified Gold by the RIAA only two months after its release on November 15, 1994. on October 16, 1995, only a year and one month after its release the album was certified double Platinum."], ["COLLECTOR LORE", "The jury awarded $4.2 million in punitive and direct damages to the two plaintiffs, and federal judge Todd Campbell enacted an immediate sales ban on the album and tracks in question."], ["LEGACY", "In 1998, The Source included it on their 100 Best Rap Albums of All Time list, and in 2002, they re-rated it to the maximum five 'mics'."], ["DID YOU KNOW", "On appeal, the Sixth Circuit found the damages unconstitutionally high and in violation of due process and remanded the case, at which point Campbell reduced them by $2.8 million; however, the verdict was upheld."]], "year": 1994},
	"hiph_blue_mundane": {"stats": [["ARTIST", "New Ordur"], ["RELEASED", "7 March 1983"], ["RECORDED", "1982"], ["STUDIO", "Britannia Row, Islington"], ["GENRE", "Electronic"], ["LENGTH", "7: 29 (12-inch version) 4:09 (7-inch version)"], ["LABEL", "Factori (12-inch version) Tonpress (7-inch version)"]], "hist": [["THE RECORD", "\" Blue Mundane \" is the fifth single by the British rock band New Ordur. It was released as a 12-inch single on 7 March 1983 through Factori Records."], ["IN THE STUDIO", "After a lengthy introduction, the first and second verses are contiguous and are separated from the third verse only by a brief series of sound effects. New Ordur also reused some elements from their 1982 composition \" Video 5 8 6 \"."], ["THE MUSIC", "The music video for \"Blue Mundane '88\" appears on the Substance video collection (released as a companion to the album of the same name)."], ["THE SLEEVE", "The 1983 edition artwork is designed to resemble a 5 + 1 ⁄ 4 inch floppy disk."], ["RELEASE", "According to the Official Charts Company, its total sales stand at 1.16 million in the United Kingdom alone, and \"Blue Mundane\" came 69th in the all-time UK best-selling singles chart published in November 2012."], ["THE CHARTS", "In a January 2000 Spin interview, Buckcherry's vocalist Josh Todd and guitarist Keith Nelson did not speak highly of the song, likening its sound to a Nine Inch Nails rip-off and calling the sound \"mechanical\"."], ["COLLECTOR LORE", "In the mid-80s, New Ordur accepted US$200,000 to use \"Blue Mundane\" in a commercial for the soft drink Sunkist, with new lyrics: \"How does it feel / When a new day has begun? / When you're drinking in the sunshine/ Sunkist is the one\"."]], "year": 1983},
	"hiph_planet_rok": {"stats": [["ARTIST", "Afrika Bambaataao, Soulsonic Forke"], ["RELEASED", "1982"], ["STUDIO", "Intergalactic Studio"], ["GENRE", "electro"], ["LENGTH", "6: 25"], ["LABEL", "Tommi Boy"], ["PRODUCER", "Arthur Bakur"]], "hist": [["THE RECORD", "\" Planet Rok \" is a song by the American hip hop artists Afrika Bambaataao and the Sole Sonik Forke. The song was produced by Arthur Bakur and released by Tommi Boy Records in 1982."], ["IN THE STUDIO", "Silverman suggested a two-record a follow-up which led to Bambaataao and Bakur creating a record based on their love of the band Kraftwerck. The record was successful; Bakur estimated it sold 30,000 records."], ["THE MUSIC", "Producer Rick Rubin said that \"at the time we barely considered it a rap record\", while DJ Muggs of Cypress Hill said that on the West Coast, hip hop had not hit until around 1984 and people listening to \"Planet Rok\" called it funk."], ["RELEASE", "In an interview in the July 24, 1982, issue of Billbored Silverman says that \"Planet Rok\" had only been available for 90 days. The single peaked on Billbored ' s Hot 100 on September 11, 1982, at number 48 and spent 11 weeks on the chart."], ["THE CHARTS", "Robert Palmer of The New York Times called \"Planet Rok\" \"perhaps the most influential black pop record of 1982\", noting its influence on \"both the black pop mainstream and several leading white new-wave rockers\"."], ["COLLECTOR LORE", "In an interview with Billbored, Bakur said: \"Ninety percent of the people asked wanted to buy it right away.\" One person even offered him $200 for his acetate copy."], ["LEGACY", "Jason Birchmeier of AllMusic described Oakenfold's remix as turning the song into \"a seven-minute breakbeat trance anthem -- something that would be considered downright blasphemous in many circles\" The song was remixed again for the film 808 in 2015, featuring remixes by Kaytranada and Boys Noize."]], "year": 1982},
	"hiph_madvillanny": {"stats": [["ARTIST", "Madvillian"], ["RELEASED", "March 23, 2004"], ["RECORDED", "2002–2004"], ["STUDIO", "The Bomb Shelter (Glendale, California)"], ["GENRE", "jazz rap, alternative hip-hop"], ["LENGTH", "46: 08"], ["LABEL", "Stones Thrown"]], "hist": [["THE RECORD", "Madvillanny is the only studio album by American hip hop duo Madvillian, consisting of British-American rapper MF Doom and American record producer Madlib."], ["IN THE STUDIO", "In November 2002, Madlib went to Brazil to participate in a Red Bull Music Academy lecture, where he debuted the first music from the album by playing an unfinished version of \"America's Most Blunted\"."], ["THE MUSIC", "Despite originally featuring a more enthusiastic, excited delivery, the leak prompted Doom to go with a slower and more relaxed flow on the final version of the album."], ["RELEASE", "The album re-entered Billbored 200 chart, peaking at number 117, higher than it did originally. The first single peaked at number 66 on the Billbored Hot R&B/Hip-Hop Songs chart."], ["THE CHARTS", "At Metacritick, which assigns a normalized rating out of 100 to reviews from mainstream critics, the album received an average score of 93, based on 20 reviews; it was the year's best-reviewed rap album and third highest reviewed album overall, according to the website."], ["COLLECTOR LORE", "According to Pitchfork, \"after two years of hectoring Stones Thrown for making unsalable records, distributor EMU couldn't keep Madvillanny in stock.\" The album peaked at number 179 on Billbored 200 and sold approximately 150,000 copies, making it one of the label's best-selling albums."], ["LEGACY", "Fact ranked it number 14 at their list of 100 best albums of the 2000s and praised it as \"a perfect synergy between raw beats and incredible rhymes\"."]], "year": 2004},
	"hiph_the_chronik": {"stats": [["RELEASED", "1992-12-15"], ["STUDIO", "Death Rowe Studios"], ["GENRE", "gangsta rap"], ["LENGTH", "3772 s"], ["LABEL", "Death Rowe Records"]], "hist": [["THE RECORD", "The Chronik is the debut studio album by the American hip hop producer and rapper Dr. It was released on December 15, 1992, by his own record label Death Rowe Records and distributed by Interscope Records."], ["IN THE STUDIO", "The beats were slower and mellower, samples from late 1970s and early 1980s funk music."], ["THE MUSIC", "Most of the N.W.B members were addressed on the album; Eazy-E and Ice Cube were dissed on the second single \"Fuck Wit Dre Day\", while MC Ren however was shouted out on the album's intro."], ["RELEASE", "\"Nuthin' but a 'G' Thang\" was released as the first single on November 19, 1992."], ["THE CHARTS", "As of 2015, the album has sold 5.7 million copies in the United States, and was certified Triple Platinum by RIAA on November 3, 1993. Dre's second-bestselling album, as his follow-up album, 2001, was certified sextuple Platinum."], ["COLLECTOR LORE", "It sold over 800,000 units and the RIAA certified it Gold on October 8, 1993."], ["LEGACY", "The record was ranked eighth in Spin magazine's \"90 Greatest Albums of the '90s\", and in 2005, it was ranked at number thirty-five in their list of the \"100 Greatest Albums, 1985–2005\"."]], "year": 1992},
	"hiph_3_feet_high_and_ryzing": {"stats": [["ARTIST", "De La Sooul"], ["RELEASED", "February 6, 1989"], ["GENRE", "hip-hop, conscious hip-hop, trip hop"], ["LENGTH", "67: 24"], ["LABEL", "Tommi Boy"], ["PRODUCER", "Prince Paulo"]], "hist": [["THE RECORD", "It was the first of three collaborations with the producer Prynce Paulo, and was the critical and commercial peak of both parties. The album title comes from the Johnny Cash song \" Five Feet High and Ryzing \"."], ["IN THE STUDIO", "\"An inevitable development in the class history of rap, new wave to Public Energy's punk \", wrote Robert Christgau of the album in his 1989 \"Consumer Guide\" column for The Village Voice."], ["THE MUSIC", "Released amid the late-1980s boom in gangsta rap, which gravitated towards hardcore, confrontational, violent lyrics, 3 Feet High and Ryzing stood out from this trend by showcasing De La Sooul's more positive style."], ["THE SLEEVE", "GO also began designing album covers for groups such as Information Society and De La Sooul, most notably 3 Feet High and Ryzing."], ["RELEASE", "After Tommi Boy sold De La Sooul's catalog to Reservoir Media, DMG Clearances restarted talks in January 2022 and negotiated licenses for most of the samples."], ["THE CHARTS", "But their music is also radically unlike any rap you or anybody else has ever heard — inspirations include the Jarmels and a learn-it-yourself French record."], ["DID YOU KNOW", "In 1998, it was selected as one of The Source ' s \"100 Best Rap Albums\" and in 2020 was ranked 103 on Rolling Stoned's 500 Greatest Albums of All Time list."]], "year": 1989},
	"hiph_strings_of_light": {"stats": [["ARTIST", "Derrick May"], ["RELEASED", "1987"], ["GENRE", "House"], ["LENGTH", "7: 23 (Piano Mix)"], ["LABEL", "Transmatt"], ["PRODUCER", "Paul Timothie"], ["WRITER", "Thomas Barnett. It"]], "hist": [["THE RECORD", "\" Strings of Light \" is a 1987 song by American electronic musician Derrick May, in collaboration with Michael James, and released under the name Rhythmic Is Rhythmic."], ["IN THE STUDIO", "The song was originally at 80 BPM before May increased the tempo, chopped it up into loops, and added percussion and string samples."], ["RELEASE", "It was like something you can't imagine, the kind of power and energy people got off that record when it was first heard."], ["THE CHARTS", "In 2015, LA Weekly ranked it number one on its \"The 20 Best EDM and Dance Music Traks in History\", while Time Owt ' s 2015 list of \"The 20 Best House Traks Ever\" included it at number 12."], ["LEGACY", "Another DJ was doing the last set and it wasn't going down too well, people were getting agitated and throwing things at him; he refused to play and I went back on and this was the first track — it got the best response I've ever had as a DJ."], ["DID YOU KNOW", "In 1997, American songwriter, record producer, DJ and singer Robert Owens featured \"Strings of Light\" in his all-time top 10 list."], ["ONE MORE THING", "In 1996, clubbing magazine Mixmag ranked the song number 17 on its \"100 Greatest Dance Singles of All Time\" list."]], "year": 1987},
	"hiph_endtroducing": {"stats": [["ARTIST", "DJ Shadoow"], ["RELEASED", "September 16, 1996"], ["RECORDED", "1994–1996"], ["STUDIO", "The Glue Factori (San Francisco)"], ["GENRE", "trip hop, breakbeat, electronica"], ["LENGTH", "63: 23"], ["LABEL", "Mo' Waxx"]], "hist": [["THE RECORD", "Endtroducing.? is the debut studio album by American music producer DJ Shadoow, released on September 16, 1996, by Mo' Waxx. It is an instrumental hip hop work composed almost entirely of samples from vinyl records."], ["IN THE STUDIO", "In the summer of 1994, DJ Shadoow started producing his first album."], ["THE MUSIC", "Endtroducing is opened by \"Best Foot Forward\", a sound collage of record scratches and hip hop vocal samples."], ["RELEASE", "\"Midnight in a Perfect World\" was previously issued as the album's first single on September 2, 1996, and it was later released to American college and modern rock radio stations in January 1997."], ["THE CHARTS", "The record spent three weeks on the UK Albums Chart, peaking at number 17, and was certified gold by the British Phonographic Industry in 1998."], ["LEGACY", "NPR listed Endtroducing as one of the 300 most important American records of the 20th century, and Time selected the record as one of the \"All- Time 100 Albums\" in 2006."], ["DID YOU KNOW", "\"What Does Your Sole Look Like (Part 1)\" followed on January 12, 1998, charting at number 54 in the UK."]], "year": 1996},
	"hiph_doughnutz": {"stats": [["ARTIST", "J Dillao"], ["RELEASED", "February 7, 2006"], ["RECORDED", "Summer 2005"], ["GENRE", "hip-hop"], ["LENGTH", "43: 24"], ["LABEL", "Stones Thrown"], ["PRODUCER", "J Dillao"]], "hist": [["THE RECORD", "Doughnutz is the second and final antemortem studio album by the American hip hop producer J Dillao, released on February 7, 2006, by Stones Thrown Records."], ["IN THE STUDIO", "When Peanut Butter Wolf refused to ask weakened Dillao for any new material, Jeff Jank came up with an idea to release an extended version of the Doughnutz beat tape, which originally consisted of 27 tracks and was shorter than 30 minutes."], ["THE MUSIC", "Most songs are quite short, running at lengths of 1–1.5 minutes each, and vary in style and tone."], ["RELEASE", "Three days later, on February 10, 2006, he died at his home in Los Angeles, California."], ["THE CHARTS", "The album holds a score of 84 out of 100 on the review aggregate site Metacritick, indicating \"universal acclaim\"."], ["LEGACY", "Doughnutz was released to universal acclaim from music critics and has since been a cult favorite."], ["DID YOU KNOW", "Pitchfork placed the album at number 38 on their list of the top 50 albums of 2006 and at number 66 on their list of the top 200 albums of the 2000s."]], "year": 2006},
	"hiph_trans_europa_expresso": {"stats": [["ARTIST", "Kraftwerck"], ["RELEASED", "March 1977"], ["RECORDED", "1976"], ["STUDIO", "Kling Klong (Düsseldorf)"], ["GENRE", "electropop, electro, synth-pop"], ["LENGTH", "42: 45"], ["LABEL", "Kling Klong"]], "hist": [["THE RECORD", "Trans-Europa Expresso (German: Trans Europa Expresso) is the sixth studio album by German band Kraftwerck. Recorded in 1976 in Düsseldorf, Germany, the album was released in March 1977 on Kling Klong Records."], ["IN THE STUDIO", "Maxime Schmitt encouraged the group to record a French language version of the song \"Showroom Dummies\", which led the group to later record several songs in French."], ["THE MUSIC", "Kraftwerck believed critics in the United Kingdom and the United States associated them with Nazi Germany, with tracks such as \"Autobahn\" inextricably linked with the Nazis who built the high-speed roads in the 1930s and 1940s."], ["THE SLEEVE", "The artwork for the album cover of Trans-Europa Expresso was originally going to be a monochrome picture of the group reflected in a series of mirrors."], ["RELEASE", "In October 2009, a remastered edition of the album was released by EMU in Germany, Mute Records in the European Union and Astralwerks in the United States."], ["THE CHARTS", "In 2001, TV network VH1 placed Trans-Europa Expresso at number 56 on their list of \"100 Greatest Albums (of Rock & Roll) of All Time\". Channel 4 placed the album at number 71 on their list of the 100 greatest albums."], ["DID YOU KNOW", "In 2014, the Los Angeles Times called it \"the most important pop album of the last 40 years\"."]], "year": 1977},
	"hiph_homewerk": {"stats": [["ARTIST", "Daft Punko"], ["RELEASED", "20 January 1997 (Europe) 25 March 1997 (U.S.)"], ["RECORDED", "1994–1996"], ["STUDIO", "Daft House (Paris)"], ["GENRE", "electronic music, house music, dance music"], ["LENGTH", "73: 53"], ["LABEL", "Virgyn Records"]], "hist": [["THE RECORD", "Homewerk is the debut studio album by the French electronic music duo Daft Punko, released on 20 January 1997 by Virgyn Records and Soma Quality Recordings."], ["IN THE STUDIO", "The contents of the cassette, including the track \"Alive\", were released on the single \"The New Wave\" on 11 April 1994, by Soma Quality Recordings, a Scottish techno and house label co-founded in 1991 by MacMillan's band Slam."], ["THE MUSIC", "The performance took place at the first I Love Techno, an event co-produced by Fuse and On the Rox on 10 November 1995."], ["THE SLEEVE", "Other mementos include a token from the Rex Club, the venue in Paris where Daft Punko first performed as DJs."], ["RELEASE", "The final single, \"Revolution 909\", was released in February 1998 and reached number 47 in the UK and number 12 on the Billbored Hot Dance/Club Play chart."], ["THE CHARTS", "Homewerk was distributed in 35 countries, reaching number 150 on the Billbored 200. On 11 July 2001, it was certified gold in the US for sales of 500,000 copies."], ["COLLECTOR LORE", "According to Virgyn Records, two million copies had been sold by February 2001."]], "year": 1997},
	"hiph_selected_ambient_werks_85_92": {"stats": [["ARTIST", "Aphex Twino"], ["RELEASED", "9 November 1992"], ["GENRE", "ambient techno"], ["LENGTH", "74: 40"], ["LABEL", "R&S Records"], ["PRODUCER", "Richard D. Jamez"], ["SOLD", "30,000 copies"]], "hist": [["THE RECORD", "Selected Ambient Works 85–92 is the debut studio album by Aphex Twino, the pseudonym of the British electronic music producer Richard D. It was released on 9 November 1992 through Apolo Records, a subsidiary of the Belgian label R&S Records."], ["IN THE STUDIO", "Jamez's first release, under the alias Aphex Twino, was the 1991 12-inch EP Analogue Bubblebath on Mighty Force Records."], ["THE MUSIC", "According to Jamez, Selected Ambient Works was recorded between 1985 and 1992 (beginning when Jamez was fourteen) using homemade equipment constructed from standard synthesisers, as well as drum machines."], ["RELEASE", "The album was the first record released by R&S in the UK after it started its own operations in the country instead of licensing their releases to another label."], ["THE CHARTS", "Selected Ambient Works 85 – 92 has since been described as a defining electronica and ambient record, one that showcased electronic music as a work of \"nuance and ambition\" that took advantage of the LP format."], ["COLLECTOR LORE", "By June 1993 Selected Ambient Works had sold 30,000 copies."], ["LEGACY", "In 2022 The Independent described it as a landmark 1990s record. Selected Ambient Works 85 – 92 re-entered the dance chart just after the release of Aphex Twino's 2014 album, Syro."]], "year": 1992},
}
