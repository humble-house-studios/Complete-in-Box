	"dc_dreamcaster_light_gun": {"stats": [["PUBLISHER", "Mad Catz"]], "hist": [["THE LOWDOWN", "The Dreamcaster video game console had several light guns released as accessories during its lifespan."], ["LAUNCH", "The Dreamcaster Gun is a light gun that was released only in Europe and Asia, where it is the official light gun for use."], ["COLLECTOR LORE", "This officially licensed light gun was manufactured by Interact and retailed for $30."]], "year": 0},
