	"gen_console": {"stats": [["DEVELOPER", "Saga"], ["RELEASED", "1988-10-29, 1990-11-30, 1998-08-14"], ["MAKER", "Saga"], ["TYPE", "Home video game console"], ["GENERATION", "Fourth"], ["LAUNCH PRICE", "$189"], ["UNITS SOLD", "39,800,000"]], "hist": [["THE LOWDOWN", "The Sago Genesys, known as the Megga Driv outside North America, is a 16-bit fourth generation home video game console developed and sold by Sago."], ["BEHIND THE SCENES", "Nakayama received permission to proceed with this project, leading to the release of Sago's first home video game system, the SG-1000, in July 1983. Sago estimated that the Funicom outsold the SG-1000 by a 10-to-1 margin."], ["LAUNCH", "In December 2010, WaterMelon, an American company, released Pier Solar and the Great Architects, the first commercial role-playing video game specifically developed for the console since 1996, and was the biggest 16-bit game ever produced for the console at the time at 64 Mb (roughly 8 Megabytes)."], ["RECEPTION", "Sago controlled 65% of the 16-bit console market in January 1992, the first time Funtendo had not been the console leader since 1985."], ["HOW IT PLAYS", "Most revisions of the original Genesys contain a discrete YM2612 and a separate YM7101 VDP; in a later revision, the chips were integrated into a single custom ASIC (FC1004)."], ["COLLECTOR LORE", "The European version of the Megga Driv was released in September 1990, at a price of £ 189.99, i.e. $337. Prices for the 33X dropped to $99 and cleared out of stores at $19.95."], ["LEGACY", "There are select Genesys games available on the Xbux 361 through Xbux Live Arcade, such as Sonik the Hedgehog and Sonik 2, as well as games available via the PlayStatia Network and Steam."]], "year": 1988},
	"gen_saga_genesys_model_2": {"stats": [["DEVELOPER", "Saga"], ["RELEASED", "1988-10-29, 1990-11-30, 1998-08-14"], ["MAKER", "Saga"], ["TYPE", "Home video game console"], ["GENERATION", "Fourth"], ["LAUNCH PRICE", "$189"], ["UNITS SOLD", "39,800,000"]], "hist": [["THE LOWDOWN", "The Sago Genesys, known as the Megga Driv outside North America, is a 16-bit fourth generation home video game console developed and sold by Sago."], ["BEHIND THE SCENES", "Nakayama received permission to proceed with this project, leading to the release of Sago's first home video game system, the SG-1000, in July 1983. Sago estimated that the Funicom outsold the SG-1000 by a 10-to-1 margin."], ["LAUNCH", "In December 2010, WaterMelon, an American company, released Pier Solar and the Great Architects, the first commercial role-playing video game specifically developed for the console since 1996, and was the biggest 16-bit game ever produced for the console at the time at 64 Mb (roughly 8 Megabytes)."], ["RECEPTION", "Sago controlled 65% of the 16-bit console market in January 1992, the first time Funtendo had not been the console leader since 1985."], ["HOW IT PLAYS", "Most revisions of the original Genesys contain a discrete YM2612 and a separate YM7101 VDP; in a later revision, the chips were integrated into a single custom ASIC (FC1004)."], ["COLLECTOR LORE", "The European version of the Megga Driv was released in September 1990, at a price of £ 189.99, i.e. $337. Prices for the 33X dropped to $99 and cleared out of stores at $19.95."], ["LEGACY", "There are select Genesys games available on the Xbux 361 through Xbux Live Arcade, such as Sonik the Hedgehog and Sonik 2, as well as games available via the PlayStatia Network and Steam."]], "year": 1988},
