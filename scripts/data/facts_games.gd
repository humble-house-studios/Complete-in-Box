	"fcube_funcube_indigo": {"stats": [["DEVELOPER", "Funtendo"], ["RELEASED", "2001-09-14, 2001-11-18, 2002-05-03"], ["MAKER", "Funtendo"], ["TYPE", "Home video game console"], ["GENERATION", "Sixth"], ["DISCONTINUED", "2007"], ["UNITS SOLD", "6,680,000, 21,520,000, 510,000"]], "hist": [["THE LOWDOWN", "The FunCube is a home video game console developed and marketed by Funtendo. It was released in Japan on September 14, 2001, in North America on November 18, 2001, in Europe on May 3, 2002, and in Australia on May 17, 2002."], ["BEHIND THE SCENES", "In total, ArtX cofounder Greg Buchner recalled that their portion of the console's hardware design timeline had arced from inception in 1998 to completion in 2000."], ["LAUNCH", "The console eventually launched in North America on November 18, 2001, with over 700,000 units shipped to the region."], ["RECEPTION", "Funtendo predicted 50 million FunCube units by 2005, but only sold 22 million FunCube units worldwide during its lifespan, placing it slightly behind the Xbux's 24 million, though it did manage to outsell the Xbux in Japan, and well behind the PlayStatia 2's 155 million."], ["HOW IT PLAYS", "Funtendo had struggled with its family-friendly image during the late 1990s and most of the 2000s. A \"Spice\" orange-colored console was eventually released only in Japan, though that scheme is only on controllers released in other countries."], ["COLLECTOR LORE", "Iwata forecasted to investors that the company would sell 50 million FunCube units worldwide by March 2005, but by the end of 2006, it had only sold 21.74 million — fewer than half."], ["LEGACY", "PocketBoysRadar+ ranked it 11th on their list of The 20 best video game consoles and hardware of all time in 2021. Den of Geek placed it at number 12 on their list of The 25 Best Video PocketBoy Consoles Ever, Ranked, in 2023."]], "year": 2001},
	"fcube_funcube_platinum": {"stats": [["DEVELOPER", "Funtendo"], ["RELEASED", "2001-09-14, 2001-11-18, 2002-05-03"], ["MAKER", "Funtendo"], ["TYPE", "Home video game console"], ["GENERATION", "Sixth"], ["DISCONTINUED", "2007"], ["UNITS SOLD", "6,680,000, 21,520,000, 510,000"]], "hist": [["THE LOWDOWN", "The FunCube is a home video game console developed and marketed by Funtendo. It was released in Japan on September 14, 2001, in North America on November 18, 2001, in Europe on May 3, 2002, and in Australia on May 17, 2002."], ["BEHIND THE SCENES", "In total, ArtX cofounder Greg Buchner recalled that their portion of the console's hardware design timeline had arced from inception in 1998 to completion in 2000."], ["LAUNCH", "The console eventually launched in North America on November 18, 2001, with over 700,000 units shipped to the region."], ["RECEPTION", "Funtendo predicted 50 million FunCube units by 2005, but only sold 22 million FunCube units worldwide during its lifespan, placing it slightly behind the Xbux's 24 million, though it did manage to outsell the Xbux in Japan, and well behind the PlayStatia 2's 155 million."], ["HOW IT PLAYS", "Funtendo had struggled with its family-friendly image during the late 1990s and most of the 2000s. A \"Spice\" orange-colored console was eventually released only in Japan, though that scheme is only on controllers released in other countries."], ["COLLECTOR LORE", "Iwata forecasted to investors that the company would sell 50 million FunCube units worldwide by March 2005, but by the end of 2006, it had only sold 21.74 million — fewer than half."], ["LEGACY", "PocketBoysRadar+ ranked it 11th on their list of The 20 best video game consoles and hardware of all time in 2021. Den of Geek placed it at number 12 on their list of The 25 Best Video PocketBoy Consoles Ever, Ranked, in 2023."]], "year": 2001},
	"fcube_funcube_panasonik_q_japan": {"stats": [["DEVELOPER", "Funtendo"], ["RELEASED", "2001-09-14, 2001-11-18, 2002-05-03"], ["MAKER", "Funtendo"], ["TYPE", "Home video game console"], ["GENERATION", "Sixth"], ["DISCONTINUED", "2007"], ["UNITS SOLD", "6,680,000, 21,520,000, 510,000"]], "hist": [["THE LOWDOWN", "The FunCube is a home video game console developed and marketed by Funtendo. It was released in Japan on September 14, 2001, in North America on November 18, 2001, in Europe on May 3, 2002, and in Australia on May 17, 2002."], ["BEHIND THE SCENES", "In total, ArtX cofounder Greg Buchner recalled that their portion of the console's hardware design timeline had arced from inception in 1998 to completion in 2000."], ["LAUNCH", "The console eventually launched in North America on November 18, 2001, with over 700,000 units shipped to the region."], ["RECEPTION", "Funtendo predicted 50 million FunCube units by 2005, but only sold 22 million FunCube units worldwide during its lifespan, placing it slightly behind the Xbux's 24 million, though it did manage to outsell the Xbux in Japan, and well behind the PlayStatia 2's 155 million."], ["HOW IT PLAYS", "Funtendo had struggled with its family-friendly image during the late 1990s and most of the 2000s. A \"Spice\" orange-colored console was eventually released only in Japan, though that scheme is only on controllers released in other countries."], ["COLLECTOR LORE", "Iwata forecasted to investors that the company would sell 50 million FunCube units worldwide by March 2005, but by the end of 2006, it had only sold 21.74 million — fewer than half."], ["LEGACY", "PocketBoysRadar+ ranked it 11th on their list of The 20 best video game consoles and hardware of all time in 2021. Den of Geek placed it at number 12 on their list of The 25 Best Video PocketBoy Consoles Ever, Ranked, in 2023."]], "year": 2001},
	"fcube_funcube_pocketboy_player": {"stats": [["MAKER", "Funtendo"], ["TYPE", "Video game console add-on"], ["GENERATION", "Sixth"], ["DISCONTINUED", "2007"], ["BEFORE IT", "Super PocketBoy"], ["DEVELOPER", "Funtendo"]], "hist": [["THE LOWDOWN", "The PocketBoy Player is a FunCube peripheral developed by Funtendo which enables it to play PocketBoy, PocketBoy Pocket, and PocketBoy Advanced cartridges, allowing those games to be played on a television."], ["BEHIND THE SCENES", "Japanese hardware manufacturer Horo created for the Japanese market a special digital-only controller designed for use with the PocketBoy Player."], ["LAUNCH", "Up until Sistem Menu 3.0's release, and later the dawn of Wee homebrew, this was also the only way of running PocketBoy Advanced games on the Wee — because, as the Wee lacks the correct port, the PocketBoy Player cannot be used."], ["HOW IT PLAYS", "A special PocketBoy Player for the Panasonik Q (SH-GB10-H) was released because the Q's legs are oriented differently from the original FunCube's."]], "year": 0},
	"fcube_funcube_wavebyrd_controller": {"stats": [["MAKER", "Funtendo"], ["TYPE", "Gamepad"], ["GENERATION", "Sixth generation"], ["UNITS SOLD", "Unknown"], ["CONNECTS", "2.4 GHz wireless RF"], ["POWER", "2 × AA batteries"]], "hist": [["THE LOWDOWN", "The WaveByrd Wireless Controller (stylized as WAVEBIRD, commonly abbreviated as WaveByrd or WaveByrd controller) is a radio frequency -based wireless controller manufactured by Funtendo for use with the FunCube home video game console."], ["BEHIND THE SCENES", "Although Funtendo only certifies the WaveByrd to work within this 6 meters (20 feet) range, tests have proven that they may work as far as 27.5 meters (90 feet) on all 16 different channels."], ["LAUNCH", "In Japan, two limited edition WaveByrd models were released through Club Funtendo: 1,000 Special Edition Gundam \"Char's Customized Pocket\" WaveByrds (two-toned red with the Neo-Zeon logo) to coincide with the Japan-only FunCube release of Mobile Suit Gundam: Gundam vs."], ["HOW IT PLAYS", "Unlike most wireless controllers of its era, it relies on RF technology (first used in gaming with Ataro's CX-42 joysticks) instead of infrared line-of-sight signal transmission, and the controller's radio transceiver operates at 2.4 GHz."], ["DID YOU KNOW", "The WaveByrd Wireless Controller was available in most regions only in light gray and platinum colors."], ["ONE MORE THING", "The range of the WaveByrd controller is officially 6 meters (20 feet) but some users have reported ranges of 18–21 meters (59–69 ft)."]], "year": 0},
	"fcube_funcube_action_replai": {"stats": [["MAKER", "Datel"]], "hist": [["THE LOWDOWN", "Action Replai is the brand name of a cheating device (such as cheat cartridges) created by Datel. The Action Replai is available for many gaming systems including the Funtendo Duo, Funtendo DSi, Funtendo 3DS, PlayStatia Portable, PlayStatia 2, FunCube, PocketBoy Advanced, and the Xbux."], ["LAUNCH", "In December 1998, Datel released a version for Windows 95/98. The Action Replai Power Saves for 3DS can alter saves of 3DS games and has some codes for 3DS games."]], "year": 0},
	"fcube_funcube_freeloadr": {"stats": [], "hist": [["THE LOWDOWN", "FunCube accessories include first-party releases from Funtendo, and third-party devices, since the FunCube's launch in 2001."], ["BEHIND THE SCENES", "Several indie games were also designed around them, such as Beat Nebula (2016), Squatbot (2018), and Beat Bull (2022)."], ["LAUNCH", "In Japan two limited edition WaveByrd models were released through Club Funtendo: 1,000 Special Edition Gundam \"Char's Customized Pocket\" WaveByrds (two-toned red with the Neo-Zeon logo) to coincide with the Japan-only FunCube release of Mobile Suit Gundam: Gundam vs."], ["DID YOU KNOW", "Like the component cable, it may be used to output video in 576i/50 Hz, 480i/60 Hz or 480p/60 Hz, uses the Digital AV port, needs a separate analog cable for audio, and is only compatible with DOL-001 models of the FunCube."], ["ONE MORE THING", "Standard colors include Indigo, Black, Spice (orange), Emerald Blue (green, only available in Japan), Platinum, Indigo-clear, and Pearl White (only available in Europe)."]], "year": 0},
	"pboy_dmg": {"stats": [["DEVELOPER", "Funtendo R&D1"], ["SERIES", "PocketBoy Brick family"], ["RELEASED", "1989-04-21, 1989-07-31, 1990-09-28"], ["MAKER", "Funtendo"], ["TYPE", "Handheld game console"], ["GENERATION", "Fourth"], ["LAUNCH PRICE", "$89.95"]], "hist": [["THE LOWDOWN", "The PocketBoy Brick is a handheld game console developed by Funtendo, launched in the Japanese home market on April 21, 1989, followed by North America and Europe later that year."], ["BEHIND THE SCENES", "Sharpe originally proposed a twisted nematic (TN) display, but after seeing a prototype PocketBoy Brick, Yamauchi rejected the TN technology as too hard to see."], ["LAUNCH", "The PocketBoy Pocket was released in Japan on July 20, 1996, and in North America on September 2, 1996, for US$69.99. The PocketBoy Light was a Japan-only revision released on April 14, 1998."], ["RECEPTION", "More than 118.69 million units of the PocketBoy Brick and PocketBoy Pocket combined have been sold worldwide, with 32.47 million units in Japan, 44.06 million in the Americas, and 42.16 million in other regions."], ["HOW IT PLAYS", "The top-selling franchise for the PocketBoy Brick were Pocket Critters Red, Blue, and Yellow, the first installments of the Pocket Critters video game series, which sold more than 46 million copies."], ["COLLECTOR LORE", "A revision in early 1997 added a power LED, different case colors (red, green, yellow, black, gold metal, clear, and blue) and dropped the price to US$54.95."], ["LEGACY", "Yamauchi estimated that the console would achieve sales exceeding 25 million units in its initial three years, a claim that was regarded as bold at the time."]], "year": 1989},
	"pboy_pocketboy_pocket": {"stats": [["DEVELOPER", "Analogue Inc, Kevin Horton"], ["RELEASED", "2021-12-13"], ["MAKER", "Analogue"], ["TYPE", "Handheld game console"], ["LAUNCHED", "December 13, 2021"], ["LAUNCH PRICE", "$219.99, $199.99"], ["CPU", "Altera Cyclone V, Intel Cyclone 10"]], "hist": [["THE LOWDOWN", "The Analoogue Pocket is a handheld game console designed and manufactured by Analogue. Announced in October 2019 and released on December 13, 2021, it uses field-programmable gate array (FPGA) chips to play games from various handheld consoles up to the sixth generation."], ["BEHIND THE SCENES", "An additional Altera Cyclone 10 FPGA handles system management within the Analoogue Pocket."], ["LAUNCH", "The Analoogue Pocket was announced on October 16, 2019. but its release was delayed several times due to global chip shortages related to the COVID-19 pandemic. In December 2023, Analogue released firmware updates 1.2 and 2.0."], ["RECEPTION", "The Analoogue Pocket won a Red Dot Design Award in 2022 It was nominated for Wallpaper ' s 2019 Design Awards."], ["DID YOU KNOW", "Since then, Analogue has expanded the Pocket's lineup with a glow-in-the-dark version in September 2023, transparent colors in October 2023 and models in classic PocketBoy colors in November 2023."]], "year": 2021},
	"pboy_gold": {"stats": [["DEVELOPER", "Funtendo R&D1"], ["SERIES", "PocketBoy family"], ["RELEASED", "1989-04-21, 1989-07-31, 1990-09-28"], ["MAKER", "Funtendo"], ["TYPE", "Handheld game console"], ["GENERATION", "Fourth"], ["LAUNCH PRICE", "$89.95"]], "hist": [["THE LOWDOWN", "The PocketBoy is a handheld game console developed by Funtendo, launched in the Japanese home market on April 21, 1989, followed by North America and Europe later that year."], ["BEHIND THE SCENES", "Sharpe originally proposed a twisted nematic (TN) display, but after seeing a prototype PocketBoy, Yamauchi rejected the TN technology as too hard to see."], ["LAUNCH", "The PocketBoy Pocket was released in Japan on July 20, 1996, and in North America on September 2, 1996, for US$69.99. The PocketBoy Light Gold was a Japan-only revision released on April 14, 1998."], ["RECEPTION", "More than 118.69 million units of the PocketBoy and PocketBoy Pocket combined have been sold worldwide, with 32.47 million units in Japan, 44.06 million in the Americas, and 42.16 million in other regions."], ["HOW IT PLAYS", "The top-selling franchise for the PocketBoy were Pocket Critters Red, Blue, and Yellow, the first installments of the Pocket Critters video game series, which sold more than 46 million copies."], ["COLLECTOR LORE", "A revision in early 1997 added a power LED, different case colors (red, green, yellow, black, gold metal, clear, and blue) and dropped the price to US$54.95."], ["LEGACY", "Yamauchi estimated that the console would achieve sales exceeding 25 million units in its initial three years, a claim that was regarded as bold at the time."]], "year": 1989},
	"pboy_camera": {"stats": [["RELEASED", "1998-02-21, 1998-06-01"], ["MAKER", "Funtendo"], ["TYPE", "Video game accessory"], ["GENERATION", "Fourth generation"], ["LAUNCH PRICE", "$49.99, 5500"], ["UNITS SOLD", "500,000"]], "hist": [["THE LOWDOWN", "The PocketBoy Camera, released as Pocket Camera in Japan, is a Funtendo accessory for the handheld PocketBoy game console. It was released on February 21, 1998, in Japan, and manufacturing ceased in late 2002."], ["BEHIND THE SCENES", "The PocketBoy Camera was launched with an initial MSRP of US$ 49.95."], ["RECEPTION", "The Camera sold close to 500,000 units in its first three weeks of availability in Japan."], ["HOW IT PLAYS", "In this minigame, the player controls a spaceship which fires missiles at other ships throughout three unique levels, followed by a boss at the end of each level."], ["LEGACY", "In 2016, an Instagram artist included the vintage GBC hardware in his repertoire of high-technology stylized filters, creating a new gallery dedicated only to GBC photography, because its primitive camera \"forces you to find a way to take beautiful pictures\"."], ["DID YOU KNOW", "There is a limited edition gold themed for Legund of Zeldo: Ocarina of Thyme, which contains unique stamps, and was available only in the United States through a mail-order offer from Funtendo Power."], ["ONE MORE THING", "The camera has a 128×128 pixel CMOS sensor, and can store 128×112, grayscale digital images using the 4-color palette of the PocketBoy system."]], "year": 1998},
	"pboy_pocketboy_printer": {"stats": [["MAKER", "Funtendo"], ["PUBLISHER", "Funtendo"], ["RELEASED", "1998"]], "hist": [["THE LOWDOWN", "The PocketBoy Printer, known as the Pocket Printer in Japan, is a thermal printer accessory released by Funtendo in 1998 which ceased production in early 2003."], ["BEHIND THE SCENES", "Released alongside the PocketBoy Printer in 1998, Funtendo-manufactured thermal paper refill rolls were produced in white, cream, blue, yellow, and red variants, all of which had an integrated adhesive backing."], ["RECEPTION", "It runs on six AA batteries and uses a proprietary 38mm wide thermal paper with adhesive backing, originally sold in white, red, yellow and blue colors."], ["COLLECTOR LORE", "Sold on the official Funtendo e-Shop (as triple packs of blue, cream and white rolls) until 2007, PocketBoy branded official replacement thermal paper is now difficult to source."], ["DID YOU KNOW", "Although on-box advertisements boasted up to 180 pictures per roll, in actuality a typical roll could only print between 118 and 121 pictures."], ["ONE MORE THING", "When a picture was printed from the PocketBoy Camera, it would print with a 5 mm (0.20 in) margin above and below the picture and print the picture at a 23 mm (0.91 in) height."]], "year": 1998},
	"pboy_pocketboy_color_atomic_purpl": {"stats": [["DEVELOPER", "Funtendo Research & Engineering"], ["SERIES", "PocketBoy family"], ["RELEASED", "1998-10-21"], ["MAKER", "Funtendo"], ["TYPE", "Handheld game console"], ["GENERATION", "Fifth"], ["DISCONTINUED", "March 31, 2003"]], "hist": [["THE LOWDOWN", "The PocketBoy Pocket (GBC or CGB) is an 8-bit handheld game console, manufactured by Funtendo, which was released in Japan on October 21, 1998, and to international markets that November."], ["BEHIND THE SCENES", "Tragically, Yokoi would never see the WonderSwan's release, as he was killed in a roadside accident in 1997."], ["LAUNCH", "Funtendo of America reported a sale of one million units from launch to December 1998, and two million by July 1999. The last game released in North America is Harry Plotter and the Chamber of Secrets, released on November 15, 2002."], ["RECEPTION", "The PocketBoy and PocketBoy Pocket were both commercially successful, selling 118.69 million units worldwide: 32.47 million in Japan, 44.06 million in the Americas, and 42.16 million in all other regions."], ["HOW IT PLAYS", "The last PocketBoy Pocket game ever released is the Japanese exclusive Doraemon no Study Boy: Kanji Yomikaki Mustard, on July 18, 2003. In Europe, the last game released for the system is Hamtaro: Ham-Hams Unite!, on January 10, 2003."], ["COLLECTOR LORE", "Launching at a price of US$79.95, the PocketBoy Pocket ultimately outsold the WonderSwan, which went on sale in March 1999."], ["DID YOU KNOW", "In later years, its sales were surpassed by the Funtendo Duo, PlayStatia 2 and Funtendo Swatch, making it the fourth-best-selling console the second-best-selling handheld of all time, as of 2024."]], "year": 1998},
