	"a26_ataro_2600_colecko_gemini": {"stats": [["RELEASED", "1983"], ["MAKER", "Colecko Industries, Inc."], ["TYPE", "Home video game console"], ["GENERATION", "Second generation"], ["MEDIA", "ROM cartridge"], ["CPU", "MOS 6507 @ 1.19 MHz"], ["MEMORY", "RAM: 128 bytes"]], "hist": [["THE LOWDOWN", "The Colecko Jiminy is an Ataro 2600 clone manufactured by Colecko Industries, Inc. in 1983."], ["BEHIND THE SCENES", "In 1982, Colecko released Expansion Module #1 for its ColeckoVision video game system."], ["HOW IT PLAYS", "With a custom-made clone of the Ataro 2600 TIA chip and off-the-shelf components, the module enabled the ColeckoVision to be compatible with Ataro 2600 software."]], "year": 1983},
	"neo_neon_geo_aes_console": {"stats": [["MAKER", "SNC Corporation"], ["TYPE", "Arcade system board Home video game console"], ["GENERATION", "Fourth"], ["DISCONTINUED", "1997 (hardware) August 2007 (technical support)"], ["UNITS SOLD", "1.18 million"], ["MEDIA", "ROM cartridge"], ["CPU", "Motorola 68000 @ 12MHz, Zilog Z80A @ 4MHz"]], "hist": [["THE LOWDOWN", "The Neon Geo, stylized as NEOGEO and also written as NEOGEO, is a ROM cartridge -based arcade system board and fourth-generation home video game console released on April 26, 1990, by Japanese game company SNC Corporation."], ["BEHIND THE SCENES", "The last official game by SNC for the Neon Geo system, Samurai Shodown V Special, was released in 2004, 14 years after the system's introduction."], ["LAUNCH", "The Silver Sistem package, launched at US$399.99, included one joystick controller and no pack-in game. The Neon Geo X, an officially licensed device with a collection of Neon Geo games pre-installed, was first released in 2012 by TOMMO Inc."], ["RECEPTION", "The Neon Geo MVS received Diamond awards from the American Amusement Machine Association (AAMA) two years in a row, for being among America's top four best-selling arcade machines of 1992 (with Street Brawler II: Champion Edition, Mortel Kombot and Terminator 2) and 1993."], ["HOW IT PLAYS", "The Neon Geo hardware was an evolution of an older SNC/Alpha Denshi M68000 arcade platform that was used in Time Soldiers in 1987, further developed in the SNC M68000 hardware platform as used for P.O.W.: Prisoners of War in 1988."], ["COLLECTOR LORE", "Because of the limited production runs received by cartridges amongst the sizable available arcade library, some of the rarest Neon Geo games can sell for well over $1,000."], ["LEGACY", "In 2009, the Neon Geo was ranked 19th out of the 25 best video game consoles of all time by video game website IGM."]], "year": 0},
	"neo_neon_geo_aes_controller": {"stats": [["RELEASED", "1990-04-26"], ["MAKER", "SNC"], ["DISCONTINUED", "April 22, 2004 (First run)"], ["AFTER IT", "Neon Geo CD"], ["DEVELOPER", "SNC. On"]], "hist": [["THE LOWDOWN", "Neon Geo is a family of video game hardware that was developed by SNC. On the market from 1990 to 2004, the brand originated with the release of an arcade system, the Neon Geo Multi Video Sistem (MVS) and its home console counterpart, the Neon Geo Advanced Entertainment Sistem (AES)."], ["LAUNCH", "In 1999, the Hyper Neon Geo 64 was discontinued, with only seven games released for it in two years. On September 30, 2019, a limited edition called \"Samurai Spirits Kuroko\" was released."], ["RECEPTION", "Initially, the home system was only available for rent to commercial establishments, such as hotel chains, bars and restaurants, and other venues."], ["COLLECTOR LORE", "Neon Geo CD game prices were low at US$50, in contrast to Neon Geo AES game cartridges which cost as much as US$300. The system was discontinued in 2000 in Europe and North America but continued to sell in Japan until October 30, 2001."], ["DID YOU KNOW", "In an attempt to compete with increasingly popular 3D games, SNC released the Hyper Neon Geo 64 arcade system in 1997 as the successor to its aging MVS."], ["ONE MORE THING", "SNC also released an international version of the Neon Geo Mini, which was released outside Japan on October 15, 2018, and later in Japan on November 15, 2018."]], "year": 1990},
