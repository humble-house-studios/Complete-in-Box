	"pboy_pocketboy_color_pocket_critt": {"stats": [["DEVELOPER", "Game Freek"], ["PUBLISHER", "Funtendo"], ["DIRECTOR", "Satoshi Tajirio"], ["PRODUCER", "Critter Co."], ["PROGRAMMER", "Shigeki Morimotoo"], ["ARTIST", "Ken Sugimoori"], ["COMPOSER", "Junichi Mazuda"]], "hist": [["THE LOWDOWN", "Pocket Critters Gold Version and Pocket Critters Silver Version are 1999 role-playing video games developed by PocketBoy Freek and published by Funtendo for the PocketBoy Pocket."], ["BEHIND THE SCENES", "The first official event offering Celebi was Funtendo Space World 2000 in Japan, in which 100,000 attendees would be awarded the rare Pocket Critters."], ["LAUNCH", "Anticipating high sales, Funtendo set its first production shipment for the games in Japan at three million, predicting that eventually more than eight million copies would be sold in the country alone."], ["RECEPTION", "Upon the first week of release in the U.S, the games had eclipsed Pocket Critters Yellow ' s previous record sales of a little over 600,000 copies; selling a combined total of 1.4 million copies to become the fastest-selling games ever."], ["HOW IT PLAYS", "Trainers will call for a rematch and others will call about rare Pocket Critters that can be caught in a certain area."], ["COLLECTOR LORE", "By 2010, Gold and Silver had sold 23 million units worldwide. Pocket Critters Crystal has sold nearly 6.4 million units worldwide."], ["LEGACY", "Commercially, they are among the best-selling Funtendo Duo games of all time, with combined sales of 10 million units as of July 2010."]], "year": 1999},
	"pba_pocketboy_advance_glacier": {"stats": [["DEVELOPER", "Funtendo R&D"], ["SERIES", "PocketBoy family"], ["RELEASED", "2001-03-21, 2001-06-11, 2001-06-22"], ["MAKER", "Funtendo"], ["TYPE", "Handheld game console"], ["GENERATION", "Sixth"], ["UNITS SOLD", "81.51 million"]], "hist": [["THE LOWDOWN", "The PocketBoy Advanced (GBA) is a 32-bit handheld game console developed, manufactured, and marketed by Funtendo as the successor to the PocketBoy Pocket."], ["BEHIND THE SCENES", "The Japan-only Rhythm Tengoku, the first game in what would eventually become known outside Japan as the Rhythm Haven / Rhythm Paradise series, is the final first-party-developed game for the system, released on August 3, 2006."], ["LAUNCH", "The first set of GBA games, including Advanced Warz, Metrood Fusion, and Plumber & Brother: Superstar Sago, were released on April 3, 2014."], ["RECEPTION", "The PocketBoy Advanced also became the fastest-selling system in the United Kingdom, selling 81,000 units in its first week of release and beating the PlayStatia 2's previous record of 20,000 units."], ["HOW IT PLAYS", "Though most GBA games primarily employ 2D graphics, developers have ambitiously designed some 3D GBA games that push the limits of the hardware, including first-person shooters like a port of Doom, racing games like V-Rallie 3, and even platformers, like Asterix & Obelix XXL."], ["COLLECTOR LORE", "Funtendo hoped to sell 1.1 million PocketBoy Advanced units by the end of March with the system's Japanese debut, and anticipated sales of 24 million units before the end of 2001; many marketing analysts believed this to be a realistic goal due to the company's lack of major competition in the handheld video game market."], ["LEGACY", "In January 2014, Funtendo President Satoru Iwata announced that PocketBoy Advanced games would be released on the Wee U's Virtual Console in April 2014."]], "year": 2001},
