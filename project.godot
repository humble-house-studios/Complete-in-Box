; Complete In Box - retro game collecting & reselling roguelike.
; Scaling rule: 720x1280 base, canvas_items + expand. Phones lock to portrait,
; desktop (Steam) opens a 1280x720 window, and the UI switches layout by screen shape.

config_version=5

[application]

config/name="Complete In Box"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/quit_on_go_back=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override.pc=1280
window/size/window_height_override.pc=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/handheld/orientation.tv=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.11, 1)
